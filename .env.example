

# ── Container runtime (optional) ──────────────────────────────────────────────
# Which runtime realizes agent sessions. Defaults to `docker`; set to `apple`
# on macOS to use Apple Container (`brew install container`).
# NANOCLAW_RUNTIME_DRIVER=apple

# ── Credentials (optional) ────────────────────────────────────────────────────
# Where containers get their Anthropic credential. Defaults to `onecli` (the
# agent vault). Set to `native-proxy` to keep the credential in this file
# instead: the host runs a proxy, containers reach it via ANTHROPIC_BASE_URL,
# and never hold a credential themselves.
# NANOCLAW_GATEWAY_PROVIDER=native-proxy
#
# Used only in native-proxy mode. Supply ONE of these:
# CLAUDE_CODE_OAUTH_TOKEN=      # a Claude subscription token (setup/register-native-token.sh)
# ANTHROPIC_API_KEY=            # or a plain API key
#
# Where the proxy listens. Defaults are usually right; injection is gated on a
# per-install secret, so a broad bind is not a credential exposure.
# CREDENTIAL_PROXY_PORT=3002
# CREDENTIAL_PROXY_HOST=0.0.0.0
# CREDENTIAL_PROXY_GATEWAY=     # address containers use to reach the host

# ── Session concurrency (optional) ────────────────────────────────────────────
# How many non-main agent containers may run at once. Sessions beyond the cap
# queue in arrival order. The main group is exempt.
# MAX_CONCURRENT_CONTAINERS=5

# ── Web UI (optional) ─────────────────────────────────────────────────────────
# Read-only dashboard. Binds loopback; expose it through something that
# terminates TLS (e.g. Tailscale Serve) rather than binding it publicly.
# WEB_UI_PORT=3004
#
# Public-facing base URL. When set, agents can call get_file_url to generate
# shareable links to workspace files.
# WEB_UI_BASE_URL=https://your-host.ts.net

# ── Dashboard pusher (optional) ───────────────────────────────────────────────
# Ships periodic JSON snapshots to @nanoco/nanoclaw-dashboard. Off without a secret.
# DASHBOARD_SECRET=
# DASHBOARD_PORT=3100

# ── Zotero library sync (optional) ────────────────────────────────────────────
# Syncs your Zotero library into the named group's folder as markdown, where
# the memory indexer picks it up. Key: https://www.zotero.org/settings/keys
# ZOTERO_API_KEY=
# ZOTERO_USER_ID=
# ZOTERO_GROUP_FOLDER=
# ZOTERO_POLL_INTERVAL=3600000

# ── Memory search (optional) ──────────────────────────────────────────────────
# Semantic search over groups/<folder>/memory/. Off without a key.
# Get one at https://aistudio.google.com/apikey (free tier: 1,500 req/day).
# MEMORY_SEARCH_GEMINI_API_KEY=
#
# Which group folders to index. Embedding quota is finite and most groups'
# memory is never searched. Comma-separated; defaults to `main`.
# MEMORY_SEARCH_GROUPS=main
#
# MEMORY_SEARCH_MODEL=gemini-embedding-001
# Rate limits default to the Gemini free tier.
# MEMORY_SEARCH_RPM_LIMIT=50
# MEMORY_SEARCH_TPM_LIMIT=15000
# MEMORY_SEARCH_RPD_SESSION_BUDGET=900

# ── Web search (optional) ─────────────────────────────────────────────────────
# BRAVE_API_KEY=

# ── Backups (optional) ────────────────────────────────────────────────────────
# Passphrase for the borg repo used by scripts/backup.sh.
# BORG_PASSPHRASE=

# ── Container image build (optional) ──────────────────────────────────────────
# Memory for Apple Container's builder VM. The default allocation is too small
# for this image and dies with a bare "Killed" partway through.
# NANOCLAW_BUILDER_MEMORY=8g

