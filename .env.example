# ── Memory search (optional) ──────────────────────────────────────────────────
# Enable semantic search over files in groups/<folder>/memory/.
# Get a key at https://aistudio.google.com/apikey (free tier: 1,500 req/day).
MEMORY_SEARCH_GEMINI_API_KEY=

# Embedding model (default: gemini-embedding-001)
# MEMORY_SEARCH_MODEL=gemini-embedding-001

# Rate limits (defaults match Gemini free tier)
# MEMORY_SEARCH_RPM_LIMIT=50
# MEMORY_SEARCH_TPM_LIMIT=15000
# MEMORY_SEARCH_RPD_SESSION_BUDGET=900
