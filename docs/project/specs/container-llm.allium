-- allium: 3
-- container-llm.allium
--
-- How the agent runner container invokes the Claude LLM.
-- Models the input/output protocol, Claude SDK configuration, session resumption,
-- multi-turn IPC message injection, compaction lifecycle, slash command handling,
-- and script gating for scheduled tasks.
--
-- Scope: container-internal LLM invocation mechanics
-- Includes: ContainerInput/Output protocol, SDK query options, session continuity,
--           multi-turn IPC injection, compaction hooks, /compact slash command,
--           script gating for scheduled tasks
-- Excludes:
--   - Host-side session tracking (see nanoclaw.allium: ConversationSession, AgentSession)
--   - Specialist session continuity (see specialists.allium: SpecialistConversationSession)
--   - IPC task wire formats and MCP tool semantics (see ipc.allium)
--   - Container orchestration: how the host spawns containers (see nanoclaw.allium)
--   - Credential proxy: ANTHROPIC_BASE_URL injection is infrastructure
--   - Memory internals (see memory.allium)

use "./nanoclaw.allium" as nanoclaw
use "./ipc.allium" as ipc

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    model: String = "sonnet[1m]"           -- Claude Sonnet with 1M context window
    auto_compact_window: Integer = 200000  -- token threshold triggering automatic context compaction
    ipc_poll_interval: Duration = 500.ms   -- cadence for polling IPC input during and between queries
    script_timeout: Duration = 30.seconds  -- maximum runtime for a scheduled-task gate script
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The configuration delivered to the container at startup (via stdin as JSON).
-- allium-ignore allium.definition.unused
value ContainerInput {
    prompt: String                  -- initial user message or task instruction
    session_id: String?             -- Claude conversation ID to resume; null = new session
    group_folder: String            -- workspace subdirectory name for this group
    chat_jid: String                -- channel-qualified group identifier
    is_main: Boolean                -- whether this is the main group (elevated trust)
    is_scheduled_task: Boolean      -- whether this run was triggered by the scheduler
    assistant_name: String?         -- display name used in archived transcripts
    script: String?                 -- bash script to gate agent invocation (scheduled tasks only)
}

-- One result record emitted to the host during a container run.
-- Multiple outputs may be produced per run: one per SDK result event plus
-- session-update markers emitted between queries.
value ContainerOutput {
    status: success | error
    result: String?                 -- agent text response; null for session-update markers
    new_session_id: String?         -- Claude conversation ID as of this output
    total_tokens: Integer?          -- cumulative input+output tokens for the run so far
    error: String?                  -- present when status = error
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- One call to the Claude SDK query() within a container run.
-- The first QueryTurn in a run uses the initial prompt and may resume a prior session.
-- Subsequent QueryTurns are driven by IPC messages received while the container waits.
-- All QueryTurns in the same run share the same evolving session thread.
entity QueryTurn {
    chat_jid: String                -- from ContainerInput; used for reactions and follow-up queries
    prompt: String
    session_id_in: String?          -- conversation ID passed to this call; null = new session
    session_id_out: String?         -- conversation ID established or continued after init
    resume_at: String?              -- UUID of the last assistant message from the previous turn;
                                    -- passed as resumeSessionAt for precise transcript resumption
    last_assistant_uuid: String?    -- UUID of the last assistant message from this turn;
                                    -- becomes resume_at for the next QueryTurn in the run

    -- All triggering rules listen on SDK and IPC events that have no governing allium spec.
    -- The checker cascades unreachable-trigger → unreachable-rule → unobserved status transition.
    -- Suppress noExit for non-terminal statuses whose exit rules are all externally triggered.
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: pending | active | completed | interrupted | aborted

    transitions status {
        pending -> active           -- SDK query() call begins
        active -> completed         -- SDK async generator exhausted normally
        active -> interrupted       -- interrupt signal received; next turn uses interrupt text
        active -> aborted           -- close sentinel received during active query
        terminal: completed
        terminal: interrupted
        terminal: aborted
    }
}

-- The Claude conversation session established within a QueryTurn.
-- Created when the SDK emits a system/init event.
-- The session_id is also written to /workspace/ipc/current_session_id so MCP tools
-- can read it without holding a direct SDK reference.
entity QuerySession {
    turn: QueryTurn
    session_id: String
}

-- A reaction emoji written to the IPC task queue by the container runtime.
-- Processed by the host IPC watcher, which applies it to the last incoming message in the chat.
-- Used by compaction hooks to signal state to the user without going through the MCP tool surface.
entity ReactionTask {
    chat_jid: String
    emoji: String
    queued_at: Timestamp
}

-- An archived transcript produced by the PreCompact hook before context compaction.
-- Captures all user and assistant text turns up to the compaction point as Markdown.
-- The filename is derived from the session summary index when available;
-- a HHmm timestamp fallback is used otherwise.
entity ArchivedTranscript {
    session: QuerySession
    path: String                    -- /workspace/group/conversations/{date}-{title}.md
    title: String?                  -- from session summary index; null if unavailable
    archived_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Startup ----

-- Container receives its input and creates the first QueryTurn.
-- Scheduled tasks receive a preamble injected into the prompt so the agent knows
-- it was not triggered by a live user. Any IPC messages queued at startup are
-- appended to the initial prompt.
rule ContainerBootstrapped {
    when: ContainerInvoked(input)

    ensures: QueryTurn.created(
        chat_jid: input.chat_jid,
        prompt: input.prompt,
        session_id_in: input.session_id,
        resume_at: null,
        status: pending
    )

    @guidance
        -- Exclusions from this rule (handled by separate rules):
        --   /compact prompt: intercepted by SlashCompactHandled before ContainerBootstrapped fires.
        --   Scheduled task with script: intercepted by ScriptGatesScheduledTask.
        -- The scheduled-task preamble ("[SCHEDULED TASK - ...]") is prepended to input.prompt
        -- when input.is_scheduled_task is true.
        -- Pending IPC messages already in /workspace/ipc/input/ at startup are appended
        -- to the initial prompt before the first QueryTurn is created.
}

-- For scheduled tasks that include a gate script, the script runs first.
-- wakeAgent=true enriches the prompt with script data and invokes the agent.
-- wakeAgent=false or any script error suppresses agent invocation entirely.
rule ScriptGatesScheduledTask {
    when: ContainerInvoked(input)

    requires: input.is_scheduled_task
    requires: input.script != null

    -- Outcome A: script succeeds with wakeAgent=true
    --   ensures: QueryTurn.created(
    --       chat_jid: input.chat_jid,
    --       prompt: "[SCHEDULED TASK]\n\nScript output:\n{script_data}\n\nInstructions:\n{input.prompt}",
    --       session_id_in: input.session_id,
    --       resume_at: null,
    --       status: pending
    --   )
    -- Outcome B: script returns wakeAgent=false or errors
    --   ensures: ContainerOutput.emitted(status: success, result: null)
    --   (container exits without invoking the LLM)

    @guidance
        -- The script runs as a bash process subject to config.script_timeout.
        -- Its final stdout line must be valid JSON with a boolean wakeAgent field.
        -- Any exit error, timeout, or non-JSON output is treated as wakeAgent=false.
        -- When wakeAgent=true, additional JSON fields from the script output are
        -- serialised into the prompt so the agent receives them as context.
}

-- ---- Slash Command: /compact ----

-- /compact is the only recognised slash command.
-- It bypasses the normal query loop and issues a tool-less SDK call to compact the session.
-- Pre/PostCompact hooks fire normally. A compact_boundary event confirms completion.
rule SlashCompactHandled {
    when: ContainerInvoked(input)

    requires: input.prompt = "/compact"

    ensures: ContainerOutput.emitted(
        status: success,
        result: "Conversation compacted.",
        new_session_id: session_id_after_compact
    )
    ensures: ContainerOutput.emitted(
        status: success,
        result: null,
        new_session_id: session_id_after_compact
    )

    @guidance
        -- A single SDK query() is issued with no tools allowed and "/compact" as the prompt.
        -- The session is resumed from input.session_id.
        -- Pre/PostCompact hooks fire normally (transcript archived, reactions set).
        -- If compact_boundary is not observed, a warning is logged and success is still returned.
        -- No IPC polling occurs in the slash command path.
        -- Leading/trailing whitespace is trimmed before matching the "/compact" literal.
}

-- ---- Query Lifecycle ----

-- A pending QueryTurn is activated: the SDK query() call begins.
rule QueryTurnActivated {
    when: QueryTurnStarted(turn)

    requires: turn.status = pending

    ensures: turn.status = active

    @guidance
        -- SDK options applied to every QueryTurn:
        --   model:            config.model  ("sonnet[1m]")
        --   cwd:              /workspace/group
        --   permissionMode:   bypassPermissions
        --   settingSources:   [project, user]
        --   allowedTools:     Bash, Read, Write, Edit, Glob, Grep, WebSearch, WebFetch,
        --                     Task, TaskOutput, TaskStop, TeamCreate, TeamDelete,
        --                     SendMessage, TodoWrite, ToolSearch, Skill, NotebookEdit,
        --                     mcp__nanoclaw__*
        --   mcpServers:       nanoclaw (ipc-mcp-stdio process; env carries chat_jid,
        --                     group_folder, is_main, specialist_type if set)
        --   hooks:            PreCompact: [archive transcript, set ⏳ reaction]
        --                     PostCompact: [set 💭 reaction]
        --   env:              host env + CLAUDE_CODE_AUTO_COMPACT_WINDOW=200000
        -- Resume options when turn.session_id_in is set:
        --   resume:           turn.session_id_in
        --   resumeSessionAt:  turn.resume_at
        -- System prompt:
        --   Non-main groups:  claude_code preset with global CLAUDE.md appended
        --   Main group:       claude_code preset only
        -- Additional directories: any directories mounted at /workspace/extra/*
        -- The prompt is delivered as an async iterable (MessageStream) so
        -- isSingleUserTurn=false, allowing agent-teams subagents to run to completion.
}

-- The SDK emits a system/init event at the start of each query.
-- The session_id is captured and written to a well-known path for MCP tool access.
rule SessionInitialized {
    when: SdkSessionInitialized(turn, session_id)

    requires: turn.status = active

    ensures: QuerySession.created(turn: turn, session_id: session_id)
    ensures: turn.session_id_out = session_id
}

-- The SDK emits a result event for each completed agent response.
-- Emitted immediately as a ContainerOutput to the host.
-- Input and output tokens accumulate across all result events within the run.
rule QueryTurnProducesResult {
    when: SdkResultEmitted(turn, text, input_tokens, output_tokens)

    requires: turn.status = active

    ensures: ContainerOutput.emitted(
        status: success,
        result: text,
        new_session_id: turn.session_id_out
    )
}

-- A QueryTurn finishes when the SDK async generator is exhausted.
-- A session-update marker is emitted and the container enters the idle wait.
rule QueryTurnCompleted {
    when: SdkQueryExhausted(turn, last_assistant_uuid)

    requires: turn.status = active

    ensures: turn.status = completed
    ensures: turn.last_assistant_uuid = last_assistant_uuid
    ensures: ContainerOutput.emitted(
        status: success,
        result: null,
        new_session_id: turn.session_id_out
    )
}

-- ---- IPC Injection ----

-- Follow-up messages arriving during an active query are injected into the SDK's
-- message stream, extending the current turn without starting a new query.
rule IpcMessageInjectedDuringQuery {
    when: IpcMessageReceived(turn, text)

    requires: turn.status = active

    @guidance
        -- The message is enqueued into the turn's MessageStream (async iterable) and
        -- consumed by the SDK as an additional user turn within the same query() call.
        -- This lets users add context or corrections without interrupting the agent.
}

-- An interrupt signal ends the active query immediately.
-- The interrupt text becomes the prompt for the next QueryTurn.
rule QueryInterruptedByIpc {
    when: IpcInterruptReceived(turn, text)

    requires: turn.status = active

    ensures: turn.status = interrupted
    ensures: ContainerOutput.emitted(
        status: success,
        result: null,
        new_session_id: turn.session_id_out
    )
    ensures: QueryTurn.created(
        chat_jid: turn.chat_jid,
        prompt: text,
        session_id_in: turn.session_id_out,
        resume_at: turn.last_assistant_uuid,
        status: pending
    )

    @guidance
        -- An interrupt received between queries (during the idle wait) is treated as a
        -- regular IpcMessageReceived rather than an interrupt, because there is no active
        -- query to cut short. It becomes the prompt for the next QueryTurn normally.
}

-- ---- Query Loop ----

-- After a QueryTurn completes, the next IPC message drives a new QueryTurn in the
-- same session, resuming precisely from the last assistant message.
rule QueryLoopContinues {
    when: IpcMessageReceived(prev_turn, text)

    requires: prev_turn.status = completed

    ensures: QueryTurn.created(
        chat_jid: prev_turn.chat_jid,
        prompt: text,
        session_id_in: prev_turn.session_id_out,
        resume_at: prev_turn.last_assistant_uuid,
        status: pending
    )
}

-- The _close sentinel between queries signals the container to exit cleanly.
rule CloseSentinelReceivedBetweenQueries {
    when: IpcCloseSentinelReceived(prev_turn)

    requires: prev_turn.status = completed

    @guidance
        -- The container exits. No additional ContainerOutput is emitted beyond
        -- what was already emitted by QueryTurnCompleted.
}

-- The _close sentinel during an active query ends the stream immediately.
-- No session-update marker is emitted (to avoid resetting the host's idle timer).
rule CloseSentinelReceivedDuringQuery {
    when: IpcCloseSentinelReceived(turn)

    requires: turn.status = active

    ensures: turn.status = aborted
}

-- ---- Compaction Lifecycle ----

-- Before the SDK compacts the conversation, the full transcript is archived to disk
-- and an hourglass reaction signals compaction is in progress.
rule PreCompactTriggered {
    when: SdkPreCompact(turn)

    requires: turn.status = active

    ensures: ArchivedTranscript.created(
        session: turn.session,
        path: "/workspace/group/conversations/{date}-{title}.md",
        title: session_summary_if_available(turn.session),
        archived_at: now
    )
    ensures: ReactionTask.created(chat_jid: turn.chat_jid, emoji: "⏳")

    @guidance
        -- The transcript is parsed from the SDK's transcript_path (JSONL format).
        -- Only user and assistant text turns are included; tool calls are omitted.
        -- Long assistant turns are truncated at 2000 characters.
        -- The session summary lookup reads sessions-index.json in the session's project dir;
        -- a HHmm timestamp fallback name is used if no summary is available.
        -- The reaction task is written to /workspace/ipc/tasks/ as a JSON file and
        -- processed by the host IPC watcher asynchronously.
}

-- After the SDK completes context compaction, a thought-bubble reaction confirms success.
rule PostCompactTriggered {
    when: SdkPostCompact(turn)

    requires: turn.status = active

    ensures: ReactionTask.created(chat_jid: turn.chat_jid, emoji: "💭")
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should the allowed tools set be modelled as a config field or enum so that additions are traceable through the spec?"

open question "The global CLAUDE.md is appended to the system prompt for non-main groups but not for main groups — should this asymmetry be an explicit invariant or is the @guidance comment on QueryTurnActivated sufficient?"

open question "evalSkipSkills isolation (removing named skills before the agent runs) is a test harness concern — worth speccing, or exclude as test infrastructure?"

open question "Should session continuity across QueryTurns (each turn's session_id_in = previous turn's session_id_out) be expressed as an entity-level invariant or a contract?"

open question "The sessions-index.json summary lookup for transcript naming: should the sessions index be a spec entity, or is it an implementation detail of the archiving step?"
