-- allium: 3
-- container-protocol.allium
--
-- The abstract contract between the host process and agent containers.
-- Models the input/output wire format, the QueryTurn lifecycle, the query loop,
-- IPC message injection, interrupt/close signals, and script gating for
-- scheduled tasks. LLM-agnostic: any implementation that honours the QueryTurn
-- state machine and ContainerOutput protocol is a valid container.
--
-- Scope: the abstract contract between the host process and agent containers
-- Includes: ContainerInput/Output protocol, QueryTurn lifecycle, query loop,
--           IPC message injection, interrupt/close signals, script gating,
--           slash command dispatch (/ prefix convention)
-- Excludes:
--   - LLM implementation details (see container-claude-sdk.allium)
--   - Host-side session tracking (see nanoclaw.allium)
--   - IPC task wire formats (see ipc.allium)
--   - Container orchestration (see nanoclaw.allium)
--   - Credential proxy (infrastructure)
--   - Implementation contract (see ContainerLlmImplementation contract below)

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    ipc_poll_interval: Duration = 500.ms   -- cadence for polling IPC input during and between queries
    script_timeout: Duration = 30.seconds  -- maximum runtime for a scheduled-task gate script
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- Any spec that implements the container LLM protocol must satisfy this contract.
-- It declares a hard requirement (tool call support) and optional capability flags.
contract ContainerLlmImplementation {
    -- REQUIRED: the LLM must support tool/function calling.
    -- This is not a capability flag — it is a hard prerequisite. The nanoclaw MCP
    -- server (ipc-mcp-stdio) exposes tools the agent must be able to call
    -- (send_message, schedule_task, deliver_result, etc.). Without tool call support
    -- the agent cannot communicate with the host and cannot fulfil the protocol.
    --
    -- Tool calls and MCP: the MCP server is a stdio subprocess that speaks the MCP
    -- protocol. Implementations using a non-Claude LLM act as a proxy:
    --   1. Start the nanoclaw MCP server subprocess at query time.
    --   2. Enumerate its tools via MCP tools/list.
    --   3. Expose them in the LLM's native function-calling format
    --      (OpenAI JSON schema, Gemini function declarations, etc.).
    --   4. Route tool calls from the LLM to the MCP server via tools/call.
    --   5. Return MCP responses as tool results to the LLM.
    -- The tool call wire format is an implementation detail; the obligation is that
    -- mcp__nanoclaw__* tools are available to the agent during every QueryTurn.

    -- Whether this implementation supports real-time injection of IPC messages into
    -- an active query. Both the Claude Agent SDK (via MessageStream) and the Claude
    -- CLI (via --input-format=stream-json) support this. A stateless REST API wrapper
    -- would set this to false; IPC messages arriving during an active query are then
    -- buffered and prepended to the next QueryTurn's prompt instead.
    supports_mid_turn_injection: Boolean

    -- Whether this implementation surfaces compaction lifecycle events (pre/post).
    -- The Claude Agent SDK exposes these as hook callbacks; the Claude CLI exposes
    -- them via --include-hook-events in the stream-json output. Both set this to true.
    -- An implementation that cannot surface compaction events sets this to false;
    -- no transcript archiving or reactions occur.
    supports_compaction_hooks: Boolean

    -- Whether this implementation supports agent sub-tasks (TeamCreate/TeamDelete).
    -- These are Claude Agent SDK features that spawn parallel subagents within a single
    -- query call. The Claude CLI supports them via --agents. Non-Claude LLMs do not.
    -- When false, any agent attempt to use TeamCreate/TeamDelete will fail silently
    -- or be unavailable in the tool list.
    supports_agent_teams: Boolean

    @guidance
        -- Mandatory behavioral obligations for all implementations regardless of flags:
        --
        -- 1. A pending QueryTurn must transition to active when the LLM call begins.
        -- 2. A session_id must be established after activation and written to
        --    /workspace/ipc/current_session_id so MCP tools can access it.
        -- 3. Each LLM response turn must be emitted as ContainerOutput(status:success, result:text).
        -- 4. When the LLM response stream is exhausted, the QueryTurn must reach
        --    status=completed and emit ContainerOutput(result:null, new_session_id:...).
        -- 5. An interrupt signal must end the current query; the interrupt text becomes
        --    the prompt for the next QueryTurn.
        -- 6. The close sentinel must end the query loop cleanly.
        -- 7. When supports_compaction_hooks=true, pre-compact must archive the
        --    transcript and emit a ⏳ reaction; post-compact must emit a 💭 reaction.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The configuration delivered to the container at startup (via stdin as JSON).
-- allium-ignore allium.definition.unused
value ContainerInput {
    prompt: String                  -- initial user message or task instruction
    session_id: String?             -- conversation ID to resume; null = new session
    group_folder: String            -- workspace subdirectory name for this group
    chat_jid: String                -- channel-qualified group identifier
    is_main: Boolean                -- whether this is the main group (elevated trust)
    is_scheduled_task: Boolean      -- whether this run was triggered by the scheduler
    assistant_name: String?         -- display name used in archived transcripts
    script: String?                 -- bash script to gate agent invocation (scheduled tasks only)
}

-- One result record emitted to the host during a container run.
-- Multiple outputs may be produced per run: one per SDK result event plus
-- session-update markers emitted between queries.
value ContainerOutput {
    status: success | error
    result: String?                 -- agent text response; null for session-update markers
    new_session_id: String?         -- conversation ID as of this output
    total_tokens: Integer?          -- cumulative input+output tokens for the run so far
    error: String?                  -- present when status = error
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- One call to the LLM within a container run.
-- The first QueryTurn in a run uses the initial prompt and may resume a prior session.
-- Subsequent QueryTurns are driven by IPC messages received while the container waits.
-- All QueryTurns in the same run share the same evolving session thread.
entity QueryTurn {
    chat_jid: String                -- from ContainerInput; used for reactions and follow-up queries
    prompt: String
    session_id_in: String?          -- conversation ID passed to this call; null = new session
    session_id_out: String?         -- conversation ID established or continued after init
    resume_at: String?              -- reference to the last assistant message from the previous turn;
                                    -- passed for precise transcript resumption
    last_message_ref: String?       -- reference to the last assistant message from this turn;
                                    -- becomes resume_at for the next QueryTurn in the run

    -- The pending -> active and active -> completed transitions are observed only in
    -- implementation specs (e.g. container-claude-sdk.allium); the checker cannot see
    -- cross-spec rule coverage, so these suppressions are necessary.
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: pending | active | completed | interrupted | aborted

    transitions status {
        pending -> active           -- LLM query call begins
        active -> completed         -- LLM response stream exhausted normally
        active -> interrupted       -- interrupt signal received; next turn uses interrupt text
        active -> aborted           -- close sentinel received during active query
        terminal: completed
        terminal: interrupted
        terminal: aborted
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Startup ----

-- A prompt beginning with "/" is a slash command: an implementation-specific session
-- operation that bypasses the normal query loop. The protocol dispatches it to
-- implementations via SlashCommandReceived; each implementation handles the commands
-- it supports and falls through unrecognised ones as regular prompts.
--
-- is_slash_command(prompt): true if the prompt, after trimming whitespace, begins with "/".
-- This is a user-facing convention shared across all container implementations.
rule SlashCommandDispatched {
    when: ContainerInvoked(input)

    requires: is_slash_command(input.prompt)

    ensures: SlashCommandReceived(input)
}

-- Container receives its input and creates the first QueryTurn.
-- Scheduled tasks receive a preamble injected into the prompt so the agent knows
-- it was not triggered by a live user. Any IPC messages queued at startup are
-- appended to the initial prompt.
rule ContainerBootstrapped {
    when: ContainerInvoked(input)

    requires: not is_slash_command(input.prompt)
    requires: not (input.is_scheduled_task and input.script != null)

    ensures: QueryTurn.created(
        chat_jid: input.chat_jid,
        prompt: input.prompt,
        session_id_in: input.session_id,
        resume_at: null,
        status: pending
    )

    @guidance
        -- The scheduled-task preamble ("[SCHEDULED TASK - ...]") is prepended to input.prompt
        -- when input.is_scheduled_task is true.
        -- Pending IPC messages already in /workspace/ipc/input/ at startup are appended
        -- to the initial prompt before the first QueryTurn is created.
}

-- For scheduled tasks that include a gate script, the script runs first.
-- wakeAgent=true enriches the prompt with script data and invokes the agent.
-- wakeAgent=false or any script error suppresses agent invocation entirely.
rule ScriptGatesScheduledTask {
    when: ContainerInvoked(input)

    requires: not is_slash_command(input.prompt)
    requires: input.is_scheduled_task
    requires: input.script != null

    -- Outcome A: script succeeds with wakeAgent=true
    --   ensures: QueryTurn.created(
    --       chat_jid: input.chat_jid,
    --       prompt: "[SCHEDULED TASK]\n\nScript output:\n{script_data}\n\nInstructions:\n{input.prompt}",
    --       session_id_in: input.session_id,
    --       resume_at: null,
    --       status: pending
    --   )
    -- Outcome B: script returns wakeAgent=false or errors
    --   ensures: ContainerOutput.emitted(status: success, result: null)
    --   (container exits without invoking the LLM)

    @guidance
        -- The script runs as a bash process subject to config.script_timeout.
        -- Its final stdout line must be valid JSON with a boolean wakeAgent field.
        -- Any exit error, timeout, or non-JSON output is treated as wakeAgent=false.
        -- When wakeAgent=true, additional JSON fields from the script output are
        -- serialised into the prompt so the agent receives them as context.
}

-- ---- Query Loop ----

-- After a QueryTurn completes, the next IPC message drives a new QueryTurn in the
-- same session, resuming precisely from the last assistant message.
rule QueryLoopContinues {
    when: IpcMessageReceived(prev_turn, text)

    requires: prev_turn.status = completed

    ensures: QueryTurn.created(
        chat_jid: prev_turn.chat_jid,
        prompt: text,
        session_id_in: prev_turn.session_id_out,
        resume_at: prev_turn.last_message_ref,
        status: pending
    )
}

-- The _close sentinel between queries signals the container to exit cleanly.
rule CloseSentinelReceivedBetweenQueries {
    when: IpcCloseSentinelReceived(prev_turn)

    requires: prev_turn.status = completed

    @guidance
        -- The container exits. No additional ContainerOutput is emitted beyond
        -- what was already emitted by the implementation's turn-completion rule.
}

-- The _close sentinel during an active query ends the stream immediately.
-- No session-update marker is emitted (to avoid resetting the host's idle timer).
rule CloseSentinelReceivedDuringQuery {
    when: IpcCloseSentinelReceived(turn)

    requires: turn.status = active

    ensures: turn.status = aborted
}

-- ---- IPC Injection ----

-- Follow-up messages arriving during an active query are injected into the LLM's
-- message stream, extending the current turn without starting a new query.
rule IpcMessageInjectedDuringQuery {
    when: IpcMessageReceived(turn, text)

    requires: turn.status = active

    @guidance
        -- The message is enqueued into the turn's message stream and consumed by
        -- the LLM as an additional user turn within the same query call.
        -- This lets users add context or corrections without interrupting the agent.
}

-- An interrupt signal ends the active query immediately.
-- The interrupt text becomes the prompt for the next QueryTurn.
rule QueryInterruptedByIpc {
    when: IpcInterruptReceived(turn, text)

    requires: turn.status = active

    ensures: turn.status = interrupted
    ensures: ContainerOutput.emitted(
        status: success,
        result: null,
        new_session_id: turn.session_id_out
    )
    ensures: QueryTurn.created(
        chat_jid: turn.chat_jid,
        prompt: text,
        session_id_in: turn.session_id_out,
        resume_at: turn.last_message_ref,
        status: pending
    )

    @guidance
        -- An interrupt received between queries (during the idle wait) is treated as a
        -- regular IpcMessageReceived rather than an interrupt, because there is no active
        -- query to cut short. It becomes the prompt for the next QueryTurn normally.
}

