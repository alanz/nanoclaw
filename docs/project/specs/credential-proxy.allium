-- allium: 3
-- credential-proxy.allium
--
-- Host-side HTTP proxy that intercepts all LLM API calls from agent containers,
-- selects a backend based on the model field in the request body, injects the
-- appropriate credentials, and forwards to the upstream API. Containers never
-- see real credentials; they address ANTHROPIC_BASE_URL which points at this proxy.
--
-- Scope: credential proxy as a backend-routing component on the host
-- Includes: backend route configuration, route selection by model, credential
--           injection per auth strategy, OAuth exchange path, fallback behaviour,
--           Anthropic wire format compatibility requirement
-- Excludes:
--   - Container protocol and lifecycle (see container-protocol.allium)
--   - SDK query configuration and session management (see container-claude-sdk.allium)
--   - Container orchestration and host session tracking (see nanoclaw.allium)

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    listen_port: Integer = 3001                     -- port the proxy listens on inside the host
    request_body_max_size: Integer = 10_000_000     -- maximum buffered request body in bytes (10 MB)
    default_upstream: String = "https://api.anthropic.com"
    oauth_exchange_path: String = "/api/oauth/claude_cli/create_api_key"
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum AuthStrategy {
    anthropic_api_key       -- injects x-api-key header
    | openai_api_key        -- injects Authorization: Bearer header (OpenAI-style)
    | bearer                -- injects Authorization: Bearer header (generic)
    | oauth                 -- injects Authorization: Bearer with OAuth token (Anthropic OAuth flow)
    | passthrough           -- no credential injection; request forwarded as-is
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A mapping from a model-name pattern to an upstream backend and its credentials.
-- Every backend must natively implement the Anthropic Messages API wire format
-- (accept POST /v1/messages with Anthropic body schema). The proxy never
-- translates request or response bodies.
value BackendRoute {
    pattern: String                 -- model-name pattern: exact match or prefix (e.g. "gpt-4", "claude-")
    upstream_url: String            -- base URL of the upstream API
    auth_strategy: AuthStrategy
    credential_env_var: String?     -- host env var holding the credential; null when passthrough
    is_default: Boolean             -- true for the fallback Anthropic route
    anthropic_api_compatible: Boolean -- true when the upstream accepts Anthropic Messages API wire format
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The proxy's routing table, assembled at startup from host configuration.
entity RouteTable {
    routes: List<BackendRoute>
    default_route: BackendRoute     -- the route used when no pattern matches

    -- The default route must exist in the routes list.
    -- Exactly one route should have is_default = true.
}

-- A single proxied request flowing through the credential proxy.
-- ProxiedRequest is created by the HTTP listener (external) and consumed by rules here.
-- The status lifecycle spans route selection and credential injection; both sides are
-- driven by rules in this spec, but initial creation (received) is external.
-- allium-ignore allium.entity.unused
entity ProxiedRequest {
    -- allium-ignore allium.field.unused
    method: String                  -- HTTP method (POST, GET, etc.)
    path: String                    -- request path (e.g. /v1/messages)
    model: String?                  -- extracted from JSON request body; null if body has no model field
    matched_route: BackendRoute?    -- the route selected for this request; null before selection
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: received | routed | forwarded | failed

    transitions status {
        received -> routed          -- route selected
        routed -> forwarded         -- request sent to upstream
        routed -> failed            -- upstream unreachable or credential missing
        terminal: forwarded
        terminal: failed
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Route Selection ----

-- The OAuth token exchange path always routes to the Anthropic backend
-- regardless of model, injecting the real OAuth token. This is the mechanism
-- by which the container CLI obtains a temporary API key without ever seeing
-- the real OAuth credential.
rule OAuthExchangeRoutedToAnthropic {
    when: RequestReceived(request, route_table)

    requires: request.path = config.oauth_exchange_path
    requires: request.status = received

    ensures: request.matched_route = route_table.default_route
    ensures: request.status = routed

    @guidance
        -- The OAuth exchange request carries a placeholder token from the container.
        -- The proxy replaces it with the real OAuth token (from CLAUDE_CODE_OAUTH_TOKEN
        -- or ANTHROPIC_AUTH_TOKEN env var) before forwarding to the Anthropic upstream.
        -- The auth_strategy on the matched route is ignored for this path; the proxy
        -- always injects the OAuth token as Authorization: Bearer.
}

-- For non-OAuth paths, select the backend route by matching the model field
-- in the request body. Longest-prefix match wins; ties broken by declaration order.
rule RouteSelectedByModel {
    when: RequestReceived(request, route_table)

    requires: request.path != config.oauth_exchange_path
    requires: request.status = received
    requires: request.model != null

    ensures: request.matched_route = best_matching_route(request.model, route_table.routes)
    ensures: request.status = routed

    @guidance
        -- Route matching uses longest-prefix semantics:
        --   1. Exact match on pattern takes priority.
        --   2. If no exact match, the route whose pattern is the longest prefix of the
        --      model string wins.
        --   3. If no prefix matches, the default route is used.
        -- best_matching_route returns the default route when no pattern matches.
}

-- Requests with no model field (e.g. GET requests, health checks) use the default route.
rule NoModelFallsBackToDefault {
    when: RequestReceived(request, route_table)

    requires: request.path != config.oauth_exchange_path
    requires: request.status = received
    requires: request.model = null

    ensures: request.matched_route = route_table.default_route
    ensures: request.status = routed
}

-- ---- Credential Injection ----

-- Once a route is selected, the proxy injects credentials based on the route's
-- auth strategy and forwards the request to the upstream URL.
rule CredentialInjectedAndForwarded {
    when: RequestRouted(request)

    requires: request.status = routed
    requires: request.matched_route != null
    requires: request.matched_route.auth_strategy != passthrough

    ensures: request.status = forwarded

    @guidance
        -- Credential injection by auth strategy:
        --
        --   anthropic_api_key:
        --     Sets x-api-key header to the value of the credential env var.
        --     Removes any existing Authorization header from the container.
        --
        --   openai_api_key:
        --     Sets Authorization: Bearer header to the value of the credential env var.
        --     Removes any existing x-api-key header from the container.
        --
        --   bearer:
        --     Sets Authorization: Bearer header to the value of the credential env var.
        --
        --   oauth:
        --     Sets Authorization: Bearer header to the value of the credential env var.
        --     Used for the default Anthropic route when in OAuth auth mode.
        --
        -- In all cases, the host header is rewritten to match the upstream URL.
        -- The credential env var is read from the host environment at request time;
        -- if the env var is missing or empty, the request fails.
}

-- Passthrough routes forward without credential injection.
rule PassthroughForwarded {
    when: RequestRouted(request)

    requires: request.status = routed
    requires: request.matched_route != null
    requires: request.matched_route.auth_strategy = passthrough

    ensures: request.status = forwarded

    @guidance
        -- The request is forwarded to the upstream URL with all original headers intact.
        -- No credentials are added or removed. The host header is still rewritten
        -- to match the upstream URL.
}

-- ---- Failure ----

-- If the credential env var is missing for a non-passthrough route, the request fails.
rule MissingCredentialFails {
    when: RequestRouted(request)

    requires: request.status = routed
    requires: request.matched_route != null
    requires: request.matched_route.auth_strategy != passthrough
    requires: credential_env_var_missing(request.matched_route.credential_env_var)

    ensures: request.status = failed

    @guidance
        -- The proxy returns HTTP 502 to the container with a descriptive error message
        -- indicating which env var is missing. This surfaces clearly in the agent's
        -- error output rather than producing a cryptic upstream failure.
}

-- ---- Route Table Assembly ----

-- At startup, the proxy assembles the route table from host configuration.
-- The default Anthropic route is always present.
rule RouteTableAssembled {
    when: ProxyStarted()

    ensures: RouteTable.created(
        routes: configured_routes,
        default_route: anthropic_default_route
    )

    @guidance
        -- The default Anthropic route is constructed from host env vars:
        --   upstream_url:      ANTHROPIC_BASE_URL or config.default_upstream
        --   auth_strategy:     anthropic_api_key if ANTHROPIC_API_KEY is set,
        --                      oauth if CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_AUTH_TOKEN is set
        --   credential_env_var: "ANTHROPIC_API_KEY" or "CLAUDE_CODE_OAUTH_TOKEN" / "ANTHROPIC_AUTH_TOKEN"
        --   is_default:        true
        --   anthropic_api_compatible: true
        --
        -- Additional routes are loaded from a configuration source (env var or config file).
        -- The exact configuration format is an implementation detail.
        --
        -- All routes must expose the Anthropic Messages API (/v1/messages) wire format.
        -- The proxy forwards request and response bodies byte-for-byte; it never
        -- translates between API formats. Backends that accept the Anthropic wire
        -- format natively (e.g. via an "Anthropic skin") are eligible.
        --
        -- Example: OpenRouter route
        --   upstream_url:              "https://openrouter.ai/api"
        --   auth_strategy:             bearer
        --   credential_env_var:        "OPENROUTER_API_KEY"
        --   anthropic_api_compatible:  true
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant SingleDefaultRoute {
    for rt in RouteTables:
        rt.routes.any(r => r.is_default) and
        rt.routes.count(r => r.is_default) = 1
}

invariant AllRoutesAnthropicCompatible {
    for rt in RouteTables:
        rt.routes.all(r => r.anthropic_api_compatible)
}

-- Non-expressible architectural properties (not entity state assertions):
--
-- ContainerNeverSeesCredentials: Containers address the proxy via
-- ANTHROPIC_BASE_URL pointing at localhost:{config.listen_port}. The proxy
-- strips any placeholder credentials from inbound requests before injecting
-- real ones. No real API key or OAuth token is ever mounted into or visible
-- from within a container.
--
-- OAuthExchangeAlwaysAnthropic: Requests to the OAuth exchange path are
-- always routed to the Anthropic backend regardless of any model field or
-- other routing configuration. This is enforced by the OAuthExchangeRoutedToAnthropic
-- rule's requires clause (request.path = config.oauth_exchange_path).
--
-- AnthropicWireFormatRequired: The proxy forwards request and response bodies
-- byte-for-byte with no body translation. All upstreams in the route table must
-- accept the Anthropic Messages API wire format (POST /v1/messages with Anthropic
-- body schema). This is enforced by the AllRoutesAnthropicCompatible invariant
-- and the anthropic_api_compatible field on BackendRoute.

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Non-Claude container runtimes
--
-- The credential proxy is currently designed around the assumption that Claude Code
-- runs inside every container and communicates via ANTHROPIC_BASE_URL. This assumption
-- is embedded in the AllRoutesAnthropicCompatible invariant and the anthropic_api_compatible
-- field: all backends must speak the Anthropic Messages API wire format.
--
-- A container running an arbitrary LLM runtime (e.g. an OpenAI or Gemini agent) would
-- not use ANTHROPIC_BASE_URL at all. Its LLM client would use a different env var
-- (OPENAI_BASE_URL, GEMINI_API_KEY, etc.), bypassing the proxy entirely. The credential
-- isolation guarantee would break: the container would need real credentials injected
-- directly rather than via proxy interception.
--
-- Open questions:
--   1. Should the proxy be generalised to intercept multiple env vars and support
--      non-Anthropic wire formats, relaxing or removing AllRoutesAnthropicCompatible?
--   2. Or should the proxy remain Claude-Code-only, with a separate credential injection
--      mechanism specified for non-Claude container runtimes?
--   3. If (2), where does that mechanism live — in container-protocol.allium as a
--      ContainerLlmImplementation capability, or as a separate spec?
