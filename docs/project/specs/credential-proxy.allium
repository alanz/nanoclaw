-- allium: 3
-- credential-proxy.allium
--
-- Host-side HTTP proxy that intercepts all LLM API calls from agent containers,
-- injects the appropriate credentials, and forwards to a single upstream API.
-- Containers never see real credentials; they address ANTHROPIC_BASE_URL which
-- points at this proxy.
--
-- Scope: credential proxy as a single-upstream forwarding component on the host
-- Includes: auth mode selection, credential injection per mode, OAuth exchange
--           path, upstream error handling
-- Excludes:
--   - Container protocol and lifecycle (see container-protocol.allium)
--   - SDK query configuration and session management (see container-claude-sdk.allium)
--   - Container orchestration and host session tracking (see nanoclaw.allium)

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The proxy operates in exactly one of two auth modes, determined at startup.
-- allium-ignore allium.definition.unused
enum AuthMode {
    api_key             -- ANTHROPIC_API_KEY is set; inject x-api-key on every request
    | oauth             -- no API key; inject OAuth token on exchange requests only
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- A single proxied request flowing through the credential proxy.
-- ProxiedRequest is created by the HTTP listener (external) and consumed by rules here.
-- The status lifecycle spans credential injection and forwarding; both sides are
-- driven by rules in this spec, but initial creation (received) is external.
-- allium-ignore allium.entity.unused
entity ProxiedRequest {
    -- allium-ignore allium.field.unused
    method: String                  -- HTTP method (POST, GET, etc.)
    path: String                    -- request path (e.g. /v1/messages)
    has_authorization_header: Boolean -- whether the container sent an Authorization header
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: received | forwarded | failed

    transitions status {
        received -> forwarded       -- request sent to upstream
        received -> failed          -- upstream error
        terminal: forwarded
        terminal: failed
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    listen_port: Integer = 3001                     -- port the proxy listens on inside the host
    default_upstream: String = "https://api.anthropic.com"
    oauth_exchange_path: String = "/api/oauth/claude_cli/create_api_key"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Auth Mode Selection ----

-- At startup, the proxy reads host env vars and selects a single auth mode.
-- If ANTHROPIC_API_KEY is set, the mode is api_key. Otherwise it is oauth
-- (using CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_AUTH_TOKEN).
-- allium-ignore allium.rule.noStateChange
rule AuthModeDeterminedAtStartup {
    when: ProxyStarted()

    ensures: auth_mode = api_key implies env_var_set("ANTHROPIC_API_KEY")
    ensures: auth_mode = oauth implies not env_var_set("ANTHROPIC_API_KEY")

    @guidance
        -- The upstream URL is resolved from ANTHROPIC_BASE_URL if set,
        -- otherwise config.default_upstream. All requests go to this
        -- single upstream regardless of model or path.
}

-- ---- API Key Mode ----

-- In api_key mode, every request has its x-api-key header stripped and replaced
-- with the real ANTHROPIC_API_KEY. Any existing container credentials are removed.
rule ApiKeyInjected {
    when: RequestReceived(request)

    requires: request.status = received
    requires: auth_mode = api_key

    ensures: request.status = forwarded

    @guidance
        -- The proxy strips any x-api-key header sent by the container and
        -- injects the real ANTHROPIC_API_KEY as x-api-key. The host header
        -- is rewritten to match the upstream URL.
}

-- ---- OAuth Mode ----

-- In oauth mode, when the container sends an Authorization header (typically
-- on the OAuth exchange path or auth probes), the proxy replaces it with
-- the real OAuth token as a Bearer token. This covers the exchange path
-- where the container CLI obtains a temporary API key.
rule OAuthTokenInjected {
    when: RequestReceived(request)

    requires: request.status = received
    requires: auth_mode = oauth
    requires: request.has_authorization_header

    ensures: request.status = forwarded

    @guidance
        -- The proxy replaces the container's placeholder Authorization header
        -- with Bearer {real_oauth_token}, sourced from CLAUDE_CODE_OAUTH_TOKEN
        -- or ANTHROPIC_AUTH_TOKEN. This mechanism lets the container CLI exchange
        -- its placeholder for a temporary API key without ever seeing the real
        -- OAuth credential.
}

-- In oauth mode, requests without an Authorization header (post-exchange
-- requests carrying only x-api-key) are forwarded without token injection.
-- The temporary API key obtained via exchange is valid as-is.
rule OAuthPassthrough {
    when: RequestReceived(request)

    requires: request.status = received
    requires: auth_mode = oauth
    requires: not request.has_authorization_header

    ensures: request.status = forwarded

    @guidance
        -- Post-exchange requests use x-api-key with the temporary API key
        -- the container obtained during the OAuth exchange. These pass
        -- through without any credential injection.
}

-- ---- Upstream Error ----

-- When the upstream is unreachable or returns a transport error, the proxy
-- returns HTTP 502 to the container.
-- allium-ignore allium.rule.noStateChange
rule UpstreamErrorReturnsBadGateway {
    when: UpstreamError(request)

    requires: request.status = received

    ensures: request.status = failed

    @guidance
        -- The proxy returns HTTP 502 (Bad Gateway) to the container. This
        -- surfaces clearly in the agent's error output rather than producing
        -- a cryptic upstream failure.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Non-expressible architectural properties (not entity state assertions):
--
-- ContainerNeverSeesCredentials: Containers address the proxy via
-- ANTHROPIC_BASE_URL pointing at localhost:{config.listen_port}. The proxy
-- strips any placeholder credentials from inbound requests before injecting
-- real ones. No real API key or OAuth token is ever mounted into or visible
-- from within a container.
