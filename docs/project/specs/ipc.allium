-- allium: 3
-- ipc.allium
--
-- NanoClaw IPC/MCP bridge between agent containers and the host process.
-- Agents communicate with the host exclusively through file-based IPC under /workspace/ipc/.
-- Inside each container an MCP server (ipc-mcp-stdio) translates tool calls into JSON files.
-- The host IPC watcher polls per-group IPC directories, processes files, and writes responses.
--
-- Error handling: IPC files that fail to process (JSON parse error, missing fields,
-- unhandled exception) are moved to DATA_DIR/ipc/errors/{sourceGroup}-{filename}
-- rather than deleted, preserving them for post-hoc inspection. Nothing reads from
-- the errors directory; it is write-only from the host's perspective.
--
-- Scope: IPC protocol, MCP tool surface, authorization, request-response queries
-- Includes: message/file delivery, task commands, read-only snapshot reads,
--           request-response queries, agent-to-agent deliver_result,
--           specialist dispatch/delegation/memory/result tools
-- Excludes:
--   - Task lifecycle state machine (see scheduling.allium)
--   - Memory indexing internals (see memory.allium)
--   - Core routing and session management (see nanoclaw.allium)
--   - Channel wire protocols (Telegram, DeltaChat, etc.)
--   - Container runtime mechanics (Apple Container / Docker)
--   - Brave Search and Zotero search (third-party: treated as read-only lookups)

use "./nanoclaw.allium" as nanoclaw
use "./specialists.allium" as specialists

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The kind of query a request-response IPC call represents.
enum QueryKind {
    transcript        -- query_transcript: message history for a chat
  | memory_search     -- memory_search: hybrid vector + keyword search
  | memory_get        -- memory_get: full content of a specific memory file
  | memory_list       -- memory_list: list indexed files by path prefix
  | skill_eval        -- skill_eval: run an eval case for a skill (main only)
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The source identity of an IPC call from a regular group agent.
-- Determined entirely by which IPC directory the file appeared in — not from payload contents.
-- The host never trusts group identity claims written inside a file.
-- dispatch_depth: the container reads NANOCLAW_DISPATCH_DEPTH from its environment and writes
-- the value into the IPC file payload; the host reads it back from the payload. This means
-- the host trusts the container-supplied depth rather than deriving it from its own records.
-- Contrast with specialist IPC, where the host computes depth from the DB (parentTask.depth + 1)
-- and the payload carries no depth field. See open question below for alignment work.
value IpcAuthor {
    group_folder: String    -- name of the group whose IPC directory contained the file
    is_main: Boolean        -- whether that group is the registered main group
    dispatch_depth: Integer -- nesting level of the current container run (0 for top-level runs)
}

-- The source identity of an IPC call from a specialist container.
-- Determined by the per-task IPC directory: DATA_DIR/ipc/spec-{task-id}/.
-- Specialist directories live as siblings of group IPC directories under DATA_DIR/ipc/
-- and are scanned by the same polling loop. The host resolves the task by recognising
-- the "spec-" prefix and parsing the task_id from the directory name; task identity is
-- never taken from the file payload.
value SpecialistIpcAuthor {
    task_id: String                         -- derived from the IPC directory name
    task: specialists.SpecialistTask        -- resolved by the host from task_id
    specialist_type: specialists.SpecialistType  -- task.specialist_type; convenience accessor
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- A pending request-response IPC call issued by an agent.
-- The agent writes a task file containing a unique requestId, then polls
-- /workspace/ipc/responses/{requestId}.json until it appears or times out.
--
-- NOTE: IpcQuery is a conceptual model of the query lifecycle — it is NOT currently
-- materialised on the host. The host processes queries synchronously in the IPC poll
-- loop and writes response files immediately; it keeps no in-memory or DB record of
-- pending queries. Timeouts are enforced entirely on the container side (the container
-- MCP server polls for the response file with a deadline and returns an error if it
-- expires). This entity is retained because host-side query tracking is a plausible
-- future improvement that would address known failure modes:
--
--   • Orphaned response files: if the container times out (or crashes) before reading
--     the response, the file is never consumed and accumulates in responses/.
--   • IPC poll blocking: slow queries (memory_search etc.) hold up all other IPC
--     processing for that group's directory for their duration. (skill_eval is exempt:
--     it spawns a throwaway container fire-and-forget and returns immediately.)
--   • skill_eval orphaned container on host crash: the throwaway eval container runs
--     fire-and-forget in the background; if the host crashes during the eval, the
--     container keeps running and occupies a concurrency slot until it exits naturally.
--     The slot is not released cleanly because GroupQueue is rebuilt fresh on restart.
--
-- If host-side tracking is added, remove this note and the allium-ignore suppressions.
entity IpcQuery {
    author: IpcAuthor
    kind: QueryKind
    request_id: String
    issued_at: Timestamp
    -- 'pending' is set via IpcQuery.created(... status: pending). 'fulfilled' and 'timed_out' are
    -- set via let-binding assignments (let q = IpcQuery{request_id}; ensures: q.status = fulfilled).
    -- The checker traces neither .created() field values nor let-lookup assignments as status
    -- assignments. Lift these suppressions if the checker gains .created() and let-binding tracing.
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: pending | fulfilled | timed_out

    transitions status {
        pending -> fulfilled
        pending -> timed_out
        terminal: fulfilled
        terminal: timed_out
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    ipc_poll_interval: Integer = 1000      -- host polling cadence for IPC directories (milliseconds)
    query_timeout: Duration = 15.seconds   -- default timeout for transcript + memory queries
    eval_timeout: Duration = 180.seconds   -- timeout for skill_eval (longer: runs a full agent)
    file_path_prefix: String = "/workspace/ipc-out/"  -- send_file paths must be under this prefix (see container-ipc-transfer.allium)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Fire-and-Forget: Message and File Delivery ----

-- An agent sends a text message to a chat.
-- Non-main groups can only target their own chat.
-- The host delivers it through the appropriate channel adapter.
rule AgentSentMessage {
    when: AgentMcpCall(author, "send_message", chat_jid, text, sender?)

    requires: author.is_main or chat_jid = own_chat_jid(author)

    ensures: nanoclaw.Message.created(
        chat: Chat{jid: chat_jid},
        content: text,
        sent_at: now,
        is_from_me: true,
        is_bot_response: true
    )

    @guidance
        -- The optional sender param gives the message a named bot identity in the channel
        -- (e.g. "Researcher" appears as a dedicated Telegram bot). When omitted the default
        -- NanoClaw bot identity is used.
}

-- An agent sends a file to a chat.
-- The file must be staged under /workspace/ipc-out/ (the per-invocation outbound staging
-- area) before calling this tool. Path traversal is rejected by the container MCP server
-- at write time; the host then takes ownership of the file via the transfer mechanism.
-- See container-ipc-transfer.allium for the full staging, ownership, and lifecycle model.
rule AgentSentFile {
    when: AgentMcpCall(author, "send_file", chat_jid, file_path, invocation_id, caption?)

    requires: author.is_main or chat_jid = own_chat_jid(author)

    ensures: FileSent(chat: Chat{jid: chat_jid}, path: file_path, caption: caption)

    @guidance
        -- file_path must be an absolute path under /workspace/ipc-out/ (config.ipc_out_container_path
        -- in container-ipc-transfer.allium). Path traversal (containing "..") is rejected
        -- by the container MCP server before the IPC file is written.
        --
        -- invocation_id identifies the current container run so the host can resolve the
        -- staged file to its host-side path via the ContainerTransfer record. After delivery
        -- the TransferFile status is set to expired. See container-ipc-transfer.allium:
        -- IpcOutMount, ContainerTransfer, and TransferFile for the full ownership model.
}

-- An agent sets a reaction emoji on the last incoming message in a chat.
-- Non-main groups can only react to their own chat.
-- Channels that do not support reactions silently no-op.
rule AgentSetReaction {
    when: AgentMcpCall(author, "set_reaction", emoji, target_jid?)

    let jid = target_jid ?? own_chat_jid(author)

    requires: author.is_main or jid = own_chat_jid(author)

    ensures: ReactionSet(chat: Chat{jid: jid}, emoji: emoji)

    @guidance
        -- The reaction is applied to the last incoming message tracked by the channel
        -- adapter for that JID. Channels that do not implement setReaction silently
        -- no-op. The agent can use this to acknowledge requests, signal progress, or
        -- express outcomes without sending a full text message.
}

-- ---- Agent Lifecycle Reactions ----
-- These reactions are set by the host and container runtime, not by the agent.
-- They appear on the last incoming message and reflect processing state.
--
--   👀  Receipt:    set by the channel adapter when a message arrives from a registered chat.
--   💭  Processing: set via setTyping(true) when the container starts processing,
--                   and also restored after Claude SDK context compaction completes.
--   ⏳  Compacting: set by the container runtime pre-compaction hook.
--   ✅  Complete:   set via setTyping(false) when the agent turn succeeds.

-- ---- Group Name Synchronisation ----
-- Chat names are stored in the chats table by each channel adapter at connect time and
-- when messages arrive. Because users can rename chats at any time, the web UI triggers
-- a platform sync (syncGroups) immediately before serving GET /api/groups so that the
-- groups page always reflects current names. This is a web UI concern, not an IPC
-- concern — there is no agent-facing command for triggering a group name refresh.

-- ---- Fire-and-Forget: Task Commands ----
-- These rules share the same authorization model: non-main groups may only target tasks
-- that belong to their own group. Authorisation is re-checked on the host from the
-- source-group identity (the IPC directory name), not from any field inside the file.

-- An agent creates a new scheduled task.
-- Non-main groups may only schedule tasks targeting their own chat.
-- The schedule is validated before the IPC file is written (cron, interval, once).
-- The dispatchDepth is incremented from the current container's depth to prevent loops.
rule AgentScheduledTask {
    when: AgentMcpCall(author, "schedule_task", task_id, target_jid, prompt?, schedule, context_mode, script?, task_type?, min_idle_minutes?)

    requires: author.is_main or target_jid = own_chat_jid(author)
    requires: valid_schedule(schedule)
    requires: task_type = session_reset or task_type = user_profile or prompt != null

    ensures: scheduling.TaskCreated(
        group: Group{folder: author.group_folder},
        target_chat: Chat{jid: target_jid},
        prompt: prompt,
        schedule: schedule,
        context_mode: context_mode,
        dispatch_depth: author.dispatch_depth + 1,
        task_type: task_type,
        min_idle_minutes: min_idle_minutes
    )

    @guidance
        -- task_type selects the task execution mode (default: prompt):
        --
        --   prompt         — Runs the given prompt in an isolated or group-context
        --                    container when the schedule fires. prompt is required.
        --
        --   session_reset  — Archives and clears the target group's conversation session
        --                    without spawning a container. prompt is not required.
        --                    min_idle_minutes (default 60) sets the minimum idle threshold:
        --                    if the group has been active more recently than that window,
        --                    the reset is skipped for this cycle and retried on the next
        --                    scheduled occurrence.
        --
        --   user_profile   — Synthesises the group's memory/USER.md by running an
        --                    isolated container with a dedicated profile-synthesis
        --                    prompt. prompt is not required (supplied by the host).
        --
        -- dispatch_depth: the +1 increment is applied by the container at schedule time,
        -- not by the host at run time. The scheduling container reads its own depth from
        -- NANOCLAW_DISPATCH_DEPTH (= D) and writes dispatchDepth: D + 1 into the IPC
        -- payload. The host stores that value in the task record as-is. When the task
        -- fires, the task-scheduler passes task.dispatch_depth flat (no second +1) to
        -- runContainerAgent, so the sub-group container starts at NANOCLAW_DISPATCH_DEPTH
        -- = D + 1. This matches the ensures clause above (author.dispatch_depth + 1).
        -- If the D7 open question (host-authoritative depth via invocationId map) is
        -- resolved, the +1 would move to the host side at the same time.
}

-- When the main group agent creates a task for a *different* group, it is a delegation.
-- This emits AgentDelegatedTask so orchestration.allium can open an OrchestrationCycle.
-- Fires in addition to AgentScheduledTask (same trigger, different requires).
rule DelegationObserved {
    -- prompt?, task_type?, min_idle_minutes? are present only to align the parameter
    -- signature with AgentScheduledTask (both rules bind the same trigger). This rule
    -- does not use them — its requires clauses fully constrain when it fires.
    when: AgentMcpCall(author, "schedule_task", task_id, target_jid, prompt?, schedule, context_mode, script?, task_type?, min_idle_minutes?)

    let sub_group = nanoclaw.Group{chat: nanoclaw.Chat{jid: target_jid}}

    requires: author.is_main
    requires: target_jid != own_chat_jid(author)
    requires: exists sub_group
    requires: valid_schedule(schedule)

    ensures: AgentDelegatedTask(
        delegating_group_folder: author.group_folder,
        sub_group: sub_group,
        task_id: task_id,
        parent_depth: author.dispatch_depth
    )
}

-- An agent pauses a scheduled task.
rule AgentPausedTask {
    when: AgentMcpCall(author, "pause_task", task_id)

    let task = scheduling.ScheduledTask{id: task_id}

    requires: exists task
    requires: author.is_main or task.group.folder = author.group_folder

    ensures: scheduling.TaskPaused(requesting_group: Group{folder: author.group_folder}, task: task)
}

-- An agent resumes a paused task.
rule AgentResumedTask {
    when: AgentMcpCall(author, "resume_task", task_id)

    let task = scheduling.ScheduledTask{id: task_id}

    requires: exists task
    requires: author.is_main or task.group.folder = author.group_folder

    ensures: scheduling.TaskResumed(requesting_group: Group{folder: author.group_folder}, task: task)
}

-- An agent cancels a task.
rule AgentCancelledTask {
    when: AgentMcpCall(author, "cancel_task", task_id)

    let task = scheduling.ScheduledTask{id: task_id}

    requires: exists task
    requires: author.is_main or task.group.folder = author.group_folder

    ensures: scheduling.TaskCancelled(requesting_group: Group{folder: author.group_folder}, task: task)
}

-- An agent updates an existing task's prompt or schedule.
-- Only provided fields are changed; omitted fields stay the same.
rule AgentUpdatedTask {
    when: AgentMcpCall(author, "update_task", task_id, new_prompt?, new_schedule?)

    let task = scheduling.ScheduledTask{id: task_id}

    requires: exists task
    requires: author.is_main or task.group.folder = author.group_folder
    requires: new_schedule = null or valid_schedule(new_schedule)

    ensures: scheduling.TaskUpdated(
        requesting_group: Group{folder: author.group_folder},
        task: task,
        new_prompt: new_prompt ?? task.prompt,
        new_schedule: new_schedule ?? task.schedule
    )
}

-- An agent subscribes an RSS feed.
-- Non-main groups always subscribe for their own chat (target is implicit).
-- Main groups may subscribe for any registered group's chat via target_group_jid.
rule AgentSubscribedFeed {
    when: AgentMcpCall(author, "subscribe_rss", feed_id, feed_url, feed_schedule_type, feed_schedule_value, feed_interest?, target_jid?)

    let target = target_jid ?? own_chat_jid(author)

    requires: author.is_main or target = own_chat_jid(author)
    requires: valid_schedule(feed_schedule_type, feed_schedule_value)

    ensures: scheduling.FeedSubscribed(
        group: Group{folder: author.group_folder},
        feed_id: feed_id,
        feed_url: feed_url,
        feed_schedule_type: feed_schedule_type,
        feed_schedule_value: feed_schedule_value,
        feed_interest: feed_interest
    )

    @guidance
        -- feed_id is generated by the container MCP server before writing the IPC
        -- file. Unlike scheduled tasks (where the host generates a fallback id when
        -- the agent omits one), the host treats feed_id as required here: if the
        -- field is missing the subscribe_rss request is rejected outright.
        --
        -- feed_schedule_type and feed_schedule_value follow the same split
        -- representation used by scheduled tasks: type is one of cron, interval,
        -- or once, and value carries the cron expression, interval duration, or
        -- one-shot timestamp respectively.
        --
        -- feed_interest is an optional natural-language description of what the
        -- agent cares about in the feed. It is stored alongside the subscription
        -- and used to filter items at fetch time so the agent is only notified
        -- about entries matching the stated interest.
}

-- An agent permanently cancels an RSS feed subscription, retaining the record as a tombstone.
rule AgentUnsubscribedFeed {
    when: AgentMcpCall(author, "unsubscribe_rss", feed_id)

    let feed = scheduling.RssFeed{id: feed_id}

    requires: exists feed
    requires: author.is_main or feed.group.folder = author.group_folder

    ensures: scheduling.FeedCancelled(
        group: Group{folder: author.group_folder},
        feed: feed
    )
}

-- An agent temporarily pauses an RSS feed.
rule AgentPausedFeed {
    when: AgentMcpCall(author, "pause_rss", feed_id)

    let feed = scheduling.RssFeed{id: feed_id}

    requires: exists feed
    requires: author.is_main or feed.group.folder = author.group_folder

    ensures: scheduling.FeedPaused(
        requesting_group: Group{folder: author.group_folder},
        feed: feed
    )
}

-- An agent resumes a paused RSS feed, recomputing its next check from now.
rule AgentResumedFeed {
    when: AgentMcpCall(author, "resume_rss", feed_id)

    let feed = scheduling.RssFeed{id: feed_id}

    requires: exists feed
    requires: author.is_main or feed.group.folder = author.group_folder

    ensures: scheduling.FeedResumed(
        requesting_group: Group{folder: author.group_folder},
        feed: feed
    )
}

-- ---- Fire-and-Forget: Main-Group-Only Commands ----

-- Only the main group agent may register a new group.
-- is_main cannot be set via IPC — if the group is already registered as main,
-- that flag is preserved; if not, the new registration has is_main = false.
rule AgentRegisteredGroup {
    when: AgentMcpCall(author, "register_group", jid, name, folder, trigger, requires_trigger?)

    requires: author.is_main

    ensures: nanoclaw.GroupRegistered(
        chat: Chat{jid: jid},
        folder: folder,
        trigger_pattern: trigger,
        is_main: false,   -- IPC can never elevate a group to main
        requires_trigger: requires_trigger ?? true
    )

    @guidance
        -- The folder name must match the channel prefix convention: "{channel}_{group-name}"
        -- (e.g. "whatsapp_family-chat"). The host validates the folder name is filesystem-safe.
        -- requires_trigger is taken from the IPC payload when provided and defaults to true
        -- when the caller omits it, matching the host's behaviour in src/ipc.ts.
        -- If the group was already registered, its is_main flag is preserved (not overwritten).
}

-- Only the main group agent may change another group's trusted status.
rule AgentSetGroupTrusted {
    when: AgentMcpCall(author, "set_group_trusted", jid, trusted)

    requires: author.is_main

    ensures: nanoclaw.Group{chat: Chat{jid: jid}}.is_trusted = trusted
}

-- Only the main group agent may start a Claude Code remote control session.
-- The host responds in chat with the session URL.
rule AgentStartedRemoteControl {
    when: AgentMcpCall(author, "start_remote_control")

    requires: author.is_main

    ensures: RemoteControlStarted(chat: Chat{jid: own_chat_jid(author)})
}

-- Only the main group agent may stop the active remote control session.
rule AgentStoppedRemoteControl {
    when: AgentMcpCall(author, "stop_remote_control")

    requires: author.is_main

    ensures: RemoteControlStopped()
}

-- ---- Agent-to-Agent: deliver_result ----

-- A sub-group agent delivers a result to the main group agent.
-- This injects a synthetic message into the main group's chat, which triggers
-- the main agent as if it received an inbound message from the sub-group.
-- The dispatch depth is checked to prevent infinite orchestrator↔sub-agent loops.
-- Each container run may call deliver_result at most once (enforced in the container).
rule SubGroupDeliveredResult {
    when: AgentMcpCall(author, "deliver_result", text)

    requires: not author.is_main
    requires: author.dispatch_depth < nanoclaw.config.max_dispatch_depth

    let main_group = nanoclaw.Groups where is_main = true .first

    requires: exists main_group

    ensures: nanoclaw.Message.created(
        chat: main_group.chat,
        sender_name: author.group_folder,
        content: text,
        sent_at: now,
        is_from_me: false,
        is_bot_response: false
    )
    ensures: SubGroupResultInjected(
        main_group: main_group,
        sub_group_folder: author.group_folder,
        sub_group_depth: author.dispatch_depth,
        result_text: text
    )

    @guidance
        -- The injected message is attributed to the sub-group folder name so the main
        -- agent knows which sub-agent produced the result.
        -- SubGroupResultInjected is handled by nanoclaw.PendingDepthSet, which records
        -- main_group.pending_dispatch_depth = author.dispatch_depth + 1 so the next
        -- AgentInvoked run for the main group carries the correct depth.
        -- The one-call guard (deliverResultUsed) is enforced in the container MCP server,
        -- not re-enforced on the host.
}

-- ---- Session Archiving IPC ----
--
-- Two IPC task types relate to session archiving. They are different in kind:
--
--   spawn_throwaway_session — written by the container's PostCompact hook;
--     a genuine container→host IPC command modelled below.
--
--   request_session_archive — written by the HOST itself (session-commands.ts
--     on /reset, task-scheduler.ts on session_reset task). It is an internal
--     host routing mechanism: the host writes a task file to its own IPC
--     directory so the polling loop picks it up asynchronously. This is below
--     the spec boundary (no container is involved) and is not modelled as an
--     IPC rule. The session-archiving.allium rules ArchiveAndStartThrowawayOnReset
--     and ScheduledResetBridged describe the intent; their guidance notes the
--     IPC file as an implementation detail.

-- A container's PostCompact hook requests a throwaway summarisation session.
-- This is the IPC bridge between the PostCompact hook and
-- session-archiving.StartThrowawayOnPostCompact.
-- The hook writes the file to /workspace/ipc/tasks/; the host calls spawnThrowaway()
-- which runs an isolated container to produce the SessionSummary.
rule ContainerRequestedThrowaway {
    when: AgentIpcTask(author, "spawn_throwaway_session", session_id, jsonl_path)

    requires: not author.is_main

    let group = nanoclaw.Group{folder: author.group_folder}

    requires: exists group

    ensures: session_archiving.ThrowawaySession.created(
        for_session_id: session_id,
        group: group,
        source_jsonl: jsonl_path,
        status: queued,
        started_at: now
    )

    @guidance
        -- The PostCompact hook fires inside the running agent container after Claude Code
        -- compacts its context. It writes the spawn_throwaway_session file synchronously
        -- before the hook returns, then continues normally. The host processes the file
        -- on the next IPC poll and spawns the throwaway container fire-and-forget.
        -- The throwaway container has isThrowaway = true, which prevents its own
        -- PostCompact/PreCompact hooks from spawning further throwaways.
        -- Fields: jid (chatJid), sessionId, jsonlPath, groupFolder.
        -- jsonlPath may be null if the transcript was not available at hook time;
        -- spawnThrowaway handles the missing-JSONL case by writing placeholder files.
}

-- ---- Specialist Tools ----
-- These tools are available in specialist containers, whose per-task IPC directories
-- (DATA_DIR/ipc/spec-{task-id}/) sit as siblings of group IPC directories and are scanned
-- by the same polling loop. Authorization is determined by which IPC directory the file
-- appeared in: the host recognises the "spec-" prefix and resolves the task from the
-- directory name, not from payload contents.
-- This follows the same trust model as regular IPC (see IpcAuthor / SpecialistIpcAuthor).
--
-- Trust model for payload taskId fields:
-- Commands such as deliver_specialist_result, query_memory_specialist,
-- report_specialist_session, and submit_raw_memory carry a taskId in the JSON payload.
-- The host does NOT re-verify that the payload taskId matches the directory-derived task.
-- This is intentional: structural isolation is already enforced at the mount layer.
-- Each specialist container has only its own spec-{task-id} subdirectory mounted into
-- the container; it cannot write files into a sibling spec-{other-task-id} directory.
-- The payload taskId is therefore inherently constrained to the task that owns the
-- directory, making a cross-task forgery impossible without a full VM compromise.

-- The main group agent dispatches a task to a specialist type.
-- This is the IPC bridge for specialists.MainDispatchesSpecialistTask.
-- The main group's regular IPC directory is used (not a specialist IPC directory),
-- since the caller is the main group agent, not a specialist.
rule AgentDispatchedSpecialist {
    when: AgentMcpCall(author, "dispatch_specialist_task", specialist_type_name, prompt)

    requires: author.is_main

    let specialist_type = specialists.SpecialistType{name: specialist_type_name}

    requires: exists specialist_type

    ensures: AgentDispatchesSpecialistTask(
        main_group: nanoclaw.Group{folder: author.group_folder},
        specialist_type: specialist_type,
        prompt: prompt
    )

    @guidance
        -- The wire tool name is "dispatch_specialist_task" (main-group only). It is
        -- fire-and-forget from the main group agent's perspective: it returns
        -- immediately with the assigned task_id. The specialist result is delivered back
        -- to the main group's session asynchronously once the specialist completes.
        -- Available only to the main group agent because specialist dispatch is an
        -- orchestration action; sub-groups cannot spawn specialists.
}

-- A running specialist dispatches a sub-task to another specialist type.
-- This is the IPC bridge for specialists.SpecialistDispatchesSubTask (and its rejection rules).
-- The specialist's container exits after this call; the sub-task runs in its own container,
-- and the specialist is re-invoked with the result.
rule SpecialistDispatchedSubTask {
    when: SpecialistMcpCall(spec_author, "dispatch_specialist", target_type_name, prompt)

    requires: spec_author.task.status = running

    let target_type = specialists.SpecialistType{name: target_type_name}
    let session_id = current_session_id(spec_author.task)

    requires: exists target_type

    ensures: SpecialistSubTaskRequested(
        parent_task: spec_author.task,
        target_type: target_type,
        prompt: prompt,
        session_id: session_id
    )

    @guidance
        -- The wire tool name is "dispatch_specialist" (specialist-only); main-group agents
        -- use "dispatch_specialist_task" instead (AgentDispatchedSpecialist).
        -- session_id is captured from the specialist's active Claude conversation so the
        -- specialist can resume its chain of thought when re-invoked after the sub-task
        -- completes. The container reads its current session id via readCurrentSessionId()
        -- and writes it into the IPC file payload; the host reads it directly from the
        -- payload (data.sessionId), it is not resolved from any host-side session state.
        -- The tool returns synchronously with success or a rejection error (cycle_detected,
        -- depth_exceeded, count_exceeded, same_type_limit_exceeded). On success, the
        -- specialist's container is expected to exit cleanly; no further output is expected.
        -- On rejection, the specialist remains running and may handle the error.
}

-- A running specialist submits raw information to the main group's memory store.
-- This is the IPC bridge for specialists.SpecialistSubmitsRawMemory.
-- Unlike dispatch_sub_task, this is synchronous: the specialist does not exit and
-- continues working after receiving the acknowledgement.
rule SpecialistSubmittedMemory {
    when: SpecialistMcpCall(spec_author, "submit_raw_memory", topic, content)

    requires: spec_author.task.status = running

    let staging_path = memory_staging_path(spec_author.task, topic)

    ensures: SpecialistMemorySubmission(
        task: spec_author.task,
        topic: topic,
        staging_path: staging_path
    )

    @guidance
        -- The wire tool name is "submit_raw_memory".
        -- The host writes content to the staging_path before returning the acknowledgement.
        -- staging_path is generated by the host from the task identity and topic label:
        -- groups/main/memory/staging/{date}-{specialist-type}-{sanitised-topic}.md
        -- The specialist may make multiple submissions during a single task; each produces
        -- an independent RawMemorySubmission in specialists.allium.
        -- The tool returns the staging_path on success or an error on infrastructure failure
        -- (disk full, bad mount, permissions). It does not wait for the main group to be
        -- notified — notification is dispatched asynchronously by the host.
}

-- A running specialist queries a memory-provider specialist.
-- This is the IPC bridge for specialists.SpecialistQueriesMemory.
-- Unlike dispatch_specialist, this bypasses delegation policy (cycle/depth/count
-- checks) because memory providers are read-only information sources. The target
-- must have isMemoryProvider = true; regular specialist types are rejected.
-- The sessionId is recorded so the memory provider's response can be injected
-- back into the querying specialist's Claude conversation when it resumes.
rule SpecialistQueriedMemory {
    when: SpecialistMcpCall(spec_author, "query_memory_specialist", target_type_name, prompt, session_id)

    requires: spec_author.task.status = running

    let target_type = specialists.SpecialistType{name: target_type_name}

    requires: exists target_type
    requires: target_type.is_memory_provider = true

    ensures: SpecialistMemoryQueryRequested(
        querying_task: spec_author.task,
        target_type: target_type,
        prompt: prompt,
        session_id: session_id
    )

    @guidance
        -- The wire tool name is "query_memory_specialist" (specialist-only).
        -- The host records the querying specialist's current session_id via reportSession
        -- before starting the memory-provider container, so the provider's reply can be
        -- delivered back into the querying specialist's conversation on resume.
        -- Delegation policy (cycle detection, depth limit, dispatch count, same-type
        -- limit) does not apply here: memory providers are treated as read-only lookups
        -- rather than delegated sub-tasks. Targets that are not flagged as memory
        -- providers are rejected with an error and the querying specialist remains running.
}

-- A running specialist reports its Claude conversation session id to the host.
-- This is the IPC bridge for specialists.SpecialistSessionEstablished.
-- Called by the specialist container as soon as its Claude session is established,
-- so the host can track the session id for continuity across specialist runs
-- (e.g. resuming after a sub-task or memory query completes).
rule SpecialistSessionReported {
    when: SpecialistMcpCall(spec_author, "report_specialist_session", session_id)

    ensures: SpecialistSessionRecorded(
        task: spec_author.task,
        session_id: session_id
    )

    @guidance
        -- The wire tool name is "report_specialist_session".
        -- The host upserts a SpecialistConversationSession row keyed by task_id:
        -- if no session exists it creates one with status = active; if one already
        -- exists it updates the session_id and sets status = active. This is how the
        -- host tracks session ids so a specialist can resume its chain of thought
        -- when re-invoked after a sub-task or memory query completes.
}

-- A running specialist delivers its final result.
-- This is the IPC bridge for specialists.SpecialistTaskCompleted.
--
-- Decision: deliver_specialist_result is a separate tool from deliver_result.
-- deliver_result (SubGroupDeliveredResult) injects a synthetic message into the main group's
-- chat — it is the sub-group-to-main-group result delivery for orchestration cycles.
-- Specialist result delivery has different semantics: it sets task.result, transitions the
-- task to completed, and routes to either the main group or a parent specialist depending
-- on task.requester_group / task.requester_task. The authorization model also differs:
-- specialists run under the null channel group with per-task IPC directories, not regular
-- group IPC directories. A parallel tool keeps the two delivery mechanisms cleanly separated.
rule SpecialistDeliveredResultViaIpc {
    when: SpecialistMcpCall(
        spec_author,
        "deliver_specialist_result",
        result_text,
        file_paths: List<String>?,
        commit_to_memory: Boolean?
    )

    requires: spec_author.task.status = running

    ensures: SpecialistDeliveredResult(
        task: spec_author.task,
        result_text: result_text,
        file_paths: resolve_delivery_paths(spec_author.task, file_paths, commit_to_memory)
    )

    @guidance
        -- The tool is fire-and-forget: the specialist's container exits after this call.
        -- The host records the result on the task entity and routes it to the requester
        -- (main group or parent specialist) as defined by specialists.SpecialistTaskCompleted.
        -- Each specialist container may call deliver_specialist_result at most once,
        -- enforced in the container MCP server (in-memory flag, same pattern as deliver_result).
        --
        -- commit_to_memory flag:
        -- When commit_to_memory = true and file_paths is non-empty, the host copies the listed
        -- files from the specialist's ipc-out directory into the main group's memory/reports/
        -- directory before routing the result. commit_files_to_memory returns the committed
        -- paths (relative to the main group workspace, e.g. "memory/reports/2026-04-08-slug.md").
        -- The result message delivered to the requester references these committed paths
        -- instead of the original ipc-out paths, so the requester can read them directly.
        -- When commit_to_memory = true but file_paths is null or empty, the flag is silently
        -- ignored and the result is delivered as plain text.
        -- When commit_to_memory is false or absent, file_paths are placed under
        -- /workspace/ipc-in/{transfer_id}/ in the requester's container as usual.
}

-- ---- Request-Response Queries ----
-- These use a requestId written in the task file. The host writes a response file
-- at /workspace/ipc/responses/{requestId}.json; the agent polls until it appears
-- or the timeout elapses.

-- Common lifecycle for all query types:
--   1. Agent issues the query (IpcQuery created, status = pending)
--   2. Host processes it and writes the response file (status → fulfilled)
--   3. Agent reads and deletes the response file
--   4. If the host does not respond in time, the agent gives up (status → timed_out)

rule AgentQueriedTranscript {
    when: AgentMcpCall(author, "query_transcript", request_id, chat_jid, params)

    requires: author.is_main or chat_jid = own_chat_jid(author)

    ensures: IpcQuery.created(
        author: author,
        kind: transcript,
        request_id: request_id,
        issued_at: now,
        status: pending
    )
    ensures: TranscriptQueryIssued(author: author, request_id: request_id, chat_jid: chat_jid, params: params)

    @guidance
        -- params includes: from?, to?, limit (1–200, default 50), after_cursor?, include_bot_messages?
        -- The host returns paginated results with has_more and next_cursor.
        -- Non-main groups may only query their own chat's transcript.
}

rule HostFulfilledTranscriptQuery {
    when: TranscriptQueryIssued(author, request_id, chat_jid, params)

    let q = IpcQuery{request_id: request_id}

    requires: exists q
    requires: q.status = pending

    ensures: q.status = fulfilled
    ensures: ResponseFileWritten(request_id: request_id, payload: query_transcript(chat_jid, params))
}

rule AgentQueriedMemorySearch {
    when: AgentMcpCall(author, "memory_search", request_id, query, search_params)

    ensures: IpcQuery.created(
        author: author,
        kind: memory_search,
        request_id: request_id,
        issued_at: now,
        status: pending
    )
    ensures: MemorySearchQueryIssued(author: author, request_id: request_id, query: query, search_params: search_params)
}

rule HostFulfilledMemorySearchQuery {
    when: MemorySearchQueryIssued(author, request_id, query, search_params)

    let q = IpcQuery{request_id: request_id}

    requires: exists q
    requires: q.status = pending

    ensures: q.status = fulfilled
    ensures: ResponseFileWritten(
        request_id: request_id,
        payload: memory.hybrid_search(author.group_folder, query, search_params)
    )

    @guidance
        -- If memory search is not enabled (MEMORY_SEARCH_ENABLED = false) or the group
        -- has no memory manager, the response payload is { error: "Memory search not available" }.
        -- search_params may include: limit?, min_score?, path_prefix?, source?, include_content?
        --
        -- Specialist containers: memory_search, memory_get, and memory_list are not registered
        -- in the specialist container MCP server (gated by isSpecialist at startup). Specialists
        -- that need memory access must use the query_memory tool, which routes through a
        -- memory-provider specialist type. This is intentional: direct memory access is scoped
        -- to regular group agents; specialists go through a controlled, auditable provider.
}

rule AgentQueriedMemoryGet {
    when: AgentMcpCall(author, "memory_get", request_id, path, parse_frontmatter?)

    ensures: IpcQuery.created(
        author: author,
        kind: memory_get,
        request_id: request_id,
        issued_at: now,
        status: pending
    )
    ensures: MemoryGetQueryIssued(author: author, request_id: request_id, path: path, parse_frontmatter: parse_frontmatter ?? true)
}

rule HostFulfilledMemoryGetQuery {
    when: MemoryGetQueryIssued(author, request_id, path, parse_frontmatter)

    let q = IpcQuery{request_id: request_id}

    requires: exists q
    requires: q.status = pending

    ensures: q.status = fulfilled
    ensures: ResponseFileWritten(
        request_id: request_id,
        payload: memory.get_file_content(author.group_folder, path, parse_frontmatter)
    )
}

rule AgentQueriedMemoryList {
    when: AgentMcpCall(author, "memory_list", request_id, list_params)

    ensures: IpcQuery.created(
        author: author,
        kind: memory_list,
        request_id: request_id,
        issued_at: now,
        status: pending
    )
    ensures: MemoryListQueryIssued(author: author, request_id: request_id, list_params: list_params)

    @guidance
        -- list_params: path_prefix?, source?, limit?, order_by (mtime|path|size)?, parse_frontmatter?
        -- parse_frontmatter is expensive; enforces limit ≤ 50 when true.
}

rule HostFulfilledMemoryListQuery {
    when: MemoryListQueryIssued(author, request_id, list_params)

    let q = IpcQuery{request_id: request_id}

    requires: exists q
    requires: q.status = pending

    ensures: q.status = fulfilled
    ensures: ResponseFileWritten(
        request_id: request_id,
        payload: memory.list_files(author.group_folder, list_params)
    )
}

-- skill_eval runs a full agent container and grades assertions — main group only.
-- The host processes the request asynchronously (fire-and-forget on the host side)
-- and writes the result file when done. The agent waits up to eval_timeout.
rule AgentQueriedSkillEval {
    when: AgentMcpCall(author, "skill_eval", request_id, skill_name, case_id, prompt, with_skill, assertions?)

    requires: author.is_main

    ensures: IpcQuery.created(
        author: author,
        kind: skill_eval,
        request_id: request_id,
        issued_at: now,
        status: pending
    )
    ensures: EvalQueryIssued(
        author: author,
        request_id: request_id,
        skill_name: skill_name,
        case_id: case_id,
        prompt: prompt,
        with_skill: with_skill,
        assertions: assertions ?? {}
    )

    @guidance
        -- MCP tool name: skill_eval. IPC task file type: run_skill_eval.
        -- The host picks up the run_skill_eval task file and processes it fire-and-forget:
        -- it snapshots the main group workspace for isolation, runs a fresh container agent
        -- with the given prompt (optionally excluding the named skill), grades the assertions
        -- using an LLM grader, and writes the response file when done.
        -- The response payload includes: status, passed, assertionResults, output, durationMs, totalTokens.
}

-- A query times out if the host has not written a response file within the timeout window.
-- NOTE: this rule describes the intended logical behaviour, not a host-enforced transition.
-- Timeouts are currently enforced container-side only: the container MCP server polls for
-- the response file with a per-kind deadline (15s for most queries, 180s for skill_eval
-- which spawns a full agent container)
-- and returns an error to the agent when it expires. The host has no timeout poller.
-- See the IpcQuery entity note above for the full set of failure modes this implies.
rule IpcQueryTimedOut {
    when: q: IpcQuery.issued_at + query_timeout_for(q.kind) <= now

    requires: q.status = pending

    ensures: q.status = timed_out
}

-- ---- Read-Only Snapshot Files ----
-- The host writes a set of JSON snapshot files into /workspace/ipc/ before the
-- agent starts. Agents read these directly from disk (no IPC round-trip needed).

-- @guidance
--   Snapshot files written by the host into the mounted IPC volume:
--
--   current_tasks.json   — array of all active/paused ScheduledTask records visible to this group.
--                          Used by list_tasks (main: all tasks; non-main: own group only).
--
--   rss_feeds.json       — array of all RssFeed records visible to this group.
--                          Used by list_rss_feeds (main: all feeds; non-main: own group only).
--
--   available_groups.json — array of all registered groups with name, folder, JID.
--                           Used by register_group to find a target JID.
--                           Main group only; non-main groups do not receive this file.
--
--   nanoclaw_meta.json   — host metadata: { webUiBaseUrl? }.
--                          Used by get_file_url to build dashboard links.
--
--   For specialist containers (per-task IPC directory):
--   specialist_context.json — { task_id, specialist_type, depth, ancestor_types,
--                               prompt, is_last_same_type_dispatch, session_id? }.
--                              Written by the host before the container starts.
--                              The specialist reads this to understand its context.

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Non-main groups may only send messages or files to their own chat.
invariant NonMainGroupTargetsOwnChat {
    for q in IpcQueries:
        not q.author.is_main implies q.kind != skill_eval
}

-- Only sub-groups (non-main) may call deliver_result.
invariant DeliverResultSubGroupOnly {
    -- Encoded in rule SubGroupDeliveredResult: requires not author.is_main.
    -- Restated here to make the constraint explicit as an invariant.
    for m in nanoclaw.Messages where sender_name != null:
        -- If the sender_name is a group folder (i.e. came from deliver_result),
        -- the target chat must be the main group's chat.
        is_deliver_result_message(m) implies is_main_group_chat(m.chat)
}

-- Specialist dispatch is restricted to the main group.
invariant SpecialistDispatchMainGroupOnly {
    -- Encoded in rule AgentDispatchedSpecialist: requires author.is_main.
    -- Restated here for symmetry with SkillEvalMainGroupOnly.
    for q in AgentDispatchesSpecialistTasks:
        q.main_group.is_main
}

-- skill_eval is restricted to the main group.
invariant SkillEvalMainGroupOnly {
    for q in IpcQueries:
        q.kind = skill_eval implies q.author.is_main
}

-- A query's dispatch depth never exceeds the system limit.
invariant QueryDispatchDepthBounded {
    for q in IpcQueries:
        current_dispatch_depth(q.author) < nanoclaw.config.max_dispatch_depth
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "list_tasks / list_rss_feeds read snapshot files directly from disk — should these be modelled as reads against current spec state instead, or is the snapshot-file pattern a domain concept worth preserving?"
open question "dispatch_depth trust model mismatch: sub-group IPC reads depth from the IPC payload (container-supplied, trusts the container), while specialist IPC derives depth from the host DB (parentTask.depth + 1, no payload field). Align by: recording invocationId→depth when starting containers, adding invocationId to deliver_result and schedule_task payloads, and replacing data.dispatchDepth reads in ipc.ts with host-side map lookups. Requires a container rebuild."
open question "deliver_result one-call guard is enforced in the container process (in-memory flag) — should this be an entity-level constraint in the spec, or is the container-process boundary sufficient?"
open question "Brave Search and search_zotero are conditionally available — should their availability conditions (BRAVE_API_KEY present, /workspace/group/zotero-md exists) be modelled as config flags?"
