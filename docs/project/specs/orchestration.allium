-- allium: 3
-- orchestration.allium
--
-- Agent orchestration: the lifecycle of a main-group agent delegating work to a
-- sub-group agent (a registered channel group) and receiving the result back.
--
-- This covers group-to-group delegation only. Specialist-to-specialist delegation
-- (ephemeral task containers dispatched by the main group or by other specialists)
-- is a parallel model defined in specialists.allium and does not create OrchestrationCycles.
--
-- Migration note: specialists.allium is the intended long-term delegation model.
-- Sub-group delegation (this spec) is expected to be superseded by specialists once
-- the specialist model is fully implemented. The two models coexist during the
-- transition. New delegation use cases should prefer specialists.
--
-- Scope: OrchestrationCycle tracking, delegation rules, result delivery, depth enforcement
-- Includes: cycle creation, result delivery, timeout
-- Excludes:
--   - Task scheduling mechanics (see scheduling.allium)
--   - IPC/MCP wire protocol (see ipc.allium)
--   - Core agent session lifecycle (see nanoclaw.allium)
--   - Specialist task orchestration (see specialists.allium)

use "./nanoclaw.allium" as nanoclaw
use "./scheduling.allium" as scheduling
use "./ipc.allium" as ipc

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- One active delegation round-trip: main group assigns work to a sub-group and
-- awaits a deliver_result call back.
--
-- Implementation note: OrchestrationCycle is tracked in memory only (not persisted to DB).
-- The host holds a pendingCycles map keyed by sub-group folder, storing task_id and
-- delegated_at. There is no status field — a cycle either exists (open) or does not
-- (closed). Closed cycles are removed from the map immediately; no history is retained.
-- A host restart clears all in-flight cycles; they are not recovered.
--
-- This simplified model is intentional for a transitional feature. Richer lifecycle
-- tracking (status transitions, result storage, closed_at) is not implemented and not
-- planned before the specialist model supersedes sub-group delegation entirely.
entity OrchestrationCycle {
    sub_group: nanoclaw.Group           -- the group executing the delegated task
    task_id: String                     -- ID of the delegated ScheduledTask
    delegated_at: Timestamp

    -- Derived
    is_overdue: now - delegated_at > config.cycle_timeout
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    cycle_timeout: Duration = 30.minutes  -- open cycles older than this are abandoned (CYCLE_TIMEOUT env var)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Cycle Opening ----

-- The main group agent creates a task for a sub-group.
-- ipc.DelegationObserved emits AgentDelegatedTask for each such task creation.
rule CycleCreated {
    when: AgentDelegatedTask(delegating_group_folder, sub_group, task_id, parent_depth)

    let delegating_group = nanoclaw.Group{folder: delegating_group_folder}

    requires: exists delegating_group
    requires: delegating_group.is_main
    requires: sub_group != delegating_group
    requires: parent_depth + 1 < nanoclaw.config.max_dispatch_depth

    ensures: OrchestrationCycle.created(
        sub_group: sub_group,
        task_id: task_id,
        delegated_at: now
    )
}

-- ---- Cycle Closing ----

-- The sub-group calls deliver_result; the result text is injected into the main
-- group's message queue and the cycle is closed.
rule CycleReturned {
    when: ipc.SubGroupResultInjected(main_group, sub_group_folder, sub_group_depth, result_text)

    let sub_group = nanoclaw.Group{folder: sub_group_folder}
    let cycle = OrchestrationCycle{sub_group: sub_group}

    requires: exists sub_group
    requires: exists cycle

    ensures: not exists cycle
}

-- A running cycle that has not produced a result within cycle_timeout is abandoned.
-- The host injects a timeout notice into the main group's message queue.
rule CycleTimedOut {
    when: cycle: OrchestrationCycle.is_overdue

    ensures: not exists cycle

    @guidance
        -- A cycle can time out if the sub-group container crashes, is killed, or
        -- simply takes longer than cycle_timeout to run. The main group receives a
        -- synthetic notice message rather than a deliver_result payload.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Delegation always flows from the registered main group.
invariant DelegationAlwaysFromMain {
    for c in OrchestrationCycles:
        -- c.sub_group != main is enforced at creation (CycleCreated requires sub_group != delegating_group)
        c.sub_group.is_main = false
}

-- At most one open cycle per sub-group at a time.
invariant OneOpenCyclePerSubGroup {
    for g in nanoclaw.Groups:
        OrchestrationCycles where sub_group = g .count <= 1
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved: sub-group delegation. Sub-groups do not open OrchestrationCycles directly.
-- Specialist-to-specialist delegation is handled by specialists.allium as a separate
-- model (SpecialistTask chain) that does not extend OrchestrationCycle.

-- Resolved: chained delegation. The current model creates independent cycles per
-- delegation from main. A parent-child relationship between cycles is not needed;
-- the specialist chain model in specialists.allium covers the multi-hop case.

-- Resolved: CycleAbandonedNoDelivery. Sub-group agents that exit without calling
-- deliver_result are covered by CycleTimedOut. No separate abandonment rule is needed
-- because the in-memory model has no running/delegated distinction.
