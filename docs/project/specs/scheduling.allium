-- allium: 3
-- scheduling.allium
--
-- NanoClaw scheduled tasks and RSS monitoring.
-- Agents can create recurring or one-time tasks that invoke the agent on a schedule.
-- Groups can subscribe to RSS feeds whose new items are delivered by the agent.
--
-- Scope: task scheduling and RSS feed monitoring
-- Includes: scheduled tasks (cron/interval/once), RSS feeds, agent-initiated task management
-- Excludes:
--   - Core message routing (see nanoclaw.allium)
--   - Memory indexing (see memory.allium)

use "./nanoclaw.allium" as nanoclaw

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A schedule specification: either a cron expression, a repeat interval, or a one-time timestamp.
value Schedule {
    type: ScheduleType
    value: String                       -- cron expr ("0 9 * * 1-5"), interval ms, or ISO timestamp
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ScheduleType { cron | interval | once }

-- Whether a task uses the group's persisted conversation session or starts fresh each run.
enum ContextMode { isolated | group }

enum TaskStatus { active | paused | completed | cancelled }

-- Dispatches the task to a different execution path. "prompt" runs the agent
-- container with the task's prompt (the default, historical behaviour).
-- "session_reset" archives and clears the group's current session without
-- spawning an agent. "user_profile" generates memory/USER.md for the main group.
enum TaskType { prompt | session_reset | user_profile }

enum RssFeedStatus { active | paused | cancelled }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- A recurring or one-time agent invocation for a group, running on a schedule.
-- Tasks can be created by agents (via IPC) or through the web UI.
entity ScheduledTask {
    group: nanoclaw.Group
    target_chat: nanoclaw.Chat          -- where to deliver output
    task_type: TaskType                 -- dispatches to prompt / session_reset / user_profile paths (default: prompt)
    prompt: String                      -- instruction sent to the agent (ignored when script is set or task_type != prompt)
    script: String?                     -- optional alternative to prompt; when set, the agent runs this script instead
    schedule: Schedule
    context_mode: ContextMode
    status: TaskStatus
    next_run: Timestamp?                -- null when completed or cancelled
    last_run: Timestamp?
    last_result: String?
    dispatch_depth: Integer             -- nesting level; prevents agent-to-agent loops
    min_idle_minutes: Integer?          -- only for task_type = session_reset; skip run if chat activity within this window (default 60)
    created_at: Timestamp

    -- Derived
    is_due: status = active and next_run != null and next_run <= now

    transitions status {
        active -> paused
        paused -> active
        active -> completed
        paused -> completed
        active -> cancelled
        paused -> cancelled
        terminal: completed
        terminal: cancelled
    }
}

-- A subscribed RSS feed that delivers new items to a group's chat on a schedule.
entity RssFeed {
    group: nanoclaw.Group
    chat_jid: String                    -- JID of the chat to deliver to (denormalised from target group)
    url: String
    title: String?                      -- feed title, extracted on first successful fetch
    schedule: Schedule                  -- schedule.type must be cron or interval; once is not valid for feeds
    interest: String?                   -- optional focus prompt: "summarise posts about AI safety"
    status: RssFeedStatus
    next_check: Timestamp?              -- null when paused or cancelled
    seen_guids: Set<String>             -- GUIDs of already-seen items; capped at max_seen_guids (hardcoded 500)
    created_at: Timestamp

    transitions status {
        active -> paused
        paused -> active
        active -> cancelled
        paused -> cancelled
        terminal: cancelled
    }
}

-- No DeliveredFeedItem table. Delivery history is tracked only via seen_guids on RssFeed.
-- Individual delivery records are not persisted.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    poll_interval: Duration = 60.seconds  -- shared between task and RSS polling loops
    max_seen_guids: Integer = 500         -- cap on seen_guids per feed; hardcoded, not runtime-configurable
    max_items_per_prompt: Integer = 20    -- max new items batched into a single judgment prompt
    fetch_error_retry_delay: Duration = 15.minutes  -- next_check advance on fetch failure
    default_session_reset_min_idle: Integer = 60    -- default min_idle_minutes for session_reset tasks
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Task Lifecycle ----

-- A new scheduled task is created by an agent (via IPC) or through the web UI.
-- Non-main groups can only create tasks targeting their own chat.
rule TaskCreated {
    when: CreateTask(group, target_chat, task_type, prompt, script, schedule, context_mode, dispatch_depth, min_idle_minutes)

    requires: group.is_main or target_chat = group.chat
    requires: dispatch_depth < nanoclaw.config.max_dispatch_depth
    -- user_profile tasks always run against the main group
    requires: task_type = user_profile implies group.is_main

    let next_run = compute_next_run(schedule, now)

    ensures: ScheduledTask.created(
        group: group,
        target_chat: target_chat,
        task_type: task_type,
        prompt: prompt,
        script: script,
        schedule: schedule,
        context_mode: context_mode,
        status: active,
        next_run: next_run,
        dispatch_depth: dispatch_depth,
        min_idle_minutes: min_idle_minutes,
        created_at: now
    )
}

-- When a task becomes due, its next_run is advanced (and once-tasks marked
-- completed) *before* any work begins. This is the "claim" step: a crash or
-- process restart after this point will not re-fire the task. Post-run
-- rescheduling is deliberately absent — the schedule has already advanced.
--
-- After claiming, the task is dispatched to one of three execution paths
-- depending on task_type (see TaskPromptDispatched, TaskSessionResetDispatched,
-- TaskUserProfileDispatched below).
rule TaskClaimed {
    when: task: ScheduledTask.is_due

    requires: task.status = active

    let next_run = compute_next_run(task.schedule, now)

    ensures: task.last_run = now
    ensures: if task.schedule.type = once:
                 task.next_run = null
                 task.status = completed
             else:
                 task.next_run = next_run
    ensures: TaskClaimReady(task: task)

    @guidance
        -- Code reference: task-scheduler.ts startSchedulerLoop, which calls
        -- updateTaskAfterRun before enqueuing the container. Because the schedule
        -- advances synchronously with the due check, a duplicate poll or a
        -- restart mid-run will see the task as not yet due.
        -- One consequence: if the run itself fails, the task is not retried until
        -- its next scheduled occurrence. Transient failures fall through to the
        -- next tick rather than being retried on the spot.
}

-- Dispatch path: task_type = prompt. Runs the agent container with the task's
-- prompt (or script, when set). If context_mode = group, the group's existing
-- conversation session is reused; otherwise an isolated session is used.
rule TaskPromptDispatched {
    when: TaskClaimReady(task)

    requires: task.task_type = prompt
    -- Concurrency cap: the main group is always allowed to run and never consumes
    -- a slot; non-main groups must fit under nanoclaw.config.max_concurrent_agents.
    -- When the cap is reached, dispatch is skipped here and TaskQueued takes over.
    requires: task.group.is_main
              or nanoclaw.AgentSessions where status = active .count < nanoclaw.config.max_concurrent_agents

    ensures: TaskAgentStarted(
        task: task,
        conversation_session: if task.context_mode = group: task.group.session else: null,
        dispatch_depth: task.dispatch_depth
    )

    @guidance
        -- task.dispatch_depth is passed to the container as NANOCLAW_DISPATCH_DEPTH so
        -- the MCP server knows its depth in the orchestration chain.
        -- For tasks created via schedule_task from an agent, dispatch_depth = caller's depth + 1
        -- (set at creation time in ipc.allium: AgentScheduledTask).
        -- For tasks created via the web UI or directly, dispatch_depth = 0.
        -- When task.script is set, the agent runs the script instead of interpreting
        -- task.prompt as a natural-language instruction.
        -- Task agent containers have a shorter close delay (10 seconds after output)
        -- compared to message-triggered sessions (which idle for up to idle_timeout).
        --
        -- CONCURRENCY MODEL
        -- The main group bypasses max_concurrent_agents entirely: it must remain
        -- responsive and never consumes a concurrency slot. All other groups share
        -- the cap with message-driven AgentSessions (see nanoclaw.AgentInvoked).
        -- Per-JID serialisation (at most one container per group) is enforced
        -- separately by GroupQueue in code; see OneActiveContainerPerGroupJid.
}

-- Dispatch path: task_type = session_reset. Archives and clears the group's
-- current session without spawning an agent container. Skips the run if the
-- group's chat has been active within min_idle_minutes.
--
-- Note: the session archive itself is produced by the archiving spec — this
-- rule only triggers the reset; see session-archiving.allium for the subsequent
-- ConversationArchive / ThrowawaySession flow.
rule TaskSessionResetDispatched {
    when: TaskClaimReady(task)

    requires: task.task_type = session_reset

    let min_idle = task.min_idle_minutes ?? config.default_session_reset_min_idle
    let idle_minutes = minutes_since(chat_last_active(task.group.chat))

    ensures: if idle_minutes != null and idle_minutes < min_idle:
                 task.last_result = "Skipped: group active recently"
             else:
                 SessionResetRequested(group: task.group, chat: task.target_chat)

    @guidance
        -- Code reference: task-scheduler.ts runSessionReset. On skip, the task's
        -- next_run was already advanced by TaskClaimed, so the run is simply
        -- recorded and the next tick waits for the subsequent schedule slot.
        -- SessionResetRequested is handled by session-archiving.allium, which
        -- writes the IPC task file and clears the in-memory session. The reset
        -- path never spawns an agent container directly.
}

-- Dispatch path: task_type = user_profile. Spawns an isolated agent container
-- on the main group to regenerate memory/USER.md. The prompt is loaded from
-- the main group's prompts/ override if present (see session-warm-start.allium
-- ProfileFileUpdated), otherwise the built-in default prompt is used.
rule TaskUserProfileDispatched {
    when: TaskClaimReady(task)

    requires: task.task_type = user_profile
    requires: task.group.is_main
    -- user_profile tasks always run against the main group, which bypasses the
    -- concurrency cap. The guard is stated explicitly for symmetry with
    -- TaskPromptDispatched and to make the bypass auditable.

    ensures: UserProfileGenerationRequested(group: task.group, chat: task.target_chat)

    @guidance
        -- Code reference: task-scheduler.ts runUserProfileGeneration. The agent
        -- writes memory/USER.md directly; its completion is observed by the
        -- file watcher, which drives session-warm-start.ProfileFileUpdated.
        -- No chat output is produced — the result of the run is the updated
        -- profile file, not a delivered message.
}

-- A claimed prompt task that cannot dispatch immediately because the
-- concurrency cap is full. The task is held by enqueuing a WaitingGroup
-- entry for the group, recording that the group has held work awaiting a
-- slot. The group's per-JID GroupQueue separately tracks which kinds of
-- work are pending (tasks vs messages); when the slot frees, pending tasks
-- within the group are drained before pending messages. Only non-main
-- groups can queue: the main group bypasses the cap and never reaches
-- this rule.
--
-- TaskClaimed has already advanced next_run by this point, so the task will
-- not re-fire from the scheduler tick. The held work is carried on the
-- group's pending-task list inside GroupQueue until the slot frees.
rule TaskQueued {
    when: TaskClaimReady(task)

    requires: task.task_type = prompt
    requires: not task.group.is_main
    requires: nanoclaw.AgentSessions where status = active .count >= nanoclaw.config.max_concurrent_agents
    requires: not exists nanoclaw.WaitingGroup{group: task.group}

    ensures: nanoclaw.WaitingGroup.created(
        group: task.group,
        queued_at: now
    )

    @guidance
        -- Code reference: task-scheduler.ts dispatches via GroupQueue.enqueueTask,
        -- which serialises by JID. The GroupQueue maintains two per-group lists:
        -- pendingTasks and pendingMessages. When the global concurrency cap is
        -- reached, the scheduler appends to pendingTasks rather than launching a
        -- container, and creates (or leaves in place) a single WaitingGroup entry
        -- marking the group as having work awaiting a slot. The WaitingGroup
        -- entity itself does not distinguish tasks from messages; it only records
        -- "this group has held work". The task-vs-message distinction lives on
        -- the group's pending lists.
        --
        -- The next scheduler tick re-checks capacity; once a slot frees,
        -- AgentSlotFreed (in nanoclaw.allium) picks the next waiting group in
        -- FIFO order, and within that group the GroupQueue drain always empties
        -- pendingTasks before pendingMessages. This gives scheduled tasks
        -- priority over pending message dispatches within the same group.
        --
        -- session_reset and user_profile tasks never reach this rule:
        -- session_reset does not spawn a container at all, and user_profile only
        -- runs on the main group, which bypasses the cap.
}

-- ---- Task Management (agent-initiated via IPC) ----

-- Non-main groups can only manage tasks belonging to their own group.
rule TaskPaused {
    when: PauseTask(requesting_group, task)

    requires: requesting_group.is_main or task.group = requesting_group
    requires: task.status = active

    ensures: task.status = paused
}

rule TaskResumed {
    when: ResumeTask(requesting_group, task)

    requires: requesting_group.is_main or task.group = requesting_group
    requires: task.status = paused

    ensures: task.status = active
}

rule TaskCancelled {
    when: CancelTask(requesting_group, task)

    requires: requesting_group.is_main or task.group = requesting_group
    requires: task.status in { active, paused }

    ensures: task.status = cancelled
    ensures: task.next_run = null
    -- Task record and run history are retained as a tombstone.
    -- cancelled is terminal: resume_task is rejected for cancelled tasks.
}

rule TaskUpdated {
    when: UpdateTask(requesting_group, task, new_prompt, new_schedule)

    requires: requesting_group.is_main or task.group = requesting_group
    requires: task.status in { active, paused }

    let next_run = compute_next_run(new_schedule, now)

    ensures: task.prompt = new_prompt
    ensures: task.schedule = new_schedule
    ensures: task.next_run = next_run
}

-- ---- RSS Feed Lifecycle ----

-- Non-main groups can only subscribe feeds targeting their own chat.
-- Main groups may subscribe for any registered group via target_jid.
rule FeedSubscribed {
    when: SubscribeFeed(id, group, url, schedule, interest, target_jid?)

    let chat_jid = target_jid ?? group.chat.jid

    requires: group.is_main or chat_jid = group.chat.jid
    requires: valid_schedule(schedule)
    requires: schedule.type in { cron, interval }   -- once is not valid for feeds

    let next_check = compute_next_run(schedule, now)

    ensures: RssFeed.created(
        id: id,
        group: group,
        chat_jid: chat_jid,
        url: url,
        schedule: schedule,
        interest: interest,
        next_check: next_check,
        seen_guids: {},
        created_at: now
    )
}

-- When a feed is due for checking, its URL is fetched and new items are identified.
-- All new items are batched into a single agent invocation (up to max_items_per_prompt).
-- On fetch error, next_check is advanced by fetch_error_retry_delay rather than the normal schedule.
rule FeedChecked {
    when: feed: RssFeed.next_check <= now

    requires: feed.status = active

    let fetch_result = fetch_feed(feed.url)          -- 30-second HTTP timeout

    -- On fetch error: advance next_check by fetch_error_retry_delay; no agent invocation.
    if fetch_result.error:
        ensures: feed.next_check = now + config.fetch_error_retry_delay

    -- On success: extract title, diff new items, cap seen_guids, deliver batch.
    if not fetch_result.error:
        let new_items = diff_new_items(fetch_result.items, feed.seen_guids)
                            .take(config.max_items_per_prompt)
        let next_check = compute_next_run(feed.schedule, now)

        ensures: feed.title = fetch_result.title ?? feed.title
        ensures: feed.next_check = next_check
        ensures: feed.seen_guids = merge_and_cap(feed.seen_guids, new_items.guids, config.max_seen_guids)
        ensures: if new_items.count > 0: FeedItemsBatched(feed: feed, items: new_items)

    @guidance
        -- seen_guids is a JSON-serialised array. Capping keeps the newest GUIDs and
        -- trims from the oldest end (FIFO). Cap is hardcoded at 500.
        -- Fetch timeout is 30 seconds.
}

-- All new items for a feed check are delivered in a single isolated agent invocation.
-- The agent is given a judgment prompt listing all items; interest filters if set.
-- Result is sent to feed.chat_jid and appended to rss-digest.md in the group folder.
rule FeedItemsBatched {
    when: FeedItemsBatched(feed, items)

    ensures: FeedAgentStarted(
        feed: feed,
        items: items,
        session_id: null,               -- always isolated; no group session reused
        is_scheduled_task: true
    )
    ensures: feed.group.rss_digest_appended(items, now)  -- appended to rss-digest.md

    @guidance
        -- RSS judgment containers route through GroupQueue.enqueueTask, keyed on
        -- feed.chat_jid (the same JID used by the main agent and scheduled tasks for
        -- that group). This means RSS, Zotero, scheduled tasks, and the main agent
        -- for a given group are all serialised: at most one container runs at a time.
        --
        -- The container uses the group's standard image and mounts (including group
        -- memory), with sessionId=undefined (always isolated, no conversation history).
        -- Timeout and close delay follow the scheduled task defaults.
        --
        -- SESSION DIRECTORY INVARIANT
        -- RSS judgment containers share the group's session directory
        -- (DATA_DIR/sessions/{group.folder}/...) with the main agent and other
        -- scheduled-task containers. The API-error poller in container-runner.ts
        -- watches all .jsonl files in that directory and attributes errors to the
        -- currently running container. Correctness relies on the GroupQueue
        -- serialisation guarantee above: if two containers for the same group ran
        -- concurrently, each poller would see the other's session file and misattribute
        -- errors. Specialist containers are exempt because they use per-task
        -- spec-{id} session folders.
}

rule FeedPaused {
    when: PauseFeed(requesting_group, feed)

    requires: requesting_group.is_main or feed.group = requesting_group
    requires: feed.status = active

    ensures: feed.status = paused
    ensures: feed.next_check = null
}

rule FeedResumed {
    when: ResumeFeed(requesting_group, feed)

    requires: requesting_group.is_main or feed.group = requesting_group
    requires: feed.status = paused

    let next_check = compute_next_run(feed.schedule, now)

    ensures: feed.status = active
    ensures: feed.next_check = next_check
}

rule FeedCancelled {
    when: CancelFeed(requesting_group, feed)

    requires: requesting_group.is_main or feed.group = requesting_group
    -- Note: code does not enforce feed.status in { active, paused }; cancel is idempotent.

    ensures: feed.status = cancelled
    ensures: feed.next_check = null
    -- Feed record and seen_guids history retained as a tombstone.
    -- cancelled is terminal: resume is rejected for cancelled feeds.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Non-main groups can only schedule tasks targeting their own chat.
invariant TaskTargetAuthorisation {
    for t in ScheduledTasks:
        not t.group.is_main implies t.target_chat = t.group.chat
}

-- Tasks respect the dispatch depth limit to prevent infinite agent-to-agent loops.
invariant TaskDispatchDepthBounded {
    for t in ScheduledTasks:
        t.dispatch_depth < nanoclaw.config.max_dispatch_depth
}

-- Active tasks always have a next_run timestamp.
invariant ActiveTasksHaveNextRun {
    for t in ScheduledTasks:
        t.status = active implies t.next_run != null
}

-- Completed tasks never have a next_run timestamp.
invariant CompletedTasksHaveNoNextRun {
    for t in ScheduledTasks:
        t.status = completed implies t.next_run = null
}

-- At most one agent container runs at a time per group JID.
-- Scheduled tasks, RSS judgment containers, Zotero syncs, and the main agent
-- for a given group all serialise on the same JID via GroupQueue.enqueueTask /
-- enqueueMessageCheck. This is a load-bearing invariant: the API-error session
-- poller in container-runner.ts watches a shared per-group session directory and
-- relies on serial execution to correctly attribute errors to the running container.
-- Specialist containers are exempt: they use per-task spec-{id} session folders
-- and a distinct JID, so they never conflict with the group's session directory.
--
-- Enforced by GroupQueue.state.active per JID. If parallel execution within a
-- group is ever introduced, session directories must move to a per-container
-- model (following the specialist pattern) before this invariant can be relaxed.
invariant OneActiveContainerPerGroupJid {
    for g in nanoclaw.Groups:
        nanoclaw.AgentSessions where group = g and status = active .count <= 1
}
