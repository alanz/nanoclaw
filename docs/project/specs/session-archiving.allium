-- allium: 3
-- session-archiving.allium
--
-- Unified session archiving and summarisation for NanoClaw conversation groups.
-- Every session end — whether by auto-compact or explicit /reset — produces a
-- ConversationArchive (raw transcript, written programmatically) and a
-- SessionSummary (AI-generated, written by a throwaway agent session).
--
-- Scope: Session end archiving and summarisation
-- Includes:
--   - ConversationArchive creation on both auto-compact and /reset paths
--   - SessionSummary creation via throwaway agent session
--   - Reaction signalling during archiving and summarising phases
--   - Failure handling (failed throwaway, missing JSONL, empty session)
--   - Startup recovery for orphaned archives
--   - Retry lifecycle with configurable limit (max_throwaway_retries)
--   - Session log visibility via ephemeral group identity
--   - Health signal capture (churn detection, compact detection, API errors)
--   - Manual re-run from main group
--   - MCP container skills for agent-driven discovery (via ipc.allium failed_summaries query) and retry of failed summaries
-- Excludes:
--   - Session lifecycle management (see nanoclaw.allium)
--   - SDK compaction mechanics (see container-claude-sdk.allium)
--   - IPC task wire formats (see ipc.allium)
--   - Content and structure of the SessionSummary (agent's discretion)

use "./nanoclaw.allium" as core
use "./container-claude-sdk.allium" as sdk
use "./scheduling.allium" as scheduling

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Observed health signals captured from a failed throwaway run, used to
-- enrich placeholder SessionSummaries and aid diagnosis of recurring failure
-- modes. Populated by inspecting the session log at failure time.
value ThrowawayFailureSignals {
    timed_out_without_output: Boolean   -- container ran full timeout with no output (churn)
    triggered_own_compact: Boolean      -- container triggered auto-compact (oversized input)
    api_error: String?                  -- last API error observed, null if none
    -- The raw JSONL the throwaway would have consumed was larger than the
    -- configured fraction of context_limit_tokens, and no ConversationArchive
    -- was available to substitute. The throwaway was never launched; failure is
    -- terminal from the automatic retry loop (manual retry possible once a
    -- transcript is generated).
    input_too_large: Boolean
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- A raw conversation transcript archived at session end.
-- Written programmatically from the session JSONL — no agent is involved.
-- Produced on both auto-compact and /reset paths.
-- is_placeholder is true when the source JSONL was missing or the session was empty;
-- a placeholder marks the gap visibly rather than silently dropping it.
entity ConversationArchive {
    session_id: String
    group: core.Group
    path: String              -- /workspace/group/conversations/{date}-{HHmm}-{name}.md
    archived_at: Timestamp
    source_jsonl: String      -- JSONL file read to produce this archive
    is_placeholder: Boolean   -- true when JSONL was missing or session had no messages
    -- Lower bound of the message timestamp range captured in this archive (exclusive).
    -- Null means the archive contains the full transcript from session start.
    -- A non-null value points at a prior non-placeholder archive's archived_at for
    -- the same session_id; only messages timestamped strictly later are included.
    messages_since: Timestamp?
    -- Which session-end path produced this archive: compact (from an SDK auto-compact
    -- hook) or reset (from an explicit /reset command). Propagated onto the
    -- ThrowawaySession created for this archive so downstream rules and the MCP
    -- list_failed_summaries tool can surface the original trigger, including after
    -- a crash-recovery re-summarisation.
    trigger_type: compact | reset
}

-- An AI-generated summary of a completed session.
-- Written by a ThrowawaySession after the session ends.
-- Produced on both auto-compact and /reset paths.
-- is_placeholder is true when the throwaway failed or the JSONL was missing.
entity SessionSummary {
    session_id: String
    group: core.Group
    path: String              -- /workspace/group/memory/sessions/{archive_datetime(session_id)}.md on initial run;
                              -- /workspace/group/memory/sessions/{archive_datetime(session_id)}-processed-at-{YYYY-MM-DD-HHmm}.md on retry;
                              -- placeholders retain their existing suffixes (-failed, -oversized, -missing, -empty).
    created_at: Timestamp
    is_placeholder: Boolean   -- true when summary could not be generated
}

-- A short-lived agent session whose sole purpose is to write a SessionSummary
-- from a completed session's JSONL. Discarded after completion.
-- Idempotent: safe to re-run if a previous attempt was interrupted.
--
-- Retry lifecycle: a failed throwaway with retry_count < config.max_throwaway_retries
-- moves to status = pending and is re-dispatched on the next NanoclawStarted event
-- (or immediately if NanoClaw is running). Once retries are exhausted (retry_count
-- reaches max_throwaway_retries), status = failed is terminal from the automatic
-- retry loop's point of view; a manual retry (RetrySessionSummaryRequested) resets
-- retry_count to 0 and gives the throwaway a fresh allocation of attempts.
entity ThrowawaySession {
    for_session_id: String    -- ID of the session being summarised
    group: core.Group
    -- Path to the file the throwaway container is given for summarisation:
    -- a ConversationArchive markdown transcript if one exists for the session,
    -- otherwise the raw JSONL. See preferred_source() for the selection rule.
    source_input: String
    -- Ephemeral group name (e.g. "throwaway-<uuid>") that scopes the container's
    -- session log directory. Stable across retries for the same throwaway entity.
    -- Gives the container its own log location (data/sessions/<ephemeral_group_id>/)
    -- so transcripts can be streamed without polluting the main group's log.
    ephemeral_group_id: String
    -- Filesystem path of the current (or most recent) container run's log directory,
    -- under data/sessions/. Null until the container starts its first run.
    log_path: String?
    -- Number of automatic retries already attempted for this throwaway.
    -- 0 on initial creation; incremented by ThrowawaySessionFailedRetryable.
    retry_count: Integer
    -- Observed failure signals from the most recent failed run. Null while the
    -- throwaway has never failed or after a manual retry resets the state.
    failure_signals: ThrowawayFailureSignals?
    -- pending = queued for (re)dispatch, container not yet running
    -- running  = container active
    -- completed = exited successfully, SessionSummary written
    -- failed    = exited unsuccessfully and retries are exhausted
    -- ThrowawayContainerExited is an external trigger with no local surface provider.
    -- The checker cascades unreachable-trigger → unreachable-rule → unobserved status assignment.
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: pending | running | completed | failed
    started_at: Timestamp
    -- Whether this throwaway was re-queued via a manual retry command after
    -- the automatic retry loop had exhausted its attempts and set status = failed.
    -- False on initial creation; set true by ManualRetryThrowawaySession.
    -- Used with retry_count to select the correct SessionSummary filename suffix.
    was_manual_retry: Boolean
    -- Whether this throwaway was triggered by an auto-compact (compact) or an
    -- explicit /reset command (reset). Exposed to the list_failed_summaries tool
    -- so the agent can surface meaningful context to the user.
    trigger_type: compact | reset
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Maximum number of automatic retries before the throwaway is marked failed
    -- and a placeholder SessionSummary is written. A value of 3 means the
    -- throwaway is attempted at most four times in total (initial + 3 retries).
    max_throwaway_retries: Integer = 3

    -- Effective context limit of the throwaway container, in tokens. Defaults
    -- to the SDK's auto-compact threshold: a container that would trigger
    -- self-compaction cannot meaningfully summarise a file that already
    -- exceeds that threshold.
    context_limit_tokens: Integer = sdk/config.auto_compact_window

    -- Maximum fraction of context_limit_tokens that the raw JSONL is allowed
    -- to occupy before the throwaway is refused at creation time. A decimal
    -- approximation of 1/3: the summariser needs headroom for its own
    -- reasoning, not just for reading the transcript. Applied only when no
    -- ConversationArchive is available as a substitute.
    max_input_fraction: Decimal = 0.333
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Auto-compact path ----

-- When the SDK PreCompact hook fires and the source JSONL is present, archive the
-- raw transcript immediately, before the context is discarded.
-- Reaction ⏳ signals that archiving is in progress.
rule ArchiveOnPreCompact {
    when: sdk.SdkPreCompact(session_id, group, jsonl_path)

    requires: file_exists(jsonl_path)

    ensures: ConversationArchive.created(
        session_id: session_id,
        group: group,
        path: "/workspace/group/conversations/{date}-{HHmm}-{name}.md",
        archived_at: now,
        source_jsonl: jsonl_path,
        is_placeholder: false,
        messages_since: null,
        trigger_type: compact
    )
    ensures: sdk.ReactionTask.created(chat_jid: group.chat_jid, emoji: "⏳")

    @guidance
        -- Same archiving logic as the existing PreCompact hook in container-claude-sdk.allium.
        -- Only user and assistant text turns are included; tool calls are omitted.
        -- The reaction ⏳ replaces the existing PreCompact ⏳ — no change in user-visible behaviour.
}

-- If the JSONL is missing at PreCompact time, write a placeholder archive and log.
rule ArchiveOnPreCompactJonlMissing {
    when: sdk.SdkPreCompact(session_id, group, jsonl_path)

    requires: not file_exists(jsonl_path)

    ensures: ConversationArchive.created(
        session_id: session_id,
        group: group,
        path: "/workspace/group/conversations/{YYYY-MM-DD}-{HHmm}-missing.md",
        archived_at: now,
        source_jsonl: jsonl_path,
        is_placeholder: true,
        messages_since: null,
        trigger_type: compact
    )
    ensures: core.HostLogRecorded(
        level: error,
        text: "Session JSONL missing at PreCompact for session {session_id}: {jsonl_path}"
    )
    ensures: sdk.ReactionTask.created(chat_jid: group.chat_jid, emoji: "⏳")
}

-- After compaction completes, start a throwaway session to produce the SessionSummary.
-- Reaction 📝 signals that summarisation is in progress.
-- The 💭 reaction moves to ThrowawaySessionSucceeded — it fires when the summary is
-- done, not when compaction finishes.
rule StartThrowawayOnPostCompact {
    when: sdk.SdkPostCompact(session_id, group, jsonl_path)

    let throwaway_group_id = new_throwaway_group_id()
    let archive_exists = exists ConversationArchive{ session_id: session_id, is_placeholder: false }

    -- Only the normal path when we have a usable input: either a processed
    -- transcript exists, or the raw JSONL is small enough to feed directly.
    -- The oversized-JSONL-no-archive case is handled by
    -- ThrowawaySessionBlockedByInputSizeOnPostCompact.
    requires:
        archive_exists
        or jsonl_size_tokens(jsonl_path) <= config.context_limit_tokens * config.max_input_fraction

    ensures: ThrowawaySession.created(
        for_session_id: session_id,
        group: group,
        source_input: preferred_source(session_id, jsonl_path),
        ephemeral_group_id: throwaway_group_id,
        log_path: session_log_path(throwaway_group_id),
        retry_count: 0,
        failure_signals: null,
        status: running,
        started_at: now,
        was_manual_retry: false,
        trigger_type: compact
    )
    ensures: sdk.ReactionTask.created(chat_jid: group.chat_jid, emoji: "📝")

    @guidance
        -- new_throwaway_group_id() generates a stable UUID-based identifier of the
        -- form "throwaway-<uuid>"; session_log_path(id) returns the corresponding
        -- data/sessions/<id>/ directory path. Both are deterministic host helpers.
        -- preferred_source prefers a non-placeholder ConversationArchive's path
        -- over the raw JSONL: the archive is a processed markdown transcript
        -- with tool calls stripped, which fits far more session content into the
        -- same token budget than the raw JSONL would.
}

-- Refuse to launch the throwaway when the raw JSONL is the only available
-- input and exceeds the configured fraction of context_limit_tokens. A
-- container that would self-compact on its first read cannot produce a useful
-- summary, so failure is recorded at creation time and a placeholder
-- SessionSummary is written immediately. retry_count is set to the retry
-- ceiling so the automatic retry loop treats this as already exhausted;
-- recovery requires a ConversationArchive to appear (then a manual retry).
rule ThrowawaySessionBlockedByInputSizeOnPostCompact {
    when: sdk.SdkPostCompact(session_id, group, jsonl_path)

    let throwaway_group_id = new_throwaway_group_id()
    let archive_exists = exists ConversationArchive{ session_id: session_id, is_placeholder: false }

    requires: not archive_exists
    requires: jsonl_size_tokens(jsonl_path) > config.context_limit_tokens * config.max_input_fraction

    let main_group = core.Groups where is_main = true .first

    ensures: ThrowawaySession.created(
        for_session_id: session_id,
        group: group,
        source_input: jsonl_path,
        ephemeral_group_id: throwaway_group_id,
        log_path: null,
        retry_count: config.max_throwaway_retries,
        failure_signals: ThrowawayFailureSignals{
            input_too_large: true,
            timed_out_without_output: false,
            triggered_own_compact: false,
            api_error: null
        },
        status: failed,
        started_at: now,
        was_manual_retry: false,
        trigger_type: compact
    )
    ensures: SessionSummary.created(
        session_id: session_id,
        group: group,
        path: "/workspace/group/memory/sessions/{archive_datetime(session_id)}-oversized.md",
        created_at: now,
        is_placeholder: true
    )
    ensures: sdk.ReactionTask.created(chat_jid: group.chat_jid, emoji: "💭")
    ensures:
        if exists main_group:
            core.HostMessagePosted(
                target_chat: main_group.chat,
                text: throwaway_input_too_large_notice(session_id, jsonl_path)
            )
    ensures: core.HostLogRecorded(
        level: error,
        text: "Throwaway summarisation refused for session {session_id}: "
            + "raw JSONL exceeds {config.max_input_fraction} of context_limit_tokens "
            + "and no ConversationArchive is available"
    )

    @guidance
        -- The container is never launched; log_path is null because there is
        -- no session log to reference. Placeholder frontmatter should record
        -- the oversized-input signal so the dashboard can offer a manual
        -- retry once a transcript becomes available (e.g. via a later
        -- ConversationArchive for the same session_id).
        -- throwaway_input_too_large_notice produces the user-facing message
        -- body, naming the affected session and explaining that summarisation
        -- cannot proceed until the transcript is generated.
        -- archive_datetime resolution here: no throwaway is yet in scope (it is
        -- being created by this rule's ensures clause, and in the failed state),
        -- so the scan-by-session_id fallback applies. Scan the conversations
        -- directory for non-placeholder ConversationArchives with matching
        -- session_id and format the archived_at as YYYY-MM-DD-HHmm. The guard
        -- `not archive_exists` ensures at most one such archive exists at
        -- firing time (in practice zero — hence the placeholder suffix
        -- -oversized — but a concurrent archive write cannot produce more than
        -- one for this session_id), so "most recent" is not ambiguous here.
        -- If a ConversationArchive later appears, placeholder filenames should
        -- be resolved against it.
}

-- ---- /reset path ----

-- When /reset is issued on a session with messages and the JSONL is present,
-- archive the transcript programmatically (same code as PreCompact), then start
-- a throwaway session. The ConversationSession is cleared.
--
-- The archive is incremental: if a prior non-placeholder archive already exists
-- for this session_id (from an earlier auto-compact or reset), the new archive
-- contains only the messages timestamped strictly after that archive's
-- archived_at. Otherwise it contains the full transcript. This prevents the
-- same content from appearing in multiple archives for the same session.
rule ArchiveAndStartThrowawayOnReset {
    when: core.SessionCommandApplied(group, command: reset)

    let cs = core.ConversationSession{ group: group }
    let jsonl_path = session_jsonl_path(cs)

    requires: exists cs
    requires: cs.message_count > 0
    requires: file_exists(jsonl_path)

    let prior_archives = ConversationArchive
        where session_id = cs.session_id and not is_placeholder
    let latest_prior_at =
        if prior_archives.count > 0:
            latest_archived_at(prior_archives)
        else:
            null
    let throwaway_group_id = new_throwaway_group_id()
    let has_prior_archive = prior_archives.count > 0

    -- Normal path only when we have a usable input: a prior non-placeholder
    -- archive to substitute, or a raw JSONL small enough to feed directly.
    -- The oversized-JSONL-no-prior-archive case is handled by
    -- ThrowawaySessionBlockedByInputSizeOnReset.
    requires:
        has_prior_archive
        or jsonl_size_tokens(jsonl_path) <= config.context_limit_tokens * config.max_input_fraction

    ensures: ConversationArchive.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/conversations/{date}-{HHmm}-{name}.md",
        archived_at: now,
        source_jsonl: jsonl_path,
        is_placeholder: false,
        messages_since: latest_prior_at,
        trigger_type: reset
    )
    ensures: ThrowawaySession.created(
        for_session_id: cs.session_id,
        group: group,
        source_input: preferred_source(cs.session_id, jsonl_path),
        ephemeral_group_id: throwaway_group_id,
        log_path: session_log_path(throwaway_group_id),
        retry_count: 0,
        failure_signals: null,
        status: running,
        started_at: now,
        was_manual_retry: false,
        trigger_type: reset
    )
    ensures: sdk.ReactionTask.created(chat_jid: group.chat_jid, emoji: "⏳")
    ensures: not exists cs

    @guidance
        -- latest_archived_at returns the archived_at of the most recent entry in
        -- the given set. Implementation scans the conversations directory,
        -- parses each archive's YAML frontmatter, filters by session_id and
        -- is_placeholder = false, and selects the max archived_at.
        -- The incremental filter is applied to parsed messages before writing;
        -- messages lacking a timestamp are included (no safe way to exclude).
        -- preferred_source prefers a non-placeholder ConversationArchive's path
        -- over the raw JSONL; since this rule creates exactly such an archive,
        -- the throwaway is launched against the processed markdown transcript
        -- rather than the raw JSONL. Tool calls are stripped from that
        -- transcript, which fits far more session content into the same token
        -- budget.
}

-- /reset on a session whose raw JSONL exceeds the configured fraction of
-- context_limit_tokens and which has no prior non-placeholder archive to
-- substitute. The transcript is still archived programmatically (size does
-- not affect the archive writer), but the throwaway is never launched: the
-- container would self-compact on first read. A placeholder SessionSummary
-- is written immediately with retry_count at the ceiling, so the auto-retry
-- loop treats this as already exhausted. A manual retry becomes meaningful
-- once a usable archive exists.
rule ThrowawaySessionBlockedByInputSizeOnReset {
    when: core.SessionCommandApplied(group, command: reset)

    let cs = core.ConversationSession{ group: group }
    let jsonl_path = session_jsonl_path(cs)

    requires: exists cs
    requires: cs.message_count > 0
    requires: file_exists(jsonl_path)
    requires: not exists ConversationArchive{ session_id: cs.session_id, is_placeholder: false }
    requires: jsonl_size_tokens(jsonl_path) > config.context_limit_tokens * config.max_input_fraction

    let throwaway_group_id = new_throwaway_group_id()
    let main_group = core.Groups where is_main = true .first

    ensures: ConversationArchive.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/conversations/{date}-{HHmm}-{name}.md",
        archived_at: now,
        source_jsonl: jsonl_path,
        is_placeholder: false,
        messages_since: null,
        trigger_type: reset
    )
    ensures: ThrowawaySession.created(
        for_session_id: cs.session_id,
        group: group,
        source_input: jsonl_path,
        ephemeral_group_id: throwaway_group_id,
        log_path: null,
        retry_count: config.max_throwaway_retries,
        failure_signals: ThrowawayFailureSignals{
            input_too_large: true,
            timed_out_without_output: false,
            triggered_own_compact: false,
            api_error: null
        },
        status: failed,
        started_at: now,
        was_manual_retry: false,
        trigger_type: reset
    )
    ensures: SessionSummary.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/memory/sessions/{archive_datetime(cs.session_id)}-oversized.md",
        created_at: now,
        is_placeholder: true
    )
    ensures: sdk.ReactionTask.created(chat_jid: group.chat_jid, emoji: "💭")
    ensures:
        if exists main_group:
            core.HostMessagePosted(
                target_chat: main_group.chat,
                text: throwaway_input_too_large_notice(cs.session_id, jsonl_path)
            )
    ensures: core.HostLogRecorded(
        level: error,
        text: "Throwaway summarisation refused for session {cs.session_id}: "
            + "raw JSONL exceeds {config.max_input_fraction} of context_limit_tokens "
            + "and no ConversationArchive is available"
    )
    ensures: not exists cs

    @guidance
        -- The archive is written programmatically (parse JSONL, emit markdown);
        -- it is never too large for that path. messages_since is null because
        -- the guard ensures no prior non-placeholder archive exists for this
        -- session_id, so the full transcript is captured.
        -- The container is never launched; log_path is null because no session
        -- log exists. A subsequent RecoverOrphanedArchives run on this archive
        -- will not fire because a ThrowawaySession with status = failed for
        -- this session_id already exists.
        -- archive_datetime resolution here: no throwaway is yet in scope (it is
        -- being created by this rule's ensures clause, and in the failed
        -- state), so the scan-by-session_id fallback applies. Scan the
        -- conversations directory for non-placeholder ConversationArchives
        -- with matching session_id and format the archived_at as
        -- YYYY-MM-DD-HHmm. At firing time exactly one such archive exists: the
        -- ConversationArchive this rule just creates in its ensures clause —
        -- the pre-state had none (guarded by `not exists
        -- ConversationArchive{..., is_placeholder: false}`) and the new one is
        -- the archive of the session being reset. "Most recent" is therefore
        -- unambiguous.
}

-- If /reset is issued on a session with messages but the JSONL is missing,
-- write placeholder files, log the error, and still clear the session.
rule ResetJonlMissing {
    when: core.SessionCommandApplied(group, command: reset)

    let cs = core.ConversationSession{ group: group }

    requires: exists cs
    requires: cs.message_count > 0
    requires: not file_exists(session_jsonl_path(cs))

    ensures: ConversationArchive.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/conversations/{YYYY-MM-DD}-{HHmm}-missing.md",
        archived_at: now,
        source_jsonl: session_jsonl_path(cs),
        is_placeholder: true,
        messages_since: null,
        trigger_type: reset
    )
    ensures: SessionSummary.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/memory/sessions/{YYYY-MM-DD}-{HHmm}-missing.md",
        created_at: now,
        is_placeholder: true
    )
    ensures: core.HostLogRecorded(
        level: error,
        text: "Session JSONL missing at /reset for session {cs.session_id}"
    )
    ensures: not exists cs
}

-- If /reset is issued on an empty session (no messages), write placeholder files
-- and log. The user issued a command — it must not disappear silently.
rule ResetOnEmptySession {
    when: core.SessionCommandApplied(group, command: reset)

    let cs = core.ConversationSession{ group: group }

    requires: exists cs
    requires: cs.message_count = 0

    ensures: ConversationArchive.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/conversations/{YYYY-MM-DD}-{HHmm}-empty.md",
        archived_at: now,
        source_jsonl: session_jsonl_path(cs),
        is_placeholder: true,
        messages_since: null,
        trigger_type: reset
    )
    ensures: SessionSummary.created(
        session_id: cs.session_id,
        group: group,
        path: "/workspace/group/memory/sessions/{YYYY-MM-DD}-{HHmm}-empty.md",
        created_at: now,
        is_placeholder: true
    )
    ensures: core.HostLogRecorded(
        level: warning,
        text: "Reset issued on empty session for group {group.folder}"
    )
    ensures: not exists cs
}

-- ---- Scheduled session reset ----

-- A scheduling.ScheduledTask with task_type = session_reset fires
-- SessionResetRequested when its idle check passes. This bridges the scheduler
-- into the existing /reset flow: a scheduled reset is behaviourally identical
-- to the user issuing /reset, and therefore produces the same
-- ConversationArchive + SessionSummary pair through the rules below.
rule ScheduledResetBridged {
    when: scheduling.SessionResetRequested(group, chat)

    ensures: core.SessionCommandApplied(group: group, command: reset)

    @guidance
        -- The scheduler writes an IPC task file of type request_session_archive
        -- and clears the in-memory session; the net effect is the same as if
        -- the user had typed /reset in their chat. All downstream archiving,
        -- summarisation and reaction behaviour follows the rules above.
        -- The idle check is performed in scheduling.TaskSessionResetDispatched;
        -- by the time this rule fires, the check has already passed.
}

-- ---- Throwaway session lifecycle ----

-- The throwaway container exits successfully: SessionSummary is written and
-- a 💭 reaction signals the group is ready for a new session.
rule ThrowawaySessionSucceeded {
    when: ThrowawayContainerExited(exited_session_id, success: true)
    for throwaway in ThrowawaySession where for_session_id = exited_session_id and status = running:

        let is_retry_run = throwaway.retry_count > 0 or throwaway.was_manual_retry = true
        let summary_path =
            if is_retry_run:
                "/workspace/group/memory/sessions/{archive_datetime(throwaway.for_session_id)}"
                    + "-processed-at-{now as YYYY-MM-DD-HHmm}.md"
            else:
                "/workspace/group/memory/sessions/{archive_datetime(throwaway.for_session_id)}.md"

        ensures: throwaway.status = completed
        ensures: SessionSummary.created(
            session_id: throwaway.for_session_id,
            group: throwaway.group,
            path: summary_path,
            created_at: now,
            is_placeholder: false
        )
        ensures: sdk.ReactionTask.created(chat_jid: throwaway.group.chat_jid, emoji: "💭")

    @guidance
        -- The throwaway is a fresh agent invocation: no session_id, not resumed.
        -- Its prompt instructs Andy to read source_jsonl and write a structured
        -- SessionSummary with YAML frontmatter to memory/sessions/.
        -- Only one session may be active per group at a time; user messages queue
        -- behind the throwaway automatically.
        -- archive_datetime resolution, when a throwaway is in scope: resolve from
        -- throwaway.source_input, not by scanning all archives for the session.
        -- If source_input is a ConversationArchive path, read its archived_at
        -- frontmatter field and format as YYYY-MM-DD-HHmm. This is stable across
        -- retries because source_input is set at throwaway creation time and
        -- never changes thereafter, regardless of how many other archives exist
        -- for the same session_id. If source_input is a raw JSONL path (no
        -- archive was available at creation time), fall back to scanning the
        -- conversations directory for non-placeholder archives with matching
        -- session_id.
        -- Anchoring to source_input matters because a session can accumulate
        -- multiple non-placeholder archives (e.g. one from an auto-compact and a
        -- later one from an explicit /reset). Picking "the most recent" archive
        -- at retry time would name a retry summary after the wrong session
        -- boundary — a compact-triggered throwaway retried after a subsequent
        -- reset must still be named for the compact's archive, not the reset's.
        -- Using the archive's timestamp (rather than now) for the filename
        -- prefix keeps retried summaries aligned with the original session's
        -- identity; the "-processed-at-{now}" suffix disambiguates multiple
        -- summary files produced for the same session.
}

-- If the throwaway container fails and automatic retries remain, queue it for
-- re-dispatch. Capture observed failure signals from the session log so repeated
-- failures can be diagnosed. No SessionSummary is written at this point — the
-- placeholder is reserved for the exhausted-retries path below.
rule ThrowawaySessionFailedRetryable {
    when: ThrowawayContainerExited(exited_session_id, success: false)
    for throwaway in ThrowawaySession where for_session_id = exited_session_id and status = running:

        requires: throwaway.retry_count < config.max_throwaway_retries
        -- input_too_large failures are created directly in status = failed
        -- with retry_count = max (no container was ever launched), so this
        -- guard is defensive; it pins the invariant that an auto-retry is
        -- never attempted for a size-blocked throwaway.
        requires: not (throwaway.failure_signals?.input_too_large = true)

        ensures: throwaway.status = pending
        ensures: throwaway.retry_count = throwaway.retry_count + 1
        ensures: throwaway.failure_signals = observe_failure_signals(throwaway.log_path)
        ensures: core.HostLogRecorded(
            level: warning,
            text: "Throwaway summarisation failed for session {throwaway.for_session_id}, "
                + "retry {throwaway.retry_count + 1} of {config.max_throwaway_retries}"
        )

    @guidance
        -- observe_failure_signals inspects the session log at log_path to detect
        -- churn (full timeout with no output), container-initiated compaction and
        -- the last API error, and returns a ThrowawayFailureSignals value.
        -- Reaction 📝 is preserved — the group remains in the summarising state
        -- until the retry completes or retries are exhausted.
}

-- If the throwaway container fails and retries are exhausted, mark the throwaway
-- failed, write an enriched placeholder SessionSummary, notify the user that
-- summarisation failed after max_throwaway_retries attempts and that a manual
-- retry is possible, and move the group reaction from 📝 to 💭 so the user is
-- not left in the summarising state indefinitely.
rule ThrowawaySessionFailedExhausted {
    when: ThrowawayContainerExited(exited_session_id, success: false)

    let main_group = core.Groups where is_main = true .first

    for throwaway in ThrowawaySession where for_session_id = exited_session_id and status = running:

        requires: throwaway.retry_count >= config.max_throwaway_retries

        ensures: throwaway.status = failed
        ensures: throwaway.failure_signals = observe_failure_signals(throwaway.log_path)
        ensures: SessionSummary.created(
            session_id: throwaway.for_session_id,
            group: throwaway.group,
            -- Placeholder frontmatter includes log_path, failure_signals,
            -- retry_count and source_jsonl so the dashboard can surface diagnostic
            -- detail and offer a manual retry affordance.
            path: "/workspace/group/memory/sessions/{archive_datetime(throwaway.for_session_id)}-failed.md",
            created_at: now,
            is_placeholder: true
        )
        ensures: sdk.ReactionTask.created(chat_jid: throwaway.group.chat_jid, emoji: "💭")
        ensures:
            if exists main_group:
                core.HostMessagePosted(
                    target_chat: main_group.chat,
                    text: throwaway_retry_exhausted_notice(throwaway, config.max_throwaway_retries)
                )
        ensures: core.HostLogRecorded(
            level: error,
            text: "Throwaway summarisation failed for session {throwaway.for_session_id} "
                + "after {config.max_throwaway_retries} retries; placeholder summary written"
        )

    @guidance
        -- A fresh user session starts after this rule fires — failure is non-blocking.
        -- The placeholder SessionSummary embeds the diagnostic context (log_path,
        -- failure_signals, retry_count, source_jsonl) in its frontmatter; the
        -- dashboard reads these to surface a retry affordance.
        -- throwaway_retry_exhausted_notice produces the user-facing message body,
        -- naming the failed session and advising that a manual retry is possible
        -- from the main group.
        -- archive_datetime resolution, when a throwaway is in scope: resolve from
        -- throwaway.source_input, not by scanning all archives for the session.
        -- If source_input is a ConversationArchive path, read its archived_at
        -- frontmatter field and format as YYYY-MM-DD-HHmm. This is stable across
        -- retries because source_input is set at throwaway creation time and
        -- never changes thereafter, regardless of how many other archives exist
        -- for the same session_id. If source_input is a raw JSONL path (no
        -- archive was available at creation time), fall back to scanning the
        -- conversations directory for non-placeholder archives with matching
        -- session_id.
        -- Anchoring to source_input matters because a session can accumulate
        -- multiple non-placeholder archives (e.g. one from an auto-compact and a
        -- later one from an explicit /reset). Picking "the most recent" archive
        -- when naming the placeholder would align the file with the wrong
        -- session boundary — the placeholder belongs to the session the
        -- throwaway was created to summarise, not to any archive that arrived
        -- afterwards.
}

-- When a ThrowawaySession transitions into the pending state in a running
-- NanoClaw process, dispatch a fresh container run immediately. This handles
-- the retry loop: ThrowawaySessionFailedRetryable sets status to pending, and
-- this rule picks it up and moves it back to running with a new log path.
--
-- Note: this uses transitions_to rather than becomes because ThrowawaySessions
-- are never created with status = pending; they are created with status =
-- running and only enter pending via the retryable failure path.
rule ThrowawaySessionRetryDispatched {
    when: throwaway: ThrowawaySession.status transitions_to pending

    let new_log = session_log_path(throwaway.ephemeral_group_id)

    ensures: throwaway.status = running
    ensures: throwaway.log_path = new_log
    ensures: throwaway.started_at = now

    @guidance
        -- The ephemeral_group_id is stable across retries, so the log_path form
        -- is deterministic; the host may version subdirectories under it to keep
        -- each attempt's logs distinct (implementation detail).
        -- Startup recovery for throwaways already in status = pending when
        -- NanoClaw was last shut down is handled by RecoverOrphanedPendingThrowaways.
}

-- ---- Manual retry ----

-- The user can request a manual retry of a failed throwaway from the main group.
-- This resets retry_count to 0 and failure_signals to null, and moves the
-- throwaway back to pending so ThrowawaySessionRetryDispatched picks it up.
rule ManualRetryThrowawaySession {
    when: RetrySessionSummaryRequested(group, session_id)

    let throwaway = ThrowawaySession{ for_session_id: session_id, status: failed }

    requires: exists throwaway

    ensures: throwaway.retry_count = 0
    ensures: throwaway.failure_signals = null
    ensures: throwaway.status = pending
    ensures: throwaway.was_manual_retry = true

    @guidance
        -- Resetting retry_count to 0 gives the throwaway a fresh allocation of
        -- config.max_throwaway_retries attempts. The group parameter identifies
        -- the main group from which the command was issued; the throwaway's own
        -- group (accessed via throwaway.group) is the conversation group the
        -- failed summarisation belonged to and is used by downstream rules for
        -- reaction and notification routing.
        -- was_manual_retry is latched true so that ThrowawaySessionSucceeded
        -- selects the "-processed-at-{now}" suffix for the SessionSummary path,
        -- preventing the retry from overwriting any existing summary file that
        -- shares the archive's datetime prefix.
}

-- ---- Startup recovery ----

-- On startup, any non-placeholder ConversationArchive without a corresponding
-- SessionSummary gets a new ThrowawaySession to produce the missing summary,
-- unless an existing ThrowawaySession for that session has already exhausted
-- its retries. In that case the user must trigger a manual retry.
-- Safe because the throwaway is idempotent — the only output is the SessionSummary file.
rule RecoverOrphanedArchives {
    when: NanoclawStarted(_)
    for archive in ConversationArchive where
        not archive.is_placeholder
        and not exists SessionSummary{ session_id: archive.session_id }
        and not exists ThrowawaySession{ for_session_id: archive.session_id, status: failed }
        and not exists ThrowawaySession{ for_session_id: archive.session_id, status: pending }
        and not exists ThrowawaySession{ for_session_id: archive.session_id, status: running }:

        let throwaway_group_id = new_throwaway_group_id()

        ensures: ThrowawaySession.created(
            for_session_id: archive.session_id,
            group: archive.group,
            source_input: archive.path,
            ephemeral_group_id: throwaway_group_id,
            log_path: session_log_path(throwaway_group_id),
            retry_count: 0,
            failure_signals: null,
            status: running,
            started_at: now,
            was_manual_retry: false,
            trigger_type: archive.trigger_type
        )

    @guidance
        -- Recovery runs before the group accepts user messages.
        -- An archive is orphaned if no SessionSummary — not even a placeholder — exists
        -- for its session_id. Placeholder archives are excluded: they indicate the JSONL
        -- was missing and there is nothing to summarise.
        -- source_input is the archive's markdown path: a non-placeholder archive
        -- always exists at this call site (it is the loop subject), so the JSONL
        -- fallback that preferred_source provides elsewhere is unnecessary here.
        -- Existing ThrowawaySessions are respected: a running or pending one will
        -- complete or retry via its own rules; a failed one (exhausted retries)
        -- stays failed until the user issues a manual retry.
}

-- On startup, any ThrowawaySession left in status = pending (because NanoClaw
-- was shut down mid-retry-loop) is re-dispatched. This complements
-- ThrowawaySessionRetryDispatched, which only fires on in-process transitions.
rule RecoverOrphanedPendingThrowaways {
    when: NanoclawStarted(_)
    for throwaway in ThrowawaySession where status = pending:

        let new_log = session_log_path(throwaway.ephemeral_group_id)

        ensures: throwaway.status = running
        ensures: throwaway.log_path = new_log
        ensures: throwaway.started_at = now

    @guidance
        -- retry_count is not modified here: the retry budget is tied to automatic
        -- retry attempts, not to process restarts. A throwaway re-dispatched after
        -- a restart still has the same number of remaining attempts it had before.
}

-- On startup, reconcile placeholder SessionSummary files on disk (-failed.md
-- and -oversized.md) with the throwaway_sessions store. If a placeholder
-- exists but no ThrowawaySession row is present for its session_id, fabricate
-- a row that records the failure in its terminal, exhausted state so that
-- manual retry (via /retry-summary or the retry_session_summary MCP tool) can
-- subsequently locate and re-queue it.
rule RecoverOrphanedFailedPlaceholders {
    when: NanoclawStarted(_)
    for group in core.Groups:
        for placeholder in legacy_failed_placeholders(group):

            requires: not exists ThrowawaySession{ for_session_id: placeholder.session_id }

            let throwaway_group_id = new_throwaway_group_id()

            ensures: ThrowawaySession.created(
                for_session_id: placeholder.session_id,
                group: group,
                source_input: placeholder.path,
                ephemeral_group_id: throwaway_group_id,
                log_path: null,
                retry_count: config.max_throwaway_retries,
                failure_signals: null,
                status: failed,
                started_at: now,
                was_manual_retry: false,
                trigger_type: compact
            )

    @guidance
        -- This rule closes the gap where a placeholder SessionSummary file
        -- (-failed.md or -oversized.md) exists on disk without a matching
        -- throwaway_sessions row. Two known legacy scenarios produce this
        -- state: (a) the placeholder was written by an older NanoClaw that
        -- predated the throwaway_sessions table, and (b) the database was
        -- reset or migrated while the placeholder files on disk survived.
        -- Without a DB row, the RetrySessionSummaryRequested flow (the
        -- /retry-summary chat command and the retry_session_summary MCP
        -- tool) cannot find the session and the user is stuck.
        --
        -- legacy_failed_placeholders(group) scans
        -- /workspace/group/memory/sessions/ for files ending in -failed.md or
        -- -oversized.md, parses the YAML frontmatter of each, and returns a
        -- record per file carrying at minimum session_id and the placeholder
        -- file's path. Files whose frontmatter cannot be parsed or whose
        -- session_id is absent are skipped (an error is logged via the
        -- implementation's normal channels; surfacing that here would
        -- duplicate diagnostics the rule cannot act on).
        --
        -- retry_count is set to config.max_throwaway_retries so the automatic
        -- retry loop treats the fabricated row as already exhausted: the only
        -- legitimate path forward is a manual retry, which resets retry_count
        -- to 0. failure_signals is null because the original run's log is
        -- unavailable from the placeholder alone, and observe_failure_signals
        -- has nothing to inspect. trigger_type defaults to compact because
        -- the originating trigger (compact vs reset) is not recoverable from
        -- a legacy placeholder file; a best-effort default is preferable to
        -- omitting the row and leaving manual retry broken.
}

------------------------------------------------------------
-- System Triggers
------------------------------------------------------------

-- ThrowawayContainerExited(for_session_id: String, success: Boolean)
-- Emitted by the host when a throwaway agent container terminates.
-- success=true if the container exited cleanly (exit code 0, SessionSummary written).
-- success=false on error exit, timeout, or missing SessionSummary after exit.

-- RetrySessionSummaryRequested(group: core.Group, session_id: String)
-- Emitted when a manual retry of a failed session summary is requested, either
-- by the user via the /retry-summary chat command in the main group, or by the
-- agent calling the retry_session_summary container skill MCP tool (typically
-- after inspecting the list returned by list_failed_summaries). The group
-- parameter is the group from which the request was issued; session_id
-- identifies the session whose failed ThrowawaySession should be re-queued.

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Every non-placeholder ConversationArchive eventually has a corresponding SessionSummary.
-- The disjunction with a running or pending ThrowawaySession captures the "eventually" —
-- the summary is in-flight (either actively running or queued for retry) rather than missing.
-- The size-blocked path also satisfies the invariant immediately: it writes a
-- placeholder SessionSummary at creation time (the throwaway is created in
-- status = failed with retry_count at the ceiling), so the first disjunct
-- holds without the throwaway ever reaching running or pending.
invariant ArchiveEventuallyHasSummary {
    for archive in ConversationArchive where not archive.is_placeholder:
        exists SessionSummary{ session_id: archive.session_id }
        or exists ThrowawaySession{ for_session_id: archive.session_id, status: running }
        or exists ThrowawaySession{ for_session_id: archive.session_id, status: pending }
}

-- Non-placeholder archives for the same session never overlap. For any two such
-- archives a (earlier) and b (later, archived_at strictly greater), the later
-- archive's messages_since must be at least the earlier archive's archived_at,
-- meaning b's content starts where (or after) a's content ended. No message
-- timestamp falls inside both ranges.
invariant NonOverlappingArchivesPerSession {
    for a in ConversationArchive:
        for b in ConversationArchive:
            a != b
                and a.session_id = b.session_id
                and not a.is_placeholder
                and not b.is_placeholder
                and a.archived_at < b.archived_at
                implies b.messages_since != null
                    and b.messages_since >= a.archived_at
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should the throwaway session have a restricted tool set to prevent side-effects beyond writing the SessionSummary? Deferred — monitor in practice first."

open question "Should placeholder files carry a frontmatter flag so the dashboard can render them differently from normal summaries?"
