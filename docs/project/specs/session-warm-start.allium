-- allium: 3
-- session-warm-start.allium
--
-- Scope: Session warm-start — assembling stable user context into the initial prompt
-- Includes:
--   - USER.md profile generation (weekly, via scheduling.ScheduledTask on the main group)
--   - UserProfile lifecycle: absent → current → stale → current
--   - Host-side context assembly and injection at every container spawn
-- Excludes:
--   - A-MEM note creation (see memory-graph.allium)
--   - Session archiving and summarisation (see session-archiving.allium)
--   - Memory indexing and hybrid search internals (see memory.allium)
--   - Scheduled task lifecycle mechanics (see scheduling.allium)

use "./nanoclaw.allium" as nanoclaw
use "./memory-graph.allium" as memgraph
use "./memory.allium" as memory
use "./scheduling.allium" as scheduling
use "./session-archiving.allium" as archiving

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity UserProfile {
    -- Singleton: tracks whether memory/USER.md has been generated and is current.
    -- File content is read from disk at injection time; not mirrored here.
    -- Starts absent; first successful profile generation activates it.
    -- The status: absent → current → stale → current cycle repeats weekly.
    --
    -- allium-ignore allium.status.unreachableValue, allium.status.noExit
    status: absent | current | stale
    -- (absent set by default; current/stale set by given-bound rules — both invisible to the checker)
    generated_at: Timestamp when status = current | stale
    stale_at: Timestamp when status = current | stale
}

entity SessionContext {
    -- Assembled warm-start context for one container spawn.
    -- Transient: created per spawn, consumed by InjectContextIntoPrompt.
    -- Distinct from nanoclaw.ConversationSession (persistent Claude conversation thread).
    group: nanoclaw.Group
    assembled_at: Timestamp
    user_profile_block: String?           -- null when profile.status = absent
    recent_notes_block: String?           -- null when no A-MEM notes exist yet
    prior_session_search_block: String?   -- null when no prior session or tail too short
    current_datetime_block: String        -- always present; injected last to preserve provider cache hits on stable blocks
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    recent_notes_count: Integer = 5              -- Phase 2: A-MEM notes injected by recency
    prior_session_turns: Integer = 4             -- Phase 3: tail turns used as search query
    prior_session_search_min_chars: Integer = 80 -- Phase 3: minimum tail length; falls back to second-most-recent archive if not met
    prior_session_search_limit: Integer = 5      -- Phase 3: max notes returned by search
    prior_session_search_min_score: Decimal = 0.5 -- Phase 3: minimum search score threshold
    profile_stale_after: Duration = 8.days       -- grace window before profile becomes stale
    profile_max_tokens: Integer = 2000           -- soft limit passed to agent prompt; hard limit enforced at injection
}

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    profile: UserProfile
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

default UserProfile profile = {
    status: absent
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Phase 1: Profile Generation ----

-- The profile file is generated by a scheduling.ScheduledTask on the main group
-- (a weekly cron). When the agent writes memory/USER.md, the file watcher fires
-- WorkspaceFileChanged, which triggers this rule.
-- allium-ignore allium.rule.unreachableTrigger
rule ProfileFileUpdated {
    when: WorkspaceFileChanged(group, path, _)

    requires: group.is_main
    requires: path = "memory/USER.md"

    ensures:
        profile.status = current
        profile.generated_at = now
        profile.stale_at = now + config.profile_stale_after

    @guidance
        -- The agent that writes memory/USER.md is invoked as a scheduling.ScheduledTask
        -- on the main group (weekly cron, default: Sunday 03:00, isolated context_mode).
        -- The task prompt instructs the agent to synthesise USER.md from all available
        -- sources, weighting recent activity heavily — the goal is to capture the user's
        -- current focus and in-progress work, not a historical average. The agent decides
        -- what to surface; the spec does not impose a time window or note count limit.
        -- The prompt must state the token budget (config.profile_max_tokens) explicitly
        -- so the agent self-limits; the host enforces a hard truncation at injection time.
        -- Sources available to the agent:
        --   - memory/notes/  (all A-MEM notes)
        --   - memory/sessions/  (archiving.SessionSummary files)
        --   - memory/research-topics.md
        --   - the current memory/USER.md (prior profile, if it exists)
        --   - /workspace/extra/org/  (org GTD files, read-only mount)
        -- The agent writes a complete rewrite of memory/USER.md, not an incremental patch.
        -- Rationale: USER.md is a transient "current focus" summary, not a second memory
        -- store. Long-term memory lives in the A-MEM note graph (permanent, grow-only,
        -- indexed). Incremental patching causes drift — stale topics persist after the
        -- user's focus moves on, and a profile mixing stale with fresh context misleads
        -- the agent. No information is lost in a rewrite because the prior USER.md is
        -- itself one of the agent's input sources; anything still relevant is carried
        -- forward, anything no longer relevant is dropped.
        -- WorkspaceFileChanged fires within seconds of the write via the @parcel/watcher
        -- subscription (the same watcher that drives memory.allium's FileDiscovered/FileUpdated rules).
        -- The profile content is not stored in this entity; the host reads it directly
        -- from disk at injection time.
}

rule ProfileBecomesStale {
    when: _: UserProfile.stale_at <= now

    requires: profile.status = current

    ensures: profile.status = stale
}

-- ---- Phase 2 & 3: Context Assembly ----

-- Two entry points funnel into ContainerAboutToSpawn so that AssembleSessionContext
-- applies to both message-triggered and task-triggered container invocations.

rule AgentAboutToSpawn {
    when: nanoclaw.AgentStarted(group, _, _)
    ensures: ContainerAboutToSpawn(group: group)
}

rule TaskAgentAboutToSpawn {
    when: scheduling.TaskAgentStarted(task, _, _)
    ensures: ContainerAboutToSpawn(group: task.group)
}

rule AssembleSessionContext {
    when: ContainerAboutToSpawn(group)

    -- Phase 2: top N A-MEM notes by mtime, from the main group only.
    let main = main_group()
    let notes = top_n_by_mtime(memgraph.MemoryNotes where group = main, config.recent_notes_count)

    -- Phase 3: prior session tail used as a search query (main group only).
    let tail = prior_session_tail(archiving.ConversationArchive, main, config.prior_session_turns)

    ensures:
        SessionContext.created(
            group: group,
            assembled_at: now,
            user_profile_block:
                if profile.status in {current, stale}:
                    prepend_header(
                        "-- user profile (generated {profile.generated_at}) --",
                        truncate_to_tokens(read_profile_file(), config.profile_max_tokens)
                    )
                else: null,
            recent_notes_block:
                if notes.count > 0: render_notes(notes) else: null,
            prior_session_search_block:
                if tail != null:
                    let results = memory.hybrid_search(
                        group: main,
                        query: tail,
                        path_prefix: "memory/notes/",
                        limit: config.prior_session_search_limit,
                        min_score: config.prior_session_search_min_score
                    )
                    if results.count > 0: render_search(results) else: null
                else: null,
            current_datetime_block: format_datetime(now)
        )

    @guidance
        -- main_group() returns the nanoclaw.Group whose is_main = true.
        -- top_n_by_mtime orders MemoryNotes by file mtime (not MemoryNote.created);
        --   file mtime captures both note creation and subsequent links: frontmatter updates.
        --   This is intentional: a note that was recently connected to another note has
        --   entered the active knowledge graph and is relevant context, even if its body
        --   is unchanged. Link-graph updates are a valid recency signal.
        -- prior_session_tail(main, N) returns a String? by reading the most recent
        --   non-placeholder archiving.ConversationArchive for the main group (ordered by
        --   archived_at desc) and extracting the last N user/assistant turns from
        --   its path file (e.g. conversations/YYYY-MM-DD-conversation-HHMM.md).
        --   The main group is used regardless of which group triggered the spawn — prior
        --   session context is always sourced from the user's primary conversation history.
        --   If the extracted tail is below config.prior_session_search_min_chars, the
        --   function falls back to the second-most-recent non-placeholder archive and
        --   uses its tail instead. Returns null if no non-placeholder archive exists,
        --   or if neither the most recent nor the second-most-recent tail meets the
        --   minimum length.
        --   ConversationArchives are the raw transcripts produced at session end;
        --   archiving.SessionSummary files in memory/sessions/ are the AI-written
        --   summaries used by the profile generation task — these are distinct sources.
        -- format_datetime(now) renders the current date and time as a prompt-ready string
        --   at date+hour granularity (e.g. "Current date/time: 2026-04-12T14:00Z"), truncating
        --   minutes and seconds. Always injected so the agent never needs a tool call to
        --   determine the current time. Hour granularity keeps the block stable within a
        --   session hour, limiting provider cache misses to at most once per hour.
        -- read_profile_file() reads memory/USER.md from the main group workspace.
        --   prepend_header prefixes the profile content with the generation date regardless
        --   of profile.status — the header is unconditional so the agent can always judge
        --   recency for itself (e.g. "-- user profile (generated 2026-04-04) --").
        -- render_notes and render_search format their inputs as prompt-ready text blocks.
}

rule InjectContextIntoPrompt {
    when: context: SessionContext.created
    ensures: InitialPromptAssembled(context: context)

    @guidance
        -- The host prepends each block into the container's initial system prompt in order:
        --   1. user_profile_block          (USER.md content, omitted when profile.status = absent)
        --   2. recent_notes_block          (top N A-MEM notes by mtime, main group only; omitted when empty)
        --   3. prior_session_search_block  (memory search from prior session tail; omitted when null)
        --   4. current_datetime_block      (always present, always last)
        -- current_datetime_block is injected last so that the stable blocks above it are
        -- positioned to benefit from provider prompt-cache hits if a cache boundary is
        -- ever introduced. Granularity: format_datetime renders date and hour only
        -- (e.g. "2026-04-12T14:00Z"), not seconds, so the block is identical across all
        -- spawns within the same hour.
        -- NOTE: cache_control boundary injection is not currently implemented. All four
        -- blocks are prepended to the human turn as a plain string. Placing blocks 1–3 in
        -- the system prompt append (where a provider cache hit could apply) requires a
        -- ContainerInput.systemContext field and agent-runner changes, and conflicts with
        -- session-resume semantics (the SDK uses the original session's system prompt on
        -- resume, so systemContext would only take effect on new sessions). Deferred as
        -- a future optimisation.
        -- Null blocks are silently omitted. The prompt is always valid regardless
        -- of whether USER.md exists or a prior session is available.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Profile generation trigger: the current approach is a weekly scheduling.ScheduledTask (cron). An alternative is to fire generation at session end — after the archiving.ThrowawaySession completes — so the profile always reflects the just-finished session. Tradeoff: session-end coupling gives a fresher profile, but profile generation reads the full note graph, session summaries, and org files, making it significantly more expensive than a SessionSummary throwaway. Since user messages queue behind throwaway sessions (session-archiving.allium), this would extend the dead time between /reset or compact and the next usable session. A hybrid is also possible: keep the weekly cron but also fire after any session that exceeds a turn-count threshold, with a recency throttle to avoid repeated generation on heavy-use days. Deferred: revisit once there is real usage data on how quickly profile content changes in practice."

