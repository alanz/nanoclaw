-- allium: 3
-- agent-to-agent.allium
--
-- Scope: Agent-initiated flows that originate inside an agent container and
--        are applied by the host because the container cannot write to the
--        host-owned inbound.db.
-- Includes: AgentDestination (routing + ACL), sub-agent creation
--           (create_agent), agent-to-agent message routing, channel
--           delivery permission check, card delivery (send_card),
--           message edit (edit_message), reaction (add_reaction),
--           scheduling (schedule_task / cancel_task / pause_task /
--           resume_task / update_task plus recurrence), interactive
--           question flow (ask_user_question + button response).
-- Excludes: Identity (identity.allium), channel routing (routing.allium),
--           session lifecycle (sessions.allium), human approvals
--           (approvals.allium), self-modification of container config
--           (self-mod.allium).
--
-- All agent-initiated flows share the same shape: the container writes a
-- system outbound message (or a chat-sdk card, in the question case) and
-- the host applies the requested effect. Permission checks for
-- agent-to-agent sends are enforced against AgentDestination, which is
-- both the routing table (name -> target) and the ACL (row exists =>
-- allowed).
--
-- Container spawning mechanisms.
--
-- NanoClaw has two distinct ways of spawning agent containers, and this
-- spec covers one of them:
--
--   1. Specialist / per-task containers. Ephemeral, one container per task.
--      A running agent dispatches a unit of work to a specialist agent
--      group; the host creates a per_thread Session on the null-channel
--      singleton MessagingGroup with thread_id = task.id and the full
--      sessions.allium machinery (FIFO concurrency cap, stuck detection,
--      heartbeat, retry) governs its lifetime. Lives in
--      specialists.allium + null-channel.allium + sessions.allium.
--
--   2. Long-lived named agents. Persistent, one container per AgentGroup.
--      An agent calls create_agent to create a new AgentGroup with its own
--      identity, filesystem and CLAUDE.md; messages travel between agent
--      groups via channel_type = "agent" OutboundMessages and land in the
--      target's agent_shared Session (messaging_group: null,
--      thread_id: null) — a persistent inbox with no task lifecycle. This
--      is what this spec covers.
--
-- The two mechanisms are complementary: specialists are dispatched
-- per-task and torn down; named agents are addressed by name and live as
-- long as their AgentGroup does.

use "./identity.allium" as identity
use "./routing.allium" as routing
use "./sessions.allium" as sessions

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    default_question_timeout: Duration = 300.seconds
    parent_destination_name: String = "parent"
    reserved_agent_names: Set<String> = { "global", "parent", "unnamed", "system", "host" }
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DestinationTargetType { channel | agent }
enum ScheduledTaskStatus { pending | paused | cancelled }
enum InteractiveQuestionStatus { pending | answered | timed_out }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- AgentDestination is the per-agent map of locally-named outbound targets,
-- and simultaneously the ACL: a row's existence is the source agent's
-- permission to send to that target. The host always re-validates against
-- this table on delivery; the per-session projection in inbound.db is a
-- cached view.

entity AgentDestination {
    agent_group: identity/AgentGroup
    local_name: String
    target_type: DestinationTargetType
    target_id: String
    created_at: Timestamp
}

-- A request from an agent to spawn a long-lived sub-agent. The host
-- creates a new AgentGroup, scaffolds its filesystem, and wires
-- bidirectional AgentDestination rows so the two agents can address
-- each other. Fire-and-forget; no human approval is required because the
-- create_agent tool is only exposed to admin-tier agents.

entity AgentCreationRequest {
    requesting_session: sessions/Session
    requested_name: String
    instructions: String?
    requested_at: Timestamp
    status: pending | applied | rejected

    transitions status {
        pending -> applied
        pending -> rejected
        terminal: applied, rejected
    }
}

-- ScheduledTask is a first-class scheduling concept. It is stored as a
-- messages_in row of kind = 'task' on the host, but the domain is the
-- task series (identified by series_id), not any single occurrence. A
-- recurring task produces one completed messages_in row per firing plus
-- one live follow-up row carrying the next process_after; both share the
-- same series_id and are the same ScheduledTask from the agent's point
-- of view.

entity ScheduledTask {
    session: sessions/Session
    series_id: String
    prompt: String
    script: String?
    process_after: Timestamp
    recurrence: String?
    status: ScheduledTaskStatus
    created_at: Timestamp

    is_due: process_after <= now
    is_recurring: recurrence != null

    transitions status {
        pending -> paused
        pending -> cancelled
        paused -> pending
        paused -> cancelled
        terminal: cancelled
    }
}

-- InteractiveQuestion is the host-side record of an outstanding
-- ask_user_question. The card itself is a chat-sdk OutboundMessage
-- delivered through the regular channel; this entity tracks whether
-- the user has clicked an option yet and bounds the time the agent
-- container will wait.

entity InteractiveQuestion {
    session: sessions/Session
    question_id: String
    title: String
    question: String
    options: List<String>
    status: InteractiveQuestionStatus
    selected_option: String? when status = answered
    created_at: Timestamp
    expires_at: Timestamp

    is_actionable: status = pending and expires_at > now

    transitions status {
        pending -> answered
        pending -> timed_out
        terminal: answered, timed_out
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

------------------------------------------------------------
-- Sub-agent creation (create_agent)
------------------------------------------------------------

-- An agent calls the create_agent MCP tool. The container writes a
-- kind='system' outbound message; the host receives this trigger and
-- creates an AgentCreationRequest as a record of the request.

rule AgentCreationRequested {
    when: AgentRequestsCreateAgent(session, name, instructions?)
    requires: name != ""
    ensures: AgentCreationRequest.created(
        requesting_session: session,
        requested_name: name,
        instructions: instructions,
        requested_at: now,
        status: pending
    )
}

-- A request is rejected when the normalised name is in the reserved
-- blocklist. "parent" is reserved because it is the auto-assigned
-- back-link from a child agent to its creator; "unnamed" is reserved
-- because it is the normalize_name fallback for blank input (and the
-- decision is to reject blanks outright rather than coerce); "global",
-- "system" and "host" are reserved to prevent conflicts with
-- system-level folder names and future infrastructure names.

rule AgentCreationRejectedReserved {
    when: AgentRequestsCreateAgent(session, name, instructions?)
    let local_name = normalize_name(name)
    requires: name != ""
    requires: local_name in config.reserved_agent_names
    let req = AgentCreationRequest{
        requesting_session: session,
        requested_name: name
    }
    requires: exists req
    requires: req.status = pending
    ensures:
        req.status = rejected
        AgentNotified(
            session: session,
            text: "name is reserved"
        )
}

-- A request is rejected when the requested name (after normalisation)
-- already exists as a destination in the creator's namespace. The host
-- notifies the creator via a chat-kind inbound message.

rule AgentCreationRejectedCollision {
    when: AgentRequestsCreateAgent(session, name, instructions?)
    let local_name = normalize_name(name)
    requires: name != ""
    requires: local_name not in config.reserved_agent_names
    requires: exists AgentDestination{
        agent_group: session.agent_group,
        local_name: local_name
    }
    let req = AgentCreationRequest{
        requesting_session: session,
        requested_name: name
    }
    requires: exists req
    requires: req.status = pending
    ensures:
        req.status = rejected
        AgentNotified(
            session: session,
            text: "name collision in destination namespace"
        )
}

-- Happy path: no collision, host creates the new AgentGroup, scaffolds
-- its filesystem (folder may be deduplicated globally), creates two
-- AgentDestination rows (creator -> child by chosen name; child ->
-- creator as "parent", deduplicated if the child already happens to
-- have a "parent" destination), refreshes the creator's session
-- destination projection, and notifies the creator.

rule AgentCreationApplied {
    when: AgentRequestsCreateAgent(session, name, instructions?)
    let local_name = normalize_name(name)
    requires: name != ""
    requires: local_name not in config.reserved_agent_names
    requires: not exists AgentDestination{
        agent_group: session.agent_group,
        local_name: local_name
    }
    let req = AgentCreationRequest{
        requesting_session: session,
        requested_name: name
    }
    requires: exists req
    requires: req.status = pending
    let folder = derive_unique_folder(local_name)
    let parent_name = derive_unique_parent_name(session.agent_group)
    ensures:
        let new_group = identity/AgentGroup.created(
            name: name,
            folder: folder,
            agent_provider: null,
            is_main: false,
            created_at: now
        )
        AgentGroupFilesystemInitialised(
            agent_group: new_group,
            instructions: instructions
        )
        AgentDestination.created(
            agent_group: session.agent_group,
            local_name: local_name,
            target_type: agent,
            target_id: new_group.id,
            created_at: now
        )
        AgentDestination.created(
            agent_group: new_group,
            local_name: parent_name,
            target_type: agent,
            target_id: session.agent_group.id,
            created_at: now
        )
        DestinationProjectionRefreshed(session: session)
        AgentNotified(
            session: session,
            text: "child agent ready"
        )
        req.status = applied

    @guidance
        -- Request and apply happen in the same host delivery-poll tick:
        -- the host reads the AgentRequestsCreateAgent stimulus from
        -- outbound.db, creates the AgentCreationRequest record (per
        -- AgentCreationRequested) and applies the result (this rule, or
        -- one of the rejection rules) within a single tick. There is no
        -- durable work queue between request and apply, so a creator
        -- session terminating mid-tick cannot strand a pending request
        -- in the system. The only abandonment path is the container
        -- crashing before it writes the system outbound message — in
        -- which case the host never observed the request to begin with.
        -- The AgentCreationRequest entity exists for traceability of
        -- past requests (including rejections), not to model deferred
        -- application.
}

------------------------------------------------------------
-- Agent-to-agent message routing
------------------------------------------------------------

-- When an agent's outbound message has channel_type = 'agent', the host
-- routes it to another agent group. The target's agent_shared session
-- is resolved (or lazily created) and a kind='chat' inbound message is
-- written into the target's inbound.db.
--
-- Permission: the source agent must hold an AgentDestination row for
-- the target, OR the source is sending to itself (used for system
-- notes back into its own session, e.g. follow-up prompts).

rule AgentToAgentMessageRouted {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.channel_type = "agent"
    requires: outbound.platform_id != null
    let source_group = outbound.session.agent_group
    let target_group = identity/AgentGroup{id: outbound.platform_id}
    requires: exists target_group
    requires: target_group = source_group
              or exists AgentDestination{
                  agent_group: source_group,
                  target_type: agent,
                  target_id: target_group.id
              }
    requires: exists sessions/Session{
        agent_group: target_group,
        messaging_group: null
    }
    let target_session = sessions/Session{
        agent_group: target_group,
        messaging_group: null
    }
    ensures:
        sessions/InboundMessage.created(
            session: target_session,
            seq: next_inbound_seq(target_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: outbound.content,
            process_after: null,
            tries: 0,
            created_at: now
        )
        sessions/SessionWoken(session: target_session)

    @guidance
        -- Inbound messages queue indefinitely in the target's inbound.db.
        -- A new container is woken immediately on routing (via the
        -- SessionWoken emission above), and there is no TTL after which
        -- an unconsumed message is dropped. This is deliberate: the
        -- container crash-recovery and restart mechanism is the safety
        -- valve for stuck targets, not message expiry. If a target
        -- container is wedged, host-sweep restarts it and the queued
        -- chat-kind inbound rows are processed in seq order on the next
        -- poll cycle.
}

-- First-contact case: the target agent group has never received a message
-- before, so no agent_shared session exists for it yet. Create one as part
-- of routing, then queue the inbound message and wake the container.
--
-- This is the agent-to-agent analogue of
-- sessions/SessionResolvedForAgentSharedWiring: that rule creates an
-- agent_shared session in response to a channel routing event
-- (routing/RoutedMessage.created), but agent-to-agent messages do not pass
-- through routing/RoutedMessage at all. Without this rule, the very first
-- message between two agent groups has no session to land in.

rule AgentToAgentMessageRoutedFirstContact {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.channel_type = "agent"
    requires: outbound.platform_id != null
    let source_group = outbound.session.agent_group
    let target_group = identity/AgentGroup{id: outbound.platform_id}
    requires: exists target_group
    requires: target_group = source_group
              or exists AgentDestination{
                  agent_group: source_group,
                  target_type: agent,
                  target_id: target_group.id
              }
    requires: not exists sessions/Session{
        agent_group: target_group,
        messaging_group: null
    }
    ensures:
        let target_session = sessions/Session.created(
            agent_group: target_group,
            messaging_group: null,
            thread_id: null,
            status: active,
            processing_state: idle,
            last_active: now,
            created_at: now
        )
        sessions/InboundMessage.created(
            session: target_session,
            seq: next_inbound_seq(target_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: outbound.content,
            process_after: null,
            tries: 0,
            created_at: now
        )
        sessions/SessionWoken(session: target_session)

    @guidance
        -- This is the agent-to-agent analogue of
        -- sessions/SessionResolvedForAgentSharedWiring, but triggered by
        -- an OutboundMessage from another agent rather than by a channel
        -- routing event. The two paths are mutually exclusive: this rule
        -- fires only when no Session exists for (target_group,
        -- messaging_group: null), and AgentToAgentMessageRouted fires
        -- only when one does.
        --
        -- Unlike specialist sessions (which are per_thread sessions on the
        -- null-channel singleton MessagingGroup), agent-to-agent sessions
        -- are true agent_shared sessions: messaging_group is null and
        -- thread_id is null. The session represents the target agent's
        -- persistent inbox for cross-agent traffic, not a per-task scratch
        -- space.
}

-- An agent-to-agent message that lacks a corresponding AgentDestination
-- (and is not a self-send) is rejected at delivery. This is the security
-- boundary: stale or hallucinated destination IDs cannot reach a target.

rule AgentToAgentMessageRejected {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.channel_type = "agent"
    requires: outbound.platform_id != null
    let source_group = outbound.session.agent_group
    let target_group = identity/AgentGroup{id: outbound.platform_id}
    requires: target_group != source_group
    requires: not exists AgentDestination{
        agent_group: source_group,
        target_type: agent,
        target_id: outbound.platform_id
    }
    ensures: AgentToAgentDeliveryRejected(
        outbound: outbound,
        reason: "no destination"
    )
}

------------------------------------------------------------
-- Channel delivery
------------------------------------------------------------

-- The channel-send analogue of AgentToAgentMessageRouted /
-- AgentToAgentMessageRejected. The host enforces that an agent may only
-- send to a channel that is either its session's origin messaging group,
-- OR one for which the source agent group holds an AgentDestination row
-- with target_type = channel.

rule AgentChannelMessageDelivered {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.channel_type != null
    requires: outbound.channel_type != "agent"
    let mg = routing/MessagingGroup{
        channel_type: outbound.channel_type,
        platform_id: outbound.platform_id
    }
    requires: exists mg
    requires: mg = outbound.session.messaging_group
              or exists AgentDestination{
                  agent_group: outbound.session.agent_group,
                  target_type: channel,
                  target_id: mg.id
              }
    ensures: ChannelMessageDelivered(outbound: outbound)
}

rule AgentChannelMessageRejected {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.channel_type != null
    requires: outbound.channel_type != "agent"
    let mg = routing/MessagingGroup{
        channel_type: outbound.channel_type,
        platform_id: outbound.platform_id
    }
    requires: exists mg
    requires: mg != outbound.session.messaging_group
    requires: not exists AgentDestination{
        agent_group: outbound.session.agent_group,
        target_type: channel,
        target_id: mg.id
    }
    ensures: ChannelDeliveryRejected(outbound: outbound, reason: "no destination")
}

------------------------------------------------------------
-- Channel actions
------------------------------------------------------------

-- send_card: deliver a structured display/interactive card to the channel.
-- No host-side state beyond normal OutboundMessage delivery.
rule AgentSentCard {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.kind = "chat-sdk"
    ensures: CardDelivered(outbound: outbound)
}

-- edit_message: replace the text of a previously delivered message on the
-- platform. The "edit" discriminator lives inside the opaque content blob,
-- so this rule documents the existence of the operation rather than
-- guarding on a navigable field.
rule AgentEditedMessage {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.kind = "chat"
    ensures: PlatformMessageEdited(outbound: outbound)
}

-- add_reaction: attach an emoji reaction to a previously delivered
-- message. As with edit_message, the "reaction" discriminator lives in
-- the opaque content blob.
rule AgentAddedReaction {
    when: outbound: sessions/OutboundMessage.created
    requires: outbound.kind = "chat"
    ensures: PlatformReactionAdded(outbound: outbound)
}

------------------------------------------------------------
-- Scheduling
------------------------------------------------------------

-- schedule_task: agent declares a one-shot or recurring task. The host
-- creates a ScheduledTask in the requesting session.

rule ScheduledTaskCreated {
    when: AgentRequestsScheduleTask(session, task_id, prompt, script?, process_after, recurrence?)
    requires: not exists ScheduledTask{series_id: task_id}
    ensures: ScheduledTask.created(
        session: session,
        series_id: task_id,
        prompt: prompt,
        script: script,
        process_after: process_after,
        recurrence: recurrence,
        status: pending,
        created_at: now
    )
}

-- pause_task: stop a series from firing without forgetting it.

rule ScheduledTaskPaused {
    when: AgentRequestsPauseTask(session, task_id)
    let task = ScheduledTask{series_id: task_id, session: session}
    requires: exists task
    requires: task.status = pending
    ensures: task.status = paused
}

-- resume_task: paused -> pending.

rule ScheduledTaskResumed {
    when: AgentRequestsResumeTask(session, task_id)
    let task = ScheduledTask{series_id: task_id, session: session}
    requires: exists task
    requires: task.status = paused
    ensures: task.status = pending
}

-- cancel_task: terminal cancellation. Recurrence is also cleared so the
-- recurrence sweep cannot revive the series.

rule ScheduledTaskCancelled {
    when: AgentRequestsCancelTask(session, task_id)
    let task = ScheduledTask{series_id: task_id, session: session}
    requires: exists task
    requires: task.status in {pending, paused}
    ensures:
        task.status = cancelled
        task.recurrence = null
}

-- update_task: change prompt, schedule, recurrence and/or script on the
-- live row. Any field omitted is left unchanged.

rule ScheduledTaskUpdated {
    when: AgentRequestsUpdateTask(session, task_id, prompt?, process_after?, recurrence?, script?)
    let task = ScheduledTask{series_id: task_id, session: session}
    requires: exists task
    requires: task.status in {pending, paused}
    ensures:
        if prompt != null: task.prompt = prompt
        if process_after != null: task.process_after = process_after
        if recurrence != null: task.recurrence = recurrence
        if script != null: task.script = script
}

-- Recurrence sweep. When a recurring task is "fired" by the session
-- processing side, that becomes a RecurrenceTickObserved trigger here:
-- compute the next firing in the user's timezone, clone a new pending
-- ScheduledTask carrying the same series_id, and clear the original's
-- recurrence so it isn't re-cloned next sweep tick.
--
-- "Fired" is an external event from the session processing side; tasks
-- don't terminate at "completed" in the scheduling domain — they either
-- fire and roll forward, or they are cancelled.

rule ScheduledTaskRecurrenceCloned {
    when: RecurrenceTickObserved(task)
    requires: task.recurrence != null
    let next_run = next_cron_firing(task.recurrence, user_timezone())
    ensures:
        ScheduledTask.created(
            session: task.session,
            series_id: task.series_id,
            prompt: task.prompt,
            script: task.script,
            process_after: next_run,
            recurrence: task.recurrence,
            status: pending,
            created_at: now
        )
        task.recurrence = null

    @guidance
        -- Timezone resolution for recurring tasks:
        --
        -- user_timezone() is global host config, not per-session or
        -- per-task. It is resolved once at host startup, in priority
        -- order: process.env.TZ, then the TZ entry in .env, then the
        -- system locale via Intl.DateTimeFormat, then UTC as a final
        -- fallback. The resolved value is stored as a single
        -- module-level constant shared across every session and agent
        -- group.
        --
        -- The recurrence column on ScheduledTask stores the raw cron
        -- string. The next firing is computed fresh on each sweep tick
        -- by parsing that cron expression against the host timezone, so
        -- the timezone is never frozen onto the task at creation time.
        -- A timezone change requires a host restart to take effect, and
        -- once the host comes back up all future firings of every
        -- existing recurring task silently shift to the new zone. Tasks
        -- created before the change are not migrated or annotated.
        --
        -- DST is handled correctly when the timezone is set to an IANA
        -- identifier (e.g. "Europe/London", "America/New_York"). Fixed
        -- offset values (e.g. "GMT+1", "UTC+05:30") do not adjust
        -- across DST boundaries. This behaviour is carried over from
        -- v1 unchanged.
}

------------------------------------------------------------
-- Interactive questions (ask_user_question)
------------------------------------------------------------

-- The agent calls ask_user_question. The container writes a chat-sdk
-- card to outbound.db; the host's delivery records an
-- InteractiveQuestion when the card is delivered. The agent then polls
-- inbound.db for the question_response.

rule InteractiveQuestionRecorded {
    when: AgentAsksUserQuestion(session, question_id, title, question, options, timeout?)
    requires: not exists InteractiveQuestion{question_id: question_id}
    let resolved_timeout = if timeout != null: timeout else: config.default_question_timeout
    ensures: InteractiveQuestion.created(
        session: session,
        question_id: question_id,
        title: title,
        question: question,
        options: options,
        status: pending,
        created_at: now,
        expires_at: now + resolved_timeout
    )

    @guidance
        -- There is no per-session limit on the number of concurrently
        -- outstanding InteractiveQuestion rows, and no count check before
        -- recording a new one. An agent may fan out arbitrarily many
        -- ask_user_question cards in a single turn. The practical bound
        -- is the Claude API's per-turn tool-call ceiling and the
        -- container's turn budget; the host imposes none of its own.
}

-- The user clicks a button on the card. The host resolves the
-- pending_questions row, writes a kind='system' question_response
-- inbound message into the session, and wakes the container.

rule InteractiveQuestionAnswered {
    when: UserSelectsQuestionOption(question_id, selected_option, user)
    let q = InteractiveQuestion{question_id: question_id}
    requires: exists q
    requires: q.is_actionable
    requires: selected_option in q.options
    ensures:
        q.status = answered
        q.selected_option = selected_option
        sessions/InboundMessage.created(
            session: q.session,
            seq: next_inbound_seq(q.session),
            kind: "system",
            status: pending,
            trigger: false,
            content: encode_question_response(question_id, selected_option),
            process_after: null,
            tries: 0,
            created_at: now
        )
        sessions/SessionWoken(session: q.session)
}

-- The container's polling deadline elapses without an answer. The
-- question becomes terminal so a stale row never resolves a click that
-- arrives after the agent has given up.

rule InteractiveQuestionTimedOut {
    when: q: InteractiveQuestion.expires_at <= now
    requires: q.status = pending
    ensures: q.status = timed_out

    @guidance
        -- "Timed out" is a container-side concept, not a host-side one.
        -- The container's polling deadline (expires_at on this entity)
        -- and the host-side pending_questions row are independent
        -- lifetimes: when this rule fires, the container stops waiting
        -- and the InteractiveQuestion becomes terminal, but on the host
        -- the underlying pending_questions row persists. There is no
        -- expires_at column on that row and the host sweep does not
        -- purge it.
        --
        -- A late button click therefore still finds the row, writes a
        -- kind='system' question_response inbound message into the
        -- session, and wakes the container — exactly as
        -- InteractiveQuestionAnswered describes. The click is delivered.
        --
        -- The agent has by then almost certainly continued past the
        -- ask_user_question call. Whether it acts on the late response,
        -- logs it as unexpected or ignores it depends entirely on its
        -- prompt and current task state; the spec does not constrain
        -- this. This is the intentionally accepted behaviour: no
        -- expires_at column is added to the host row, no purging sweep
        -- is introduced, and no acknowledgement-to-user path is added
        -- for late clicks.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A given local_name is unique within an agent group's destination
-- namespace. The host enforces this at insert time; the spec captures
-- it so the validator catches rules that would violate it.

invariant LocalNameUniquePerAgentGroup {
    for a in AgentDestinations:
        for b in AgentDestinations:
            a != b and a.agent_group = b.agent_group
                implies a.local_name != b.local_name
}

-- A series is one ScheduledTask at a time in the live (pending|paused)
-- states. Recurrence is allowed to leave a trail of cancelled rows
-- (terminal), but only one row of the series can be live.

invariant AtMostOneLiveTaskPerSeries {
    for a in ScheduledTasks:
        for b in ScheduledTasks:
            a != b and a.series_id = b.series_id
                implies not (
                    a.status in {pending, paused} and b.status in {pending, paused}
                )
}

-- question_id is the host-side handle for an outstanding question and
-- must be unique across all InteractiveQuestion records.

invariant UniqueQuestionId {
    for a in InteractiveQuestions:
        for b in InteractiveQuestions:
            a != b implies a.question_id != b.question_id
}

-- Checker note: when run on the whole specs/ directory, allium check 3.2.3
-- reports zero errors and zero warnings on this file. When run on this file
-- alone (`allium check specs/agent-to-agent.allium`), the checker emits
-- use.unresolvedPath warnings for ./identity.allium, ./routing.allium and
-- ./sessions.allium — those are imports that resolve correctly in the
-- multi-file check. Same pattern as self-mod.allium.
--
-- The remaining info-level diagnostics in this file are:
--   * rule.unreachableTrigger for the agent-initiated stimuli
--     (AgentRequestsCreateAgent, AgentRequestsScheduleTask,
--     AgentRequestsPauseTask, AgentRequestsResumeTask,
--     AgentRequestsCancelTask, AgentRequestsUpdateTask,
--     AgentAsksUserQuestion, RecurrenceTickObserved,
--     UserSelectsQuestionOption) — these are external entry points
--     emitted by the agent container or channel adapter; surfaces
--     for them belong in a future revision once the agent boundary
--     is being modelled in spec form.
--   * field.unused informational notes for declared metadata fields
--     (created_at, requested_at, instructions, title, question and
--     the is_due / is_recurring derivations) — kept for documentation
--     value even though no rule navigates them today.
