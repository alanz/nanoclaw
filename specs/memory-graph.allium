-- allium: 3
-- memory-graph.allium
--
-- Research-driven knowledge graph construction.
-- A researcher specialist investigates external sources in isolation and delivers
-- a report; the main agent synthesises the report into a linked MemoryNote that
-- integrates into the group's A-MEM knowledge graph.
--
-- NOTE: Ported from v1. Specialist delivery via specialists.allium result path
--       (no container-ipc-transfer). The v1 IPC transfer substrate is replaced by
--       the commit_to_memory flag on deliver_specialist_result, which writes
--       committed paths to SpecialistTask.committed_files (see specialists.allium).
--
-- Scope: MemoryNote and SynthesisNote entities, researcher specialist isolation model,
--        research dispatch, report writing, note creation, link generation,
--        back-link propagation, supersession, the synthesis workflow
-- Includes: researcher access model (external internet + the Zotero library, read-only;
--           no group memory),
--           result delivery via specialist pipeline (commit_to_memory path),
--           note creation from research result, link candidate selection and
--           back-link propagation, the grow-only note space (supersession is the
--           only way a note is retired), synthesis candidate scan and dispositions
-- Excludes:
--   - Specialist task lifecycle mechanics (see specialists.allium)
--   - Memory file indexing, chunking, and hybrid search (see memory.allium)
--   - Core agent group / session lifecycle (see identity.allium, sessions.allium)
--   - Zotero database sync, PDF scanning, and per-entry markdown generation (see zotero.allium)
-- Dependencies: specialists.allium (root-task commit_to_memory delivery path)

use "./identity.allium" as identity
use "./specialists.allium" as specialists
use "./memory.allium" as memory
use "./sessions.allium" as sessions

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The origin of a MemoryNote's content.
-- Always populated; records provenance for staleness detection.
value NoteSource {
    kind: file | url | conversation
    path: String?          -- relative to group workspace; set when kind = file
    url: String?           -- set when kind = url
    mtime: Timestamp?      -- file mtime at note creation; recorded for a future staleness
                           -- sweep (deferred: SourceStalenessDetection); nothing reads it yet
    last_fetched: Timestamp?    -- set when kind = url
    date: Timestamp?            -- set when kind = conversation
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- A structured, linked knowledge note in a group's memory graph.
-- Notes are the atomic units of the A-MEM knowledge graph — an agent-era
-- Zettelkasten. It lives in the group's zettel/ folder (notes in zettel/notes/,
-- the reports they are written from in zettel/reports/), apart from the
-- memory/ tree of memory.allium: its notes are permanent, where memory/ is
-- updated and pruned in place.
-- In-body references to other workspace files are relative Markdown links
-- (../reports/x.md), so they survive a change of host, port or folder; the
-- dashboard resolves them. NoteSource.path stays relative to the group
-- workspace (zettel/reports/x.md).
-- Each note captures a single insight with explicit graph edges (links) to
-- related notes. Notes are created by the main agent after synthesising a
-- researcher report; they are never created by the researcher itself.
--
-- Grow-only: a note's body and every frontmatter field except links and
-- superseded_by are fixed at creation, and no note is ever deleted. A note
-- that is wrong, incomplete or out of date is not corrected in place: a new
-- note lists it in supersedes, and it gets superseded_by. There is no status:
-- a superseded note stays in the graph as the record of what was believed and
-- when. Links it already has, and links already made to it, stay valid; but
-- once superseded it takes no new links in either direction - no new note
-- links to it (its successor points at it through supersedes, it at its
-- successor through superseded_by), and it is not given back-links. See the
-- GrowOnly guarantee on ZettelkastenWork.
entity MemoryNote {
    group: identity/AgentGroup
    id: String                         -- MEM-YYYY-MM-DD-{slug}; unique within group
    title: String
    content: String
    keywords: Set<String>
    tags: Set<String>
    links: Set<String>                 -- IDs of related notes (MEM or SYN) within this group; mutable
    created: Timestamp
    sources: Set<NoteSource>           -- always non-empty; records content provenance
    supersedes: Set<String>            -- IDs of notes (MEM or SYN) this note replaces; empty for most notes
    superseded_by: String?             -- ID of the note that replaced this one; set when it is superseded; mutable
}

-- A note that consolidates multiple MemoryNotes into a unified perspective.
-- Created by the main agent directly (no researcher involved).
-- Carries directed synthesis edges to the source notes it consolidates;
-- those edges are rendered separately from general link edges in the graph.
-- Lives in zettel/notes/ beside the MEM notes and is indexed (chunked and
-- embedded) like them. Grow-only, exactly as MemoryNote: only links and
-- superseded_by change after creation. A SynthesisNote may supersede notes of
-- either kind, including an earlier SynthesisNote, and be superseded by one.
entity SynthesisNote {
    group: identity/AgentGroup
    id: String                         -- SYN-YYYY-MM-DD-{slug}; unique within group
    title: String
    content: String
    keywords: Set<String>
    tags: Set<String>                  -- always includes "synthesis"
    links: Set<String>                 -- IDs of related notes (MEM or SYN) within this group; mutable
    created: Timestamp
    sources: Set<NoteSource>           -- records content provenance (often the conversation that approved it)
    synthesises: Set<String>           -- IDs of MemoryNotes this note consolidates; always non-empty
    supersedes: Set<String>            -- IDs of notes (MEM or SYN) this note replaces
    superseded_by: String?             -- ID of the note that replaced this one; mutable
}

-- A candidate the weekly synthesis scan has dealt with: a dense tag cluster or a
-- highly linked hub note. The record keeps the scan from offering the same
-- candidate week after week. Deleting a record (an operator asking to
-- reconsider a declined candidate) makes it offerable again.
entity SynthesisCandidate {
    group: identity/AgentGroup
    key: String                        -- "tag:<tag>" (tag lower-cased) or "hub:<MEM-id>"
    count: Integer                     -- tag's note count, or hub's inbound links, when last surfaced
    disposition: surfaced | declined | synthesised

    transitions disposition {
        surfaced -> declined           -- the operator does not want this synthesis
        surfaced -> synthesised        -- a SynthesisNote was finalised for it
        synthesised -> surfaced        -- offered again after growing (see SynthesisCandidatesScanned)
        terminal: declined
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Folder of the researcher specialist AgentGroup in this install. Used to
    -- identify researcher tasks in the rules below; v2 has no SpecialistType
    -- entity, so the specialist is identified by its AgentGroup folder.
    researcher_folder: String = "specialists-researcher"

    link_candidates_limit: Integer = 10  -- max notes retrieved as link candidates per new note
    back_link_limit: Integer = 3         -- max existing notes updated with a back-link
    min_link_score: Decimal = 0.5        -- minimum search score for a link candidate
    duplicate_check_limit: Integer = 5   -- max files returned in the pre-dispatch duplicate check
    duplicate_check_score: Decimal = 0.5 -- minimum score for a file to be judged as a potential duplicate
    duplicate_check_source: String = "zettel"        -- the whole Zettelkasten: notes, reports and drafts
    synthesis_scan_schedule: String = "3 9 * * 6"   -- Saturday 09:03
    synthesis_dense_tag_min: Integer = 10            -- notes per tag (case-folded) to qualify as a dense cluster
    synthesis_dense_link_min: Integer = 8            -- inbound links to qualify as a hub
    synthesis_max_candidates: Integer = 5            -- candidates offered per scan, most ripe first
    synthesis_resurface_growth: Decimal = 1.5        -- a surfaced or synthesised candidate returns once its count grows by this factor
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Research Dispatch ----

-- Before dispatching, the main agent checks for existing notes that may cover the
-- same subject. If candidates are found above the duplicate check threshold, they
-- are surfaced to the user before the task is submitted. The user decides whether
-- to proceed (new information may be available) or rely on existing notes.
-- This check is most useful for URL subjects, where exact duplication is likely;
-- for search phrases, later queries on the same topic often warrant fresh investigation.
rule DuplicateCheckPerformed {
    when: MainAgentResearchRequest(group, subject)

    let dup_params = memory/MemorySearchParams{
        limit: config.duplicate_check_limit,
        min_score: config.duplicate_check_score,
        path_prefix: null,
        source: config.duplicate_check_source,
        include_content: null,
        include_superseded: null
    }
    let candidates = memory_hybrid_search(group, subject, dup_params)

    ensures: DuplicateCandidatesSurfaced(group: group, subject: subject, candidates: candidates)

    @guidance
        -- The search covers the whole Zettelkasten (source "zettel"), so an existing
        -- report or synthesis draft on the subject counts as well as a note.
        -- The main agent judges the results itself from their titles and snippets: a
        -- candidate is a file about the same subject, not merely a related one.
        -- DuplicateCandidatesSurfaced is delivered to the user as a message listing the
        -- candidates with their IDs and titles, asking whether to proceed. If there are
        -- none, the agent says so in one line ("checked notes — nothing relevant") and
        -- ResearchDispatched proceeds at once.
        -- For URL subjects, an exact match in a note's sources[].url is a strong duplicate
        -- signal regardless of score.
}

-- The main agent dispatches a research task when the user provides a URL or
-- search phrase to investigate. Fires after DuplicateCheckPerformed; the user
-- may have already been shown existing notes and chosen to proceed.
rule ResearchDispatched {
    when: MainAgentResearchRequest(group, subject)

    let researcher_group = identity/AgentGroup{folder: config.researcher_folder}
    requires: exists researcher_group
    requires: exists researcher_group.specialist

    ensures: specialists/SpecialistTask.created(
        specialist_group: researcher_group,
        prompt: research_prompt(subject),
        requester_group: group,
        requester_task: null,
        requester_session: main_session_for_group(group),
        depth: 0,
        chain_delegation_count: 1,
        ancestor_groups: {},
        is_last_same_type_dispatch: false,
        status: queued,
        dispatched_at: now,
        restart_attempt_count: 0,
        closed_at: null
    )

    @guidance
        -- research_prompt(subject) wraps the subject in a standard instruction to:
        -- investigate from external sources, consult Zotero for prior art, and deliver
        -- a structured report via deliver_specialist_result with commit_to_memory = true.
        -- The prompt must not reference any existing NanoClaw memory notes, reports,
        -- or conversation history — the researcher's isolation depends on this.
        -- subject may be a URL (fetch and analyse), a search phrase (WebSearch),
        -- or a Zotero key (look up locally, then investigate further if needed).
        --
        -- main_session_for_group resolves the long-running main-agent session whose
        -- agent_group is the requesting group. The result is routed back into that
        -- session via specialists.SpecialistResultRoutedToMain when the researcher
        -- delivers (or, if it has closed meanwhile, into the group's current session
        -- for the same conversation); the committed report path lands in
        -- task.committed_files either way.
        --
        -- In practice this rule shares its trigger with DuplicateCheckPerformed.
        -- The two rules are intentionally not mutually exclusive on their requires
        -- clauses; both fire on the same MainAgentResearchRequest and the host
        -- decides whether to proceed with dispatch based on the surfaced candidates.
}

-- ---- Synthesis Workflow ----

-- A weekly scheduled task scans the note graph for tag clusters
-- (synthesis_dense_tag_min+ notes per tag) and hubs (synthesis_dense_link_min+
-- inbound links), then offers up to synthesis_max_candidates of them to the
-- operator, most ripe first. Synthesis notes are human-driven: the scan
-- surfaces candidates only; the operator decides whether to proceed.
-- Each offered candidate is recorded as surfaced, so the scan does not offer
-- it again until it has grown.
rule SynthesisCandidatesScanned {
    when: WeeklySynthesisScan(group)

    requires: group.specialist = null

    let offered = offerable_synthesis_candidates(
        group,
        config.synthesis_dense_tag_min,
        config.synthesis_dense_link_min,
        config.synthesis_resurface_growth,
        config.synthesis_max_candidates
    )
    requires: offered.count > 0

    ensures: SynthesisCandidatesDelivered(group: group, candidates: offered)
    ensures:
        for c in offered:
            let record = SynthesisCandidate{group: group, key: c.key}
            if exists record:
                record.disposition = surfaced
                record.count = c.count
            else:
                SynthesisCandidate.created(
                    group: group,
                    key: c.key,
                    count: c.count,
                    disposition: surfaced
                )

    @guidance
        -- WeeklySynthesisScan fires from a cron scheduled task (config.synthesis_scan_schedule,
        -- currently "3 9 * * 6" — Saturday 09:03).
        -- offerable_synthesis_candidates is a black box over the notes in zettel/notes/
        -- (MEM and SYN): it ranks tag clusters (tags case-folded) and hubs by size and
        -- returns at most the given number, skipping any candidate whose record is
        -- declined, and any whose record is surfaced or synthesised unless its count has
        -- since grown by synthesis_resurface_growth. A hub that a SynthesisNote already
        -- names counts as synthesised.
        -- A pre-check script runs before the agent and computes the candidates; the agent
        -- is only woken when there is at least one to offer. The candidates are recorded
        -- as surfaced once that run's digest exists.
        -- The agent samples notes from the candidates via memory_search and sends the
        -- digest to the operator; it is also written to
        -- zettel/digests/YYYY-MM-DD-synthesis-scan.md.
        -- The agent must NOT write drafts or SynthesisNotes during this step. Its job ends
        -- at identifying candidates; the operator decides whether to proceed.
}

-- The operator answers a scan by declining a candidate: not worth a synthesis,
-- now or later. It is never offered again.
rule SynthesisCandidateDeclined {
    when: OperatorDeclinesSynthesisCandidate(group, candidate_key)

    let record = SynthesisCandidate{group: group, key: candidate_key}
    requires: exists record
    requires: record.disposition = surfaced

    ensures: record.disposition = declined
}

-- When the operator selects a synthesis candidate and requests a draft, the agent
-- consolidates the source notes into a draft SynthesisNote and shares it for review.
-- Each revision produces a new versioned file in zettel/drafts/.
rule SynthesisDraftCreated {
    when: OperatorRequestsSynthesisDraft(group, source_ids, slug)

    requires: for id in source_ids: exists MemoryNote{group: group, id: id}

    let draft_path = "zettel/drafts/DRAFT-SYN-" + date_of(now) + "-" + slug + "-v" + draft_version_for_slug(group, slug) + ".md"

    ensures: SynthesisDraftWritten(group: group, draft_path: draft_path)
    ensures: DraftSharedWithOperator(group: group, draft_path: draft_path)

    @guidance
        -- The draft is written to zettel/drafts/DRAFT-SYN-YYYY-MM-DD-{slug}-vN.md.
        -- Each revision cycle produces a new versioned file (-v2.md, -v3.md, ...);
        -- prior versions are preserved as a record of the editing process.
        -- The draft uses the same frontmatter format as a final SynthesisNote,
        -- including a synthesises: field listing the source_ids.
        -- The agent sends the draft content to the operator for review before finalising.
        -- Known gap: zettel/drafts/ is currently indexed alongside zettel/notes/,
        -- so draft content appears in memory_search results until the indexer excludes that path.
}

-- Once the operator approves a draft, the agent writes the final SynthesisNote to
-- zettel/notes/ and notifies the operator with a link to the new note.
rule SynthesisNoteFinalised {
    when: OperatorApprovesSynthesisDraft(group, source_ids, slug, approved_content, candidate_key?)

    requires: for id in source_ids: exists MemoryNote{group: group, id: id}
    requires: for id in source_ids: MemoryNote{group: group, id: id}.superseded_by = null

    ensures: SynthesisNote.created(
        group: group,
        id: "SYN-" + date_of(now) + "-" + slug,
        title: extract_title(approved_content),
        content: approved_content,
        keywords: extract_keywords(approved_content),
        tags: extract_tags(approved_content) + { "synthesis" },
        links: extract_links(approved_content),
        created: now,
        sources: extract_sources(approved_content),
        synthesises: source_ids,
        supersedes: extract_supersedes(approved_content),
        superseded_by: null
    )
    ensures: UserNotifiedOfSynthesis(
        group: group,
        note_id: "SYN-" + date_of(now) + "-" + slug
    )

    @guidance
        -- The agent writes the final note to zettel/notes/SYN-YYYY-MM-DD-{slug}.md.
        -- Draft files remain in zettel/drafts/ as a record of the editing process.
        -- synthesises holds the source MemoryNote IDs for directed graph edges. links is
        -- the note's own general connectivity, read from its frontmatter: it usually
        -- includes the source notes but need not equal synthesises.
        -- supersedes lists any earlier notes (MEM or SYN) the synthesis replaces;
        -- SynthesisNoteSupersedes marks them.
        -- tags always include "synthesis" by convention.
        -- The host's filesystem watcher picks up the new file within seconds and indexes
        -- it (chunked and embedded) like any MEM note (memory.allium FileDiscovered).
        -- No researcher task is involved; this is a main-agent-only operation.
}

-- Finalising a synthesis for a candidate the scan offered settles that
-- candidate: it is offered again only after it grows.
rule SynthesisCandidateSynthesised {
    when: OperatorApprovesSynthesisDraft(group, source_ids, slug, approved_content, candidate_key?)

    requires: candidate_key != null
    let record = SynthesisCandidate{group: group, key: candidate_key}
    requires: exists record
    requires: record.disposition = surfaced

    ensures: record.disposition = synthesised
}

-- ---- Report and Note Creation ----

-- When the researcher task completes, the host has already committed the report
-- file to zettel/reports/ (via the commit_to_memory flag on deliver_specialist_result;
-- see specialists/SpecialistResultRoutedToMain). The committed paths are recorded
-- on the task's committed_files, and the host names them in the result message it
-- routes to the main agent. The main agent creates a linked MemoryNote from exactly
-- those paths.
rule ReportAndNoteCreated {
    when: task: specialists/SpecialistTask.status becomes completed

    requires: task.specialist_group.folder = config.researcher_folder
    requires: task.requester_group != null
    requires: task.committed_files != null
    requires: task.committed_files.count > 0

    let group = task.requester_group
    let report_path = task.committed_files.first    -- committed path in zettel/reports/
    let slug = slug_from_path(report_path)

    let link_params = memory/MemorySearchParams{
        limit: config.link_candidates_limit,
        min_score: config.min_link_score,
        path_prefix: "groups/" + group.folder + "/zettel/notes/",
        source: null,
        include_content: null,
        include_superseded: null
    }
    let candidates = memory_hybrid_search(group, task.result, link_params)
    let links = extract_link_ids(candidates)

    ensures: MemoryNote.created(
        group: group,
        id: "MEM-" + date_of(task.dispatched_at) + "-" + slug,
        title: extract_title(task.result),
        content: task.result,
        keywords: extract_keywords(task.result),
        tags: extract_tags(task.result),
        links: links,
        created: now,
        sources: { NoteSource{kind: file, path: report_path, mtime: now} },
        supersedes: {},
        superseded_by: null
    )
    ensures: UserNotifiedOfResult(
        group: group,
        note_id: "MEM-" + date_of(task.dispatched_at) + "-" + slug,
        report_path: report_path
    )

    @guidance
        -- The link search leaves superseded notes out (include_superseded unset;
        -- memory.allium MemorySearched): a superseded note takes no new links
        -- (NoNewLinksToSuperseded).
        -- The report file is committed to zettel/reports/ by the host before this rule fires,
        -- as a result of the researcher calling deliver_specialist_result with commit_to_memory = true.
        -- task.committed_files holds the workspace-relative committed paths (e.g.
        -- "zettel/reports/2026-04-08-slug.md"); the first entry is the primary report.
        -- The host appends those paths to the result message it routes to the main agent
        -- (specialists/SpecialistResultRoutedToMain, routed_message_text), and the main
        -- agent writes the note from exactly the paths named there. It never picks "the
        -- newest file in zettel/reports/": with two research tasks overlapping that is
        -- the other task's report.
        -- The main agent does NOT write the report — it reads it from the committed path.
        -- If no session of the main group could receive the result, the report is still
        -- committed (it belongs to the group) but no note is written from it until the
        -- agent comes across it.
        -- link_params.path_prefix is the group's zettel/notes/ prefix as the index stores
        -- paths (groups/<folder>/zettel/notes/); it covers MEM and SYN notes alike.
        -- If the new note replaces an existing one, it lists that note in supersedes
        -- (see SupersedingNoteWritten for the shape); a research note normally replaces
        -- nothing.
        -- slug_from_path extracts the date-slug portion from the report filename.
        -- extract_title, extract_keywords, and extract_tags are LLM calls over task.result
        -- (the inline summary) or over the report file content if task.result is a brief summary.
        -- date_of formats a Timestamp as a YYYY-MM-DD date string.
        -- Writing the report to zettel/reports/ causes memory.allium's FileDiscovered
        -- rule to pick it up; it will be chunked and embedded for future searches.
        -- memory_hybrid_search is the same search used by AgentMemorySearch in memory.allium.
        -- UserNotifiedOfResult is fulfilled by the main agent replying to the user with a
        -- brief summary of what was found and a web UI link to the created note.
        -- This is enforced by the main agent's instructions; the routed result message
        -- itself carries only the result text and the committed paths.
        -- If task.committed_files is null or empty (researcher delivered text only), this rule
        -- does not fire; the main agent may still create a note organically from the inline result.
}

-- Links are directed: a note's links name the notes it points to. A link need
-- not be recorded at the other end. When a note is created, its top
-- back_link_limit links are also recorded the other way - their targets get the
-- new note in their links - so the notes it builds on point forward to it. That
-- is the only retroactive change to existing notes: adding to links is one of
-- the two changes the grow-only note space allows, and context, tags and
-- keywords are never rewritten. A superseded target keeps its links as they were
-- when it was superseded (the record of that point in time) and gets no
-- back-link.
rule BackLinksWritten {
    when: note: MemoryNote.created

    let back_link_targets = top_links(note.links, config.back_link_limit)

    ensures:
        for target_id in back_link_targets:
            let target_mem = MemoryNote{group: note.group, id: target_id}
            let target_syn = SynthesisNote{group: note.group, id: target_id}
            if exists target_mem and target_mem.superseded_by = null:
                target_mem.links.add(note.id)
            if exists target_syn and target_syn.superseded_by = null:
                target_syn.links.add(note.id)

    @guidance
        -- top_links returns the first back_link_limit elements in insertion order, which
        -- corresponds to descending score order from the memory_search that populated note.links.
        -- The update is idempotent: if note.id is already in target.links, no change occurs.
        -- A link target may be a MEM or a SYN note; every target exists (LinksResolve).
        -- A superseded target is not given the back-link: a superseded note takes no
        -- new links (NoNewLinksToSuperseded). The new note's own link to it stays only
        -- if it was made from candidates, which already exclude superseded notes - so
        -- in practice a superseded target does not arise here.
}

-- ---- Supersession ----

-- A note that is wrong, incomplete or out of date is retired the only way the
-- grow-only note space allows: the main agent writes a new note that lists it
-- in supersedes. The old note is not edited beyond superseded_by and not
-- deleted.
rule SupersedingNoteWritten {
    when: MainAgentSupersedesNotes(group, superseded_ids, slug, content)

    requires: group.specialist = null
    requires: superseded_ids.count > 0
    requires:
        for id in superseded_ids:
            exists MemoryNote{group: group, id: id} or exists SynthesisNote{group: group, id: id}

    ensures: MemoryNote.created(
        group: group,
        id: "MEM-" + date_of(now) + "-" + slug,
        title: extract_title(content),
        content: content,
        keywords: extract_keywords(content),
        tags: extract_tags(content),
        links: extract_links(content),
        created: now,
        sources: extract_sources(content),
        supersedes: superseded_ids,
        superseded_by: null
    )

    @guidance
        -- A correction is the typical case: a fact in an existing note turns out to be
        -- wrong, and the new note carries the corrected content with the old note's ID
        -- in supersedes. The new note's body explains what changed.
        -- A synthesis that replaces earlier notes supersedes them the same way, through
        -- SynthesisNoteFinalised.
}

-- Whenever a note that supersedes others is created, each superseded note gets
-- superseded_by - the one other frontmatter change allowed after creation.
rule MemoryNoteSupersedes {
    when: note: MemoryNote.created

    requires: note.supersedes.count > 0

    ensures:
        for id in note.supersedes:
            let old_mem = MemoryNote{group: note.group, id: id}
            let old_syn = SynthesisNote{group: note.group, id: id}
            if exists old_mem:
                old_mem.superseded_by = note.id
            if exists old_syn:
                old_syn.superseded_by = note.id
}

rule SynthesisNoteSupersedes {
    when: note: SynthesisNote.created

    requires: note.supersedes.count > 0

    ensures:
        for id in note.supersedes:
            let old_mem = MemoryNote{group: note.group, id: id}
            let old_syn = SynthesisNote{group: note.group, id: id}
            if exists old_mem:
                old_mem.superseded_by = note.id
            if exists old_syn:
                old_syn.superseded_by = note.id

    @guidance
        -- A superseded note stays in zettel/notes/ and in the search index: it is
        -- the record of what was believed and when. Readers follow superseded_by to
        -- the current note.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Every ID in a note's links array references an existing note (MEM or SYN) in
-- the same group. Notes are never deleted, so a link that once resolved always
-- does; a link to a note made before it was superseded stays valid.
invariant LinksResolve {
    for note in MemoryNotes:
        for id in note.links:
            exists MemoryNote{group: note.group, id: id} or exists SynthesisNote{group: note.group, id: id}
    for note in SynthesisNotes:
        for id in note.links:
            exists MemoryNote{group: note.group, id: id} or exists SynthesisNote{group: note.group, id: id}
}

-- A superseded note takes no new links, in either direction. Every link to it
-- comes from a note that existed when it was superseded, or from the note that
-- superseded it; and every link it holds is to a note that existed by then.
-- superseded_at(group, id) is a black box: the created time of the note named
-- in that note's superseded_by, or null while it is not superseded.
-- created_at(group, id) is a black box: the created time of the note with that
-- id (MEM or SYN).
invariant NoNewLinksToSuperseded {
    for note in MemoryNotes:
        for id in note.links:
            superseded_at(note.group, id) = null
                or note.created <= superseded_at(note.group, id)
                or id in note.supersedes
    for note in SynthesisNotes:
        for id in note.links:
            superseded_at(note.group, id) = null
                or note.created <= superseded_at(note.group, id)
                or id in note.supersedes
    for note in MemoryNotes:
        for id in note.links:
            note.superseded_by = null
                or created_at(note.group, id) <= superseded_at(note.group, note.id)
    for note in SynthesisNotes:
        for id in note.links:
            note.superseded_by = null
                or created_at(note.group, id) <= superseded_at(note.group, note.id)
}

-- Every ID in a SynthesisNote's synthesises array references an existing
-- MemoryNote in the same group. Synthesis edges must not dangle.
invariant SynthesisesResolve {
    for note in SynthesisNotes:
        for id in note.synthesises:
            exists MemoryNote{group: note.group, id: id}
}

-- Supersession is recorded on both sides: every note a note supersedes exists
-- and has superseded_by set, and a superseded_by names an existing note that
-- lists the superseded note in its supersedes.
invariant SupersessionRecordedOnBothSides {
    for note in MemoryNotes:
        for id in note.supersedes:
            MemoryNotes.any(m => m.group = note.group and m.id = id and m.superseded_by != null)
                or SynthesisNotes.any(y => y.group = note.group and y.id = id and y.superseded_by != null)
    for note in SynthesisNotes:
        for id in note.supersedes:
            MemoryNotes.any(m => m.group = note.group and m.id = id and m.superseded_by != null)
                or SynthesisNotes.any(y => y.group = note.group and y.id = id and y.superseded_by != null)
    for note in MemoryNotes:
        note.superseded_by != null implies (
            MemoryNotes.any(m => m.group = note.group and m.id = note.superseded_by and note.id in m.supersedes)
                or SynthesisNotes.any(y => y.group = note.group and y.id = note.superseded_by and note.id in y.supersedes)
        )
    for note in SynthesisNotes:
        note.superseded_by != null implies (
            MemoryNotes.any(m => m.group = note.group and m.id = note.superseded_by and note.id in m.supersedes)
                or SynthesisNotes.any(y => y.group = note.group and y.id = note.superseded_by and note.id in y.supersedes)
        )
}

-- Both MemoryNotes and SynthesisNotes belong to the main group only. The knowledge
-- graph is a single shared resource; specialist groups do not maintain graphs.
-- (In v2 the main group is identified by specialist = null and is_main = true; the
-- knowledge graph predicate uses specialist = null since the graph is also reachable
-- only from non-specialist contexts — see ResearcherKnowledgeIsolation below.)
invariant NotesCreatedByMainAgentOnly {
    for note in MemoryNotes:
        note.group.specialist = null
    for note in SynthesisNotes:
        note.group.specialist = null
}

-- The researcher specialist container has no access to any existing group memory,
-- including previously generated reports. Isolation is total: the researcher must
-- focus solely on the subject it is tasked with investigating, without synthesising
-- comparisons to existing knowledge or prior research.
-- Only the Zotero library (read-only) and the external internet are accessible.
-- The Zotero library is the main group's zotero-md/ folder. That folder belongs to
-- the Zotero sync (zotero.allium): agents, the main agent included, only read it,
-- and every container that is given it mounts it read-only.
--
-- Isolation is a property of what the researcher's container is given, whoever
-- dispatched it: the main agent (a root task) or another specialist (a sub-task -
-- the coder and reviewer may ask it for research). Its container gets its own
-- group folder read-only, the zotero-md/ folder read-only, its own task session,
-- its own provider state and its ipc folders (specialists.allium per-task
-- isolation), plus the internet (WebSearch, WebFetch, agent-browser). It is never
-- given a requester's workspace - zettel/, memory/, conversations/ - nor any
-- group's memory index or memory tools. Files it needs from its requester come
-- only through the dispatch file handover. A sub-task's report goes back to its
-- parent through the parent's ipc-in, not into the main group's zettel/reports/:
-- only a root task's delivery commits to memory (specialists.allium).
--
-- researcher_reaches_group_memory(task) is a black box: true when the container
-- that runs the task can read any group's workspace beyond zotero-md/, or any
-- memory index. The host prevents it by what it mounts; it cannot be observed
-- at runtime.
invariant ResearcherKnowledgeIsolation {
    for task in specialists/SpecialistTasks:
        task.specialist_group.folder = config.researcher_folder
            implies not researcher_reaches_group_memory(task)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- Where this module's triggers come from. The operator talks to the main agent in
-- chat; the agent reads each request and acts on it, so the operator's requests
-- reach these rules through the main agent's session. The weekly scan arrives in
-- that session too, as a scheduled task (scheduling.allium).
surface ZettelkastenWork {
    facing agent: sessions/Session

    provides:
        MainAgentResearchRequest(group, subject) when agent.agent_group.specialist = null
        OperatorRequestsSynthesisDraft(group, source_ids, slug) when agent.agent_group.specialist = null
        OperatorApprovesSynthesisDraft(group, source_ids, slug, approved_content, candidate_key?)
            when agent.agent_group.specialist = null
        OperatorDeclinesSynthesisCandidate(group, candidate_key) when agent.agent_group.specialist = null
        MainAgentSupersedesNotes(group, superseded_ids, slug, content) when agent.agent_group.specialist = null
        WeeklySynthesisScan(group) when agent.agent_group.specialist = null

    @guarantee GrowOnly
        -- The note space in zettel/notes/ is grow-only. After a MemoryNote or
        -- SynthesisNote is created, its body never changes and the only
        -- frontmatter that may change is links (back-links) and superseded_by.
        -- Once a note is superseded its links are frozen too, and no new note
        -- links to it (NoNewLinksToSuperseded).
        -- No note is ever deleted; supersession is the only retirement.
        -- Synthesis drafts in zettel/drafts/ are not notes and may be revised
        -- freely (as new versioned files).

    @guidance
        -- MainAgentResearchRequest: the operator asks the main agent to research a URL,
        -- search phrase or Zotero entry. OperatorRequestsSynthesisDraft,
        -- OperatorDeclinesSynthesisCandidate and OperatorApprovesSynthesisDraft: the
        -- operator's answers to a synthesis scan or a shared draft; candidate_key names
        -- the scan candidate a synthesis was drafted for, when there is one.
        -- MainAgentSupersedesNotes: the main agent decides, from the conversation or
        -- from what it reads, that existing notes are wrong or out of date.
        -- WeeklySynthesisScan: the cron scheduled task at config.synthesis_scan_schedule,
        -- delivered into the main group's session when its pre-check finds candidates.
        -- This is not a tool surface: the agent fulfils these by writing files in its
        -- workspace, which the host indexes (memory.allium).
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

-- allium-ignore allium.deferred.missingLocationHint
deferred Consolidation           -- see: memory-graph-consolidation.allium
                                  -- Automated cluster detection: a scheduled task identifies
                                  -- high-degree MemoryNotes and dense tag clusters, then
                                  -- proposes SynthesisNotes to consolidate each cluster.
                                  -- The SynthesisCandidatesScanned rule implements the manual
                                  -- (human-in-the-loop) version; this deferred spec covers
                                  -- fully automated cluster detection and SynthesisNote
                                  -- creation without operator confirmation. Implements A-MEM's
                                  -- sleep/consolidation mechanism.

-- allium-ignore allium.deferred.missingLocationHint
deferred OrphanDetection         -- see: memory-graph-consolidation.allium
                                  -- Notes with no links after a grace period are flagged
                                  -- for review or re-linking (never deleted: the note
                                  -- space is grow-only).

-- allium-ignore allium.deferred.missingLocationHint
deferred SourceStalenessDetection -- see: memory-graph-staleness.allium
                                  -- Aspirational. A sweep stats every kind = file source
                                  -- and flags notes whose source mtime differs from the
                                  -- NoteSource.mtime recorded at creation, so the agent can
                                  -- write a superseding note. Nothing does this today; the
                                  -- recorded mtime is kept so the sweep can be added.

-- allium-ignore allium.deferred.missingLocationHint
deferred ZoteroSync              -- see: zotero.allium
                                  -- The Zotero database is a directory of per-entry markdown
                                  -- files generated from the Zotero API. Each file is populated
                                  -- with abstract, DOI, summary, and other metadata, including
                                  -- content extracted from associated PDFs. The directory is
                                  -- indexed via the Gemini embedding process and mounted
                                  -- read-only into the researcher container (and potentially
                                  -- other specialist containers). The folder belongs to the
                                  -- Zotero sync; agents only read it.
