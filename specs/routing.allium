-- allium: 3
-- routing.allium
--
-- Scope: Channel-to-agent wiring, inbound message engagement, and routing decisions.
-- Includes: MessagingGroup, Wiring (engagement rules, sender scope, session mode),
--           unknown-sender policy enforcement, messaging group auto-creation,
--           unknown-channel registration approvals.
-- Excludes: User identity (identity.allium), session lifecycle (sessions.allium).
--
-- Wiring is the binding between a MessagingGroup and an AgentGroup. Four axes control
-- which messages reach which agents:
--   engage_mode   — how to test whether a message engages this wiring
--   sender_scope  — which senders are allowed through this wiring
--   ignored_message_policy — what to do with non-triggering messages
--   session_mode  — how session identity is scoped for this wiring

use "./identity.allium" as identity

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ChannelMessage {
    channel_type: String
    platform_id: String
    thread_id: String?
    text: String
    -- sender_id is the namespaced composite "<channel_type>:<platform_handle>"
    -- (e.g. "discord:alan"). The channel adapter is responsible for forming
    -- it from the raw platform metadata before the message reaches routing.
    sender_id: String
    display_name: String
    is_mention: Boolean
    kind: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum UnknownSenderPolicy { strict | request_approval | public }
enum EngageMode { pattern | mention | mention_sticky }
enum SenderScope { all | known }
enum IgnoredMessagePolicy { drop | accumulate }
enum SessionMode { shared | per_thread | agent_shared }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity MessagingGroup {
    id: String
    channel_type: String
    platform_id: String
    name: String
    is_group: Boolean
    unknown_sender_policy: UnknownSenderPolicy
    denied_at: Timestamp?
    created_at: Timestamp

    wirings: Wiring with messaging_group = this
}

entity Wiring {
    messaging_group: MessagingGroup
    agent_group: identity/AgentGroup
    engage_mode: EngageMode
    engage_pattern: String
    sender_scope: SenderScope
    ignored_message_policy: IgnoredMessagePolicy
    session_mode: SessionMode
    priority: Integer
    created_at: Timestamp
}

entity SenderApprovalRequest {
    messaging_group: MessagingGroup
    agent_group: identity/AgentGroup
    sender: identity/User
    original_message: ChannelMessage
    created_at: Timestamp
    status: pending | approved | denied

    transitions status {
        pending -> approved
        pending -> denied
        terminal: approved, denied
    }
}

-- Per-messaging-group request to wire an unknown channel to an agent group.
-- Created when a bot-addressed message lands on a messaging group that has
-- no wiring at all (distinct from SenderApprovalRequest, which assumes a
-- wiring exists but the sender is not yet a member). Resolved by an
-- approver picking 'approve' (creates the wiring + admits the original
-- sender + replays the message) or 'ignore' (denies the messaging group
-- so future mentions stop escalating).

entity ChannelRegistrationRequest {
    messaging_group: MessagingGroup
    agent_group: identity/AgentGroup
    original_message: ChannelMessage
    approver: identity/User
    created_at: Timestamp
    title: String
    options_json: String
    status: pending | approved | ignored

    transitions status {
        pending -> approved
        pending -> ignored
        terminal: approved, ignored
    }

    @guidance
        -- Storage shape: pending_channel_approvals (PRIMARY KEY
        -- messaging_group_id) — see migrations 012 and 013. The PK gives
        -- the "at most one in-flight per messaging group" dedup that
        -- ChannelRegistrationRequested relies on.
        --
        -- The row is deleted on any terminal transition (approved or
        -- ignored), mirroring approvals/PendingApproval. The terminal
        -- status is observable only for the instant the witnessing rule
        -- fires; there is no persistent terminal-state row to query
        -- after the fact. The witnessing rules (ChannelRegistrationApproved
        -- and ChannelRegistrationIgnored) carry all downstream effects in
        -- their own ensures clauses rather than relying on subscribers,
        -- so the disappearing terminal state is not load-bearing for any
        -- chain.
        --
        -- title and options_json carry the rendered card metadata so
        -- the same wording is shown on the initial card and on any
        -- post-click re-render — see migration 013 for the equivalent
        -- columns added to pending_sender_approvals and pending_approvals.
        -- These are presentation artefacts of the chat-sdk integration,
        -- not domain state; they are kept on the entity rather than
        -- recomputed in the response handler so the message text cannot
        -- drift between request and re-render.
        --
        -- approver names a single designated user (the one DM'd by the
        -- request flow). Click-time authorisation accepts either that
        -- approver or any user with admin privilege over agent_group;
        -- this is enforced at the surface boundary, not modelled as a
        -- precondition on the witnessing rules below.
}

entity RoutedMessage {
    wiring: Wiring
    message: ChannelMessage
    sender: identity/User
    trigger: Boolean
    created_at: Timestamp
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    max_wirings_per_messaging_group: Integer = 20
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Every inbound channel message announces its sender so identity rules
-- can register or refresh the sending User. SenderSeen fires once per
-- received message regardless of routing outcome.

rule SenderObserved {
    when: ChannelMessageReceived(message)
    ensures: SenderSeen(
        id: message.sender_id,
        channel_type: message.channel_type,
        display_name: message.display_name
    )
}

-- Messaging groups are auto-created when an @mention is received
-- and no record exists for that channel+platform_id pair.

rule MessagingGroupAutoCreated {
    when: ChannelMessageReceived(message)
    requires: message.is_mention
    requires: not exists MessagingGroup{channel_type: message.channel_type, platform_id: message.platform_id}
    ensures: MessagingGroup.created(
        channel_type: message.channel_type,
        platform_id: message.platform_id,
        name: message.platform_id,
        is_group: false,
        unknown_sender_policy: request_approval,
        created_at: now
    )

    @guidance
        -- The unknown_sender_policy is deliberately hardcoded to request_approval
        -- for auto-created groups. Auto-creation is triggered by an unsolicited
        -- @mention from a previously-unseen party, where neither extreme is safe:
        -- 'strict' would silently drop everything from a sender who has not yet
        -- been registered, and 'public' would let anyone who mentions the bot
        -- through. 'request_approval' surfaces the unknown sender to an admin and
        -- holds the message until a decision is made. No configurable default is
        -- offered: an admin can adjust the policy on the group after wiring.
}

-- Operators explicitly wire a messaging group to an agent group.

rule ChannelWired {
    when: WireChannel(actor, messaging_group, agent_group, engage_mode, engage_pattern,
                      sender_scope, ignored_message_policy, session_mode, priority)
    requires: actor.is_owner or actor.is_global_admin
    requires: not exists Wiring{messaging_group: messaging_group, agent_group: agent_group}
    ensures: Wiring.created(
        messaging_group: messaging_group,
        agent_group: agent_group,
        engage_mode: engage_mode,
        engage_pattern: engage_pattern,
        sender_scope: sender_scope,
        ignored_message_policy: ignored_message_policy,
        session_mode: session_mode,
        priority: priority,
        created_at: now
    )
}

rule ChannelUnwired {
    when: UnwireChannel(actor, wiring)
    requires: actor.is_owner or actor.is_global_admin
    ensures: not exists wiring
}

rule WiringUpdated {
    when: UpdateWiring(actor, wiring, engage_mode?, engage_pattern?, sender_scope?,
                       ignored_message_policy?, session_mode?, priority?)
    requires: actor.is_owner or actor.is_global_admin
    ensures:
        if engage_mode != null: wiring.engage_mode = engage_mode
        if engage_pattern != null: wiring.engage_pattern = engage_pattern
        if sender_scope != null: wiring.sender_scope = sender_scope
        if ignored_message_policy != null: wiring.ignored_message_policy = ignored_message_policy
        if session_mode != null: wiring.session_mode = session_mode
        if priority != null: wiring.priority = priority
}

-- Operators can deny a messaging group, preventing any messages from routing
-- regardless of wiring. Denial is cleared by any subsequent wiring mutation.

rule MessagingGroupDenied {
    when: DenyMessagingGroup(actor, messaging_group)
    requires: actor.is_owner or actor.is_global_admin
    requires: messaging_group.denied_at = null
    ensures:
        messaging_group.denied_at = now
}

rule MessagingGroupUndenied {
    when: UnwireChannel(actor, wiring)
    requires: wiring.messaging_group.denied_at != null
    ensures:
        wiring.messaging_group.denied_at = null
}

-- Inbound message routing.
-- A message is routed to an agent when:
--   (a) the messaging group is not denied
--   (b) a wiring exists whose engage_mode matches the message
--   (c) the sender passes the sender_scope check
-- When the sender is unknown and the messaging group policy = request_approval, the
-- message is dropped and an approval request is created.

rule MessageEngagesAgent {
    when: ChannelMessageReceived(message)
    let mg = MessagingGroup{channel_type: message.channel_type, platform_id: message.platform_id}
    let sender = identity/User{id: message.sender_id}
    requires: exists mg
    requires: exists sender
    requires: mg.denied_at = null

    for wiring in mg.wirings where message_engages(wiring, message):
        requires: sender.can_access(wiring.agent_group)
                  or wiring.sender_scope = all and mg.unknown_sender_policy = public
        ensures: RoutedMessage.created(
            wiring: wiring,
            message: message,
            sender: sender,
            trigger: true,
            created_at: now
        )

    @guidance
        -- engage_mode controls how message_engages(wiring, message) decides
        -- whether this wiring is on the hook for the message:
        --   pattern         — the message text matches engage_pattern.
        --   mention         — the message carries an @mention of the agent.
        --   mention_sticky  — engages on @mention OR when an existing session
        --                     already covers this (agent_group, messaging_group,
        --                     thread_id) triple, so a back-and-forth thread does
        --                     not require re-mentioning on every turn.
        --
        -- 'Existing' for mention_sticky is defined narrowly: a session counts
        -- if and only if there is a Session record with status = active for
        -- the (wiring.agent_group, mg, message.thread_id) triple. status = active
        -- is the sole criterion. Other session attributes (idle vs processing,
        -- heartbeat freshness, container liveness) are deliberately ignored — a
        -- session that has merely gone quiet is still 'existing' for stickiness
        -- purposes; only an explicit close/cleanup that flips status off active
        -- ends stickiness.
        --
        -- Stickiness applies only to group chats. When mg.is_group = false (a
        -- DM), mention_sticky never engages from session presence alone — DMs
        -- fall back to the mention/pattern criterion regardless of any active
        -- session. The intent is that DMs always require an explicit address
        -- so the user can hold parallel conversations with multiple agents in
        -- the same DM channel without one of them silently grabbing every turn.
        --
        -- Fan-out and priority. The 'for wiring in mg.wirings' loop is an
        -- independent fan-out: every wiring on this messaging group whose
        -- engage_mode matches and whose sender check passes produces its own
        -- RoutedMessage. There is no exclusive-first-match semantics, no
        -- stop-after-first-engaging-wiring gate, no winner-takes-all. If three
        -- wirings on the same messaging group all match the same inbound
        -- message, all three agents are routed to in parallel.
        --
        -- wiring.priority controls evaluation order only. Wirings are visited
        -- in descending priority (highest priority first) so any per-message
        -- side effects an implementation performs once-per-message — for
        -- example, an idempotent 'subscribe' call to the channel adapter when
        -- the first mention_sticky wiring engages — happen against the
        -- highest-priority wiring rather than an arbitrary one. Priority
        -- never gates delivery: a lower-priority wiring still receives the
        -- message even when a higher-priority one has already matched.
}

rule MessageAccumulated {
    when: ChannelMessageReceived(message)
    let mg = MessagingGroup{channel_type: message.channel_type, platform_id: message.platform_id}
    let sender = identity/User{id: message.sender_id}
    requires: exists mg
    requires: exists sender
    requires: mg.denied_at = null

    for wiring in mg.wirings where message_engages(wiring, message):
        requires: not sender.can_access(wiring.agent_group)
        requires: mg.unknown_sender_policy != strict
        requires: wiring.ignored_message_policy = accumulate
        ensures: RoutedMessage.created(
            wiring: wiring,
            message: message,
            sender: sender,
            trigger: false,
            created_at: now
        )
}

rule UnknownSenderEscalated {
    when: ChannelMessageReceived(message)
    let mg = MessagingGroup{channel_type: message.channel_type, platform_id: message.platform_id}
    let sender = identity/User{id: message.sender_id}
    let inaccessible_wiring = (mg.wirings where not sender.can_access(agent_group)).first
    requires: exists mg
    requires: exists sender
    requires: mg.denied_at = null
    requires: mg.unknown_sender_policy = request_approval
    requires: for w in mg.wirings: not sender.can_access(w.agent_group)
    requires: not exists SenderApprovalRequest{messaging_group: mg, sender: sender,
                                               status: pending}
    ensures: SenderApprovalRequest.created(
        messaging_group: mg,
        agent_group: inaccessible_wiring.agent_group,
        sender: sender,
        original_message: message,
        created_at: now,
        status: pending
    )

    @guidance
        -- The approval request carries one specific agent_group: the membership
        -- granted on approval is scoped to that group, not to the messaging group
        -- as a whole. The rule's universal precondition guarantees the sender
        -- cannot access ANY wiring on this messaging group, so any inaccessible
        -- wiring is a valid choice; the implementation picks the first one
        -- encountered (currently non-deterministic across wirings, since wirings
        -- is unordered). If multiple agent groups should be grantable from a
        -- single approval, this rule needs a different shape.
}

-- Sender approval flows.

rule SenderApproved {
    when: ApproveSender(actor, request)
    requires: actor.is_owner or actor.is_global_admin
    requires: request.status = pending
    ensures:
        request.status = approved
        AgentGroupMembershipGranted(user: request.sender, agent_group: request.agent_group, messaging_group: request.messaging_group)
}

rule SenderDenied {
    when: DenySender(actor, request)
    requires: actor.is_owner or actor.is_global_admin
    requires: request.status = pending
    ensures: request.status = denied
}

rule BlockedMessageReplayed {
    when: AgentGroupMembershipGranted(user, agent_group, messaging_group)
    let request = SenderApprovalRequest{messaging_group: messaging_group, agent_group: agent_group,
                                        sender: user, status: approved}
    let wiring = Wiring{messaging_group: messaging_group, agent_group: agent_group}
    requires: exists request
    requires: exists wiring
    ensures: RoutedMessage.created(
        wiring: wiring,
        message: request.original_message,
        sender: user,
        trigger: true,
        created_at: now
    )

    @guidance
        -- Models the host-side replay of the originally blocked inbound event
        -- after the sender is admitted. In the implementation this is the
        -- routeInbound(event) call that follows addMember and the deletion of
        -- the pending sender approval. The blocked ChannelMessage is captured
        -- on the SenderApprovalRequest as original_message at the moment of
        -- escalation, so that approval can re-enact the same routing decision
        -- that would have fired had the sender been a member at the time.
}

-- Unknown-channel registration flows.
-- A bot-addressed message on a messaging group with no wirings escalates to
-- an approver, who chooses 'approve' (wire it and replay) or 'ignore' (deny
-- the messaging group so future addresses stop escalating).

rule ChannelRegistrationRequested {
    when: ChannelMessageReceived(message)
    let mg = MessagingGroup{channel_type: message.channel_type, platform_id: message.platform_id}
    let target = (identity/AgentGroups).first
    let chosen_approver = pick_approver(target)
    requires: exists mg
    requires: message.is_mention
    requires: mg.denied_at = null
    requires: mg.wirings.count = 0
    requires: identity/AgentGroups.count > 0
    requires: exists chosen_approver
    requires: not exists ChannelRegistrationRequest{messaging_group: mg, status: pending}
    ensures: ChannelRegistrationRequest.created(
        messaging_group: mg,
        agent_group: target,
        original_message: message,
        approver: chosen_approver,
        created_at: now,
        title: render_channel_card_title(mg),
        options_json: render_channel_card_options(),
        status: pending
    )

    @guidance
        -- 'Bot-addressed' is captured by message.is_mention. The channel SDK
        -- pre-conflates two stimuli into this single flag: an explicit
        -- @mention in a group chat, and any inbound message on a 1:1 DM
        -- channel (where addressing the bot is implicit). The spec does not
        -- carry a separate is_dm field; the conflation lives in the
        -- adapter layer that produces ChannelMessage and is documented
        -- alongside the field declaration.
        --
        -- target agent group selection is MVP: the first AgentGroup by
        -- creation order. There is no UI for the approver to pick a target
        -- yet; multi-agent installs always escalate to the same agent. A
        -- richer card with a target picker is a follow-up (see implementation
        -- notes in src/modules/permissions/channel-approval.ts). When this
        -- changes, the rule's `target` binding will become an approver
        -- choice rather than a deterministic pick.
        --
        -- pick_approver is a black-box selection: prefer scoped admins of
        -- target, then global admins, then owners; within each tier prefer
        -- a user reachable on the same channel as the originating message.
        -- The implementation also rejects approvers without a reachable DM,
        -- silently dropping the registration if none can be reached. That
        -- failure mode is not modelled as a precondition here because the
        -- spec layer does not represent DM reachability; treat the existence
        -- of chosen_approver as the spec-level proxy for "an approver
        -- reachable for this request". See actioning-findings if a
        -- reachability gap is reported.
        --
        -- render_channel_card_title and render_channel_card_options
        -- produce the persisted card metadata. These are presentation
        -- artefacts whose exact wording is not domain logic; they are
        -- captured as black-box renderers so the spec can express that
        -- the same wording is reused for any post-click re-render
        -- without prescribing the wording itself.
        --
        -- Dedup: at most one in-flight (pending) ChannelRegistrationRequest
        -- per messaging group. Subsequent bot-addressed messages on the
        -- same unwired messaging group are silently dropped while a card
        -- is outstanding, preventing approver spam. The DB enforces this
        -- via PRIMARY KEY on messaging_group_id; the invariant
        -- OnePendingChannelRegistrationPerMessagingGroup states the
        -- domain-level property the PK secures.
}

rule ChannelRegistrationApproved {
    when: ApproveChannelRegistration(actor, request)
    let original = request.original_message
    let sender = identity/User{id: original.sender_id}
    requires: actor = request.approver
             or actor.is_owner
             or actor.is_global_admin
             or exists identity/UserRole{user: actor, role: admin, agent_group: request.agent_group}
    requires: request.status = pending
    requires: exists sender
    ensures:
        request.status = approved
        Wiring.created(
            messaging_group: request.messaging_group,
            agent_group: request.agent_group,
            engage_mode: pick_default_engage_mode(original),
            engage_pattern: pick_default_engage_pattern(original),
            sender_scope: known,
            ignored_message_policy: accumulate,
            session_mode: shared,
            priority: 0,
            created_at: now
        )
        identity/AgentGroupMember.created(
            user: sender,
            agent_group: request.agent_group,
            added_by: actor,
            added_at: now
        )
        ChannelMessageReceived(message: original)

    @guidance
        -- The new Wiring uses MVP defaults that match the implementation
        -- in handleChannelApprovalResponse:
        --   - engage_mode/engage_pattern: pick_default_engage_mode(original)
        --     returns mention_sticky for group/threaded chats and pattern
        --     for DMs; pick_default_engage_pattern returns "." for DMs and
        --     null otherwise. The implementation uses the original event's
        --     threadId to make this choice (a non-null thread implies a
        --     group platform), since at this point the messaging_group's
        --     is_group flag may not yet be authoritative.
        --   - sender_scope = known: only members of the agent group reach
        --     it. The original sender is auto-admitted below so the replay
        --     does not bounce into a sender-approval cascade.
        --   - ignored_message_policy = accumulate: non-triggering messages
        --     are still recorded against the session for context.
        --   - session_mode = shared: one session per (agent_group,
        --     messaging_group). Per-thread or agent-shared modes require
        --     an explicit operator decision and are not picked by default.
        --   - priority = 0: no precedence relative to any future wirings
        --     on the same messaging group.
        --
        -- The original sender is added as a member of the target agent
        -- group, not the messaging_group. Membership is per-agent-group;
        -- adding to messaging_group here would not exist as a concept.
        --
        -- The ChannelMessageReceived emission is the spec analogue of the
        -- implementation's routeInbound(original_event) call after wiring
        -- is created. It re-enters the routing pipeline as if the message
        -- had just arrived, this time finding a wiring and a known sender
        -- and producing a RoutedMessage. The request row is deleted before
        -- the replay so the ChannelRegistrationRequested gate on the
        -- replay sees no in-flight request (and the wiring count check
        -- short-circuits anyway).
        --
        -- Click-time authorisation accepts either the designated approver
        -- (the user the card was DM'd to) or any user with admin privilege
        -- over the target agent group. This mirrors the implementation's
        -- isAuthorized check and lets a global admin act on a card
        -- DM'd to a different admin without forcing a re-issue.
        --
        -- Row deletion: ChannelRegistrationRequest is deleted on this
        -- transition. The approved status is observable only for the
        -- instant this rule's effects are computed; no other rule
        -- subscribes to that transition. See the entity-level @guidance.
}

rule ChannelRegistrationIgnored {
    when: IgnoreChannelRegistration(actor, request)
    requires: actor = request.approver
             or actor.is_owner
             or actor.is_global_admin
             or exists identity/UserRole{user: actor, role: admin, agent_group: request.agent_group}
    requires: request.status = pending
    requires: request.messaging_group.denied_at = null
    ensures:
        request.status = ignored
        request.messaging_group.denied_at = now

    @guidance
        -- Ignoring a channel-registration request denies the messaging
        -- group as a whole: no future bot-addressed message on this
        -- messaging group will escalate again until an admin explicitly
        -- wires it (which clears denied_at via WiringUpdated or
        -- ChannelUnwired's MessagingGroupUndenied chain). This is
        -- coarser than rejecting a single SenderApprovalRequest, where
        -- only that specific request is dismissed and future messages
        -- from the same sender can still escalate.
        --
        -- Row deletion follows the same pattern as ChannelRegistrationApproved:
        -- the request row is deleted on this transition. The ignored
        -- status is observable only for the instant this rule fires.
        -- See the entity-level @guidance.
        --
        -- Click-time authorisation accepts the designated approver or
        -- any user with admin privilege over the target agent group,
        -- matching the implementation's isAuthorized check.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant DeniedGroupAcceptsNoMessages {
    -- When a MessagingGroup has denied_at set, no Wiring should route messages.
    -- Enforced by the routing gate; captured here for clarity.
    for r in RoutedMessages:
        r.wiring.messaging_group.denied_at = null
}

invariant OnePendingChannelRegistrationPerMessagingGroup {
    -- At most one ChannelRegistrationRequest may be pending against any
    -- given MessagingGroup at a time. Enforced in storage by PRIMARY KEY
    -- on pending_channel_approvals.messaging_group_id; in the spec this
    -- is the domain property that the dedup precondition on
    -- ChannelRegistrationRequested secures. Terminal-status rows are
    -- deleted, so the assertion is equivalent to "at most one
    -- ChannelRegistrationRequest per messaging group, full stop".
    for a in ChannelRegistrationRequests:
        for b in ChannelRegistrationRequests:
            a != b and a.status = pending and b.status = pending
                implies a.messaging_group != b.messaging_group
}

