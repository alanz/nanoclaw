-- allium: 3
-- specialists.allium
--
-- Scope: Specialist orchestration — AgentGroups designated as typed task workers
--        dispatched by the main group. A specialist is an AgentGroup that has a
--        Specialist row in identity.allium.
-- Includes: SpecialistTask lifecycle, delegation from main group, sub-task dispatch,
--           chain limit enforcement (depth/count/same-type), memory provider
--           bypass, result routing back to requester, overall task timeout,
--           per-task session provisioning, container crash/restart recovery,
--           the root requester a task's progress messages and questions reach.
--           (Relaying those messages is null-channel.allium; results still
--           travel only by result routing below.)
-- Excludes: AgentGroup / Specialist registration (identity.allium), session lifecycle
--           (sessions.allium), agent-to-agent messaging infra (agent-to-agent.allium).

use "./identity.allium" as identity
use "./sessions.allium" as sessions
use "./agent-to-agent.allium" as a2a
use "./routing.allium" as routing
use "./null-channel.allium" as null_channel

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The boundary between an agent container's MCP tool layer and the host.
-- The agent (a main-group or specialist container) calls these tools and
-- the host receives the request as an external stimulus on the rules
-- below. The surface enumerates only the agent-initiated entry points;
-- host-emitted system events (e.g. SpecialistContainerProcessing,
-- SpecialistContainerBootFailed, AgentGroupDeletionRequested,
-- HostTookOwnership, IpcInPopulated, ContainerInvocationStarted /
-- ContainerInvocationEnded) are internal to the host and do not cross
-- this boundary.

surface SpecialistMcpTools {
    facing agent: sessions/Session

    provides:
        AgentRequestsDispatchSpecialist(agent, specialist_group_id, prompt, file_paths?)
        AgentRequestsDispatchSubTask(agent, specialist_group_id, prompt, file_paths?)
        AgentRequestsDeliverSpecialistResult(agent, result_text, file_paths?, commit_to_memory?)
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum SpecialistTaskStatus {
    queued | running | awaiting_sub_task | awaiting_restart | completed | failed
}

-- boot_failure: the task container never started (a bounded boot crash).
-- group_deleted: the task specialist group, or its requesting group, was deleted.
enum SpecialistFailureKind {
    depth_exceeded | count_exceeded
    | same_type_limit_exceeded | timeout | execution_error | host_restart
    | boot_failure | group_deleted
}

enum IpcMountStatus { active | cleared }

enum TransferStatus {
    pending     -- host has taken ownership; awaiting recipient invocation
    | in_transit -- recipient invocation has started; files placed in its ipc-in
    | committed  -- files were committed to the requester group's memory area
    | expired    -- transfer no longer needed; staging copies may be reclaimed
}

enum TransferFileStatus {
    owned    -- host has taken ownership; copied to host-managed storage
    | placed -- in the recipient invocation's ipc-in mount
    | expired -- recipient task is terminal; storage may be reclaimed
}

-- Which way a transfer travels along the dispatch chain. result: a
-- specialist's delivery back to its requester. dispatch: files handed to a
-- specialist with the task that dispatches it. returned: files given back
-- to the agent that named them, because its dispatch was refused or the
-- task it handed them to failed.
enum TransferKind { result | dispatch | returned }

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value TaskFailure {
    kind: SpecialistFailureKind
    detail: String
}

-- One run of a container, identified by a unique id assigned by the host at
-- start time. A specialist task may span multiple invocations: an initial
-- start, plus one re-invocation per sub-task result it consumes. A main-group
-- container run is also a single invocation. Invocations are the unit of
-- per-run isolation for ipc-out and ipc-in: each invocation gets a fresh,
-- empty ipc-out and an ipc-in populated only with the files staged for it.
value Invocation {
    id: String
    session: sessions/Session   -- the session whose container is running this invocation
    task: SpecialistTask?       -- non-null when the invocation is for a specialist task
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    max_specialist_depth: Integer = 5
    max_chain_delegations: Integer = 20
    max_same_type_dispatches: Integer = 3
    max_task_duration: Duration = 4.hours
    max_sub_task_await: Duration = 30.minutes
    max_restart_retries: Integer = 2
    default_last_turn_sub_notice: String = "[Final iteration: this is your last opportunity to respond. Provide your best conclusive output as no further iterations will occur.]"
    default_last_turn_parent_notice: String = "[Final iteration: no further responses will follow from this specialist. Incorporate this as your final input and conclude your work.]"
    -- Container-side mount points for the per-invocation file-handover area.
    -- ipc_out is the staging area the specialist writes files to before delivery;
    -- ipc_in is the area the host populates with files staged by other invocations
    -- whose transfers target this one. Mounts are managed by the host: ipc_out is
    -- read-write to the container, ipc_in is read-only.
    ipc_out_container_path: String = "/workspace/ipc-out"
    ipc_in_container_path: String = "/workspace/ipc-in"
    -- Path inside a group's workspace where committed memory files are placed.
    -- Resolved against requester_group.folder when commit_to_memory is true.
    -- The requester's Zettelkasten (see memory-graph.allium): reports are the
    -- sources its notes are written from.
    memory_reports_subpath: String = "zettel/reports"
    -- Path inside the root requester group's workspace where the host parks
    -- files that have nowhere left to go (see TransferParked), one
    -- subdirectory per transfer.
    orphan_subpath: String = "handover-orphans"
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A SpecialistTask records one dispatch into a specialist agent group. Root
-- tasks are dispatched by the main group (requester_group set, requester_task
-- null). Sub-tasks are dispatched by another specialist (requester_task set,
-- requester_group null). A task moves from queued (recorded by the host)
-- through running (the specialist's container is processing the prompt) to
-- either completed (the specialist returned a result) or failed (timeout,
-- chain-policy rejection or execution error). awaiting_sub_task is the
-- intermediate state held while the specialist's own dispatch_sub_task call
-- is being processed by a child task; the parent resumes to running once the
-- child's result is routed back.

entity SpecialistTask {
    id: String
    specialist_group: identity/AgentGroup
    prompt: String
    requester_group: identity/AgentGroup?
    requester_task: SpecialistTask?
    -- The session that dispatched this task. For root tasks this is the
    -- main-agent session that receives the result; for sub-tasks this is
    -- the parent specialist's per-task session. Result routing for sub-
    -- tasks follows requester_task, not this field.
    requester_session: sessions/Session
    depth: Integer
    chain_delegation_count: Integer
    -- The specialist groups of the tasks above this one, root first: the
    -- group of each ancestor task in dispatch order. Ordered, and a group
    -- repeats when a specialist dispatches to its own group (a researcher
    -- splitting its work into chunks): depth always equals its length.
    ancestor_groups: List<identity/AgentGroup>
    is_last_same_type_dispatch: Boolean
    status: SpecialistTaskStatus
    dispatched_at: Timestamp
    restart_attempt_count: Integer
    closed_at: Timestamp?

    pending_sub_task: SpecialistTask when status = awaiting_sub_task
    result: String when status = completed
    -- Workspace-relative paths of files committed to the requester group's
    -- memory area when the specialist delivered with commit_to_memory = true.
    -- Empty when the specialist delivered text only or staged files to ipc-in.
    committed_files: List<String>? when status = completed
    failure: TaskFailure when status = failed

    -- The session that dispatched the root of this task's chain: the
    -- main-agent session the user is talking to. Progress messages and
    -- questions from any task in the chain are relayed to this session's
    -- chat (null-channel.allium SpecialistProgressRelayed,
    -- SpecialistCardRelayed).
    root_requester_session: if requester_task = null: requester_session
                            else: requester_task.root_requester_session

    is_overdue: status in {queued, running, awaiting_sub_task, awaiting_restart}
                and now - dispatched_at > config.max_task_duration
    sub_task_await_overdue: status = awaiting_sub_task
                            and pending_sub_task != null
                            and (pending_sub_task.dispatched_at + config.max_sub_task_await) <= now

    transitions status {
        queued -> running
        queued -> failed
        running -> awaiting_sub_task
        running -> awaiting_restart
        running -> completed
        running -> failed
        awaiting_sub_task -> awaiting_restart
        awaiting_sub_task -> running
        awaiting_sub_task -> failed
        awaiting_restart -> running
        awaiting_restart -> failed
        terminal: completed, failed
    }

    invariant ExactlyOneRequester {
        (requester_group != null) != (requester_task != null)
    }

    invariant DepthMatchesAncestorCount {
        depth = ancestor_groups.count
    }

    invariant SpecialistGroupMustBeSpecialist {
        exists specialist_group.specialist
    }
}

-- ---------------------------------------------------------------
-- File handover: per-invocation ipc-out / ipc-in mounts and transfers
-- ---------------------------------------------------------------
--
-- Specialists may return files alongside their textual result. The handover
-- is mediated by two host-managed mounts:
--
--   ipc_out_container_path  (read-write)  the running container writes files here
--   ipc_in_container_path   (read-only)   the host populates here before start
--
-- When a specialist calls deliver_specialist_result with file_paths, the host
-- takes ownership of those files (copies them to host-managed storage; the
-- originals stay in ipc-out until it is cleared at invocation end) and
-- records the handover as a ContainerTransfer
-- with one TransferFile per path. The transfer's downstream behaviour
-- depends on commit_to_memory (carried on the transfer):
--
--   commit_to_memory = true  files are copied into the requester group's
--                            workspace under memory_reports_subpath; the
--                            committed paths are recorded on the parent task
--                            as committed_files. The result text is path-
--                            rewritten so the requester reads the memory
--                            paths, not the original ipc-out paths.
--   commit_to_memory = false files are placed under ipc_in_container_path
--                            in the requester invocation's ipc-in mount on
--                            its next start. The result text is path-rewritten
--                            to reference the in-container ipc-in paths.
--
-- Routing (root vs sub-task) chooses the requester invocation; the file-
-- handover lifecycle is the same in both cases.
--
-- Files also travel the other way, with a dispatch. dispatch_specialist and
-- dispatch_sub_task take optional file_paths in the dispatcher's own ipc-out,
-- under the same rules as a delivery. The host takes ownership of them when
-- it processes the dispatch and records a ContainerTransfer of kind dispatch
-- for the new task. The files are placed in the dispatched task's ipc-in
-- when its container starts, and the prompt it reads names their ipc-in
-- paths. They stay available to that task for its whole life - across
-- restarts and across the re-invocations that follow its own sub-tasks.
-- When the task completes they have been used and expire; when it fails
-- they go back to the dispatcher (see below). A dispatch transfer never
-- commits to memory.
--
-- Host ownership of named files. A file an agent names in the file_paths
-- of dispatch_specialist, dispatch_sub_task or deliver_specialist_result is
-- the host's responsibility from the moment the call is made. The agent may
-- end its turn and its container may exit at once; the host guarantees the
-- file is not lost:
--
--   * The host takes ownership before the calling invocation's ipc-out is
--     cleared, however that invocation ends - container exit, orphan
--     recovery, a host restart (the handover_calls_handled guard on
--     InvocationEnded and OrphanInvocationEnded).
--   * A refused dispatch gives its files back to the dispatcher
--     (RefusedDispatchFilesReturned); a dispatched task that fails gives
--     back the files it was handed (DispatchedFilesReturnedOnTaskFailed).
--   * Files that can no longer reach anyone - their recipient is gone or
--     will never read them - are parked in the root requester's workspace
--     under orphan_subpath (TransferParked) instead of being discarded.
--
-- So a named file ends in exactly one of: read by its recipient (placed in
-- its ipc-in), committed to memory, or parked (invariant
-- NamedFilesNeverLost). Files left in ipc-out that no call named are
-- scratch and are discarded when the invocation ends.
--
-- This is how a file the user sent the main agent (a PDF attached to a chat
-- message, say) reaches a specialist: the main agent copies it into its
-- ipc-out and dispatches with its path. A specialist's container mounts only
-- its own group folder and its per-task session, so a path in the
-- dispatcher's workspace means nothing to it.

-- The outbound staging area for one invocation. Created fresh by the host
-- when the invocation starts; cleared when the invocation ends. Files
-- written here are immediate-staging only; files not consumed by a delivery
-- are discarded at invocation end.
entity IpcOutMount {
    invocation: Invocation
    status: IpcMountStatus

    transitions status {
        active -> cleared
        terminal: cleared
    }
}

-- The inbound staging area for one invocation. Created and populated by the
-- host immediately before the container process begins. Contains only files
-- explicitly placed there for transfers targeting this invocation. Cleared
-- by the host at invocation end.
entity IpcInMount {
    invocation: Invocation
    status: IpcMountStatus

    transitions status {
        active -> cleared
        terminal: cleared
    }
}

-- A file-handover bundle. A result transfer goes from a specialist task back
-- to its requester: it carries zero or more files plus the accompanying
-- result text and the commit_to_memory flag that determines whether the
-- files end up in the requester group's memory area or in the requester
-- invocation's ipc-in. One result transfer per delivery; multiple deliveries
-- within a single task are not modelled (the deliver tool is fire-and-forget
-- and exits the container). A dispatch transfer goes from a dispatcher (the
-- main agent or a parent specialist) to the task it dispatches: one per
-- dispatch that names files, placed only in that task's ipc-in. Its text is
-- the dispatched task's prompt, so it carries none of its own. A returned
-- transfer gives files back to the session that named them: a refused
-- dispatch's files (RefusedDispatchFilesReturned), or the files a failed
-- task was handed (DispatchedFilesReturnedOnTaskFailed). Its text is the
-- message that tells the agent, so it carries none of its own either.
entity ContainerTransfer {
    kind: TransferKind
    task: SpecialistTask when kind = result              -- the delivering task
    dispatched_task: SpecialistTask when kind = dispatch -- the task the files go to
    returned_to: sessions/Session when kind = returned   -- the session that named the files
    -- For a returned transfer: the failed task whose files these were, or
    -- null when they come back from a refused dispatch.
    failed_task: SpecialistTask? when kind = returned
    -- Set on a dispatch transfer whose files were given back when its task
    -- failed: the returned transfer now carrying them.
    returned_as: ContainerTransfer?
    sender_invocation: Invocation     -- the specific invocation that wrote ipc-out
    result_text: String when kind = result -- the rewritten result text the requester sees
    commit_to_memory: Boolean
    file_count: Integer
    sent_at: Timestamp
    status: TransferStatus
    -- The inbound message that carried this transfer's result to a
    -- main-agent requester; set when a root-task result with files staged
    -- for ipc-in is routed (see SpecialistResultRoutedToMain), or when a
    -- returned transfer's notice is written to a session with no task. Its
    -- handling is what expires the transfer (TransferExpiredOnRoutedMessageCompleted
    -- / ...Failed). Null for a transfer committed to memory, which expires
    -- at once, and for transfers to a specialist task's session, which expire
    -- with that task.
    routed_message: sessions/InboundMessage?

    files: TransferFile with transfer = this

    transitions status {
        pending -> in_transit       -- placed into the requester invocation's ipc-in
        pending -> committed        -- files committed to memory; no ipc-in placement
        pending -> expired          -- parked (TransferOrphaned), handed on as a returned transfer, or a dispatch whose task completed
        in_transit -> pending       -- recipient invocation ended before its task reached terminal; re-stage on next invocation
        in_transit -> expired       -- requester task reached terminal state
        committed -> expired        -- staging copies reclaimed; memory copies persist
        terminal: expired
    }
}

-- One file in a ContainerTransfer. The host records the file's original
-- ipc-out name, the host-managed storage path it was copied to, and (when
-- the transfer commits to memory) the workspace-relative final path under
-- the requester group's memory_reports_subpath.
entity TransferFile {
    transfer: ContainerTransfer
    original_name: String     -- file name as written into ipc-out
    host_path: String         -- absolute path in host-managed storage after ownership transfer
    status: TransferFileStatus

    -- Workspace-relative path under the requester group's folder when the
    -- transfer committed to memory; null otherwise. Set on the commit path
    -- so memory placements can be recorded once and persist after the
    -- transfer expires (the memory copy survives staging cleanup).
    memory_path: String?

    -- Workspace-relative path under the root requester group's folder when
    -- the file was parked because nothing could read it any more
    -- (TransferParked); null otherwise. Like memory_path, the copy outlives
    -- the transfer.
    parked_path: String?

    -- True once the file has been placed in a recipient's ipc-in. A later
    -- reset to owned (the recipient's run ended early) leaves it true: the
    -- file stays owed to that recipient, but it has reached it.
    reached_recipient: Boolean

    transitions status {
        owned -> placed
        owned -> expired            -- never placed: committed to memory, or parked
        placed -> owned             -- recipient invocation ended before its task reached terminal; re-place on next invocation
        placed -> expired
        terminal: expired
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

------------------------------------------------------------
-- Root dispatch (main group -> specialist)
------------------------------------------------------------

-- The main group's agent calls dispatch_specialist. The host creates a
-- SpecialistTask and provisions a fresh per-task Session keyed on the task
-- id (messaging_group = null, thread_id = task.id). The task prompt is
-- written as the triggering inbound message into that session. The
-- specialist's AgentGroup folder is mounted read-only into its container;
-- the per-task session DBs are the only mutable surfaces. Files the main
-- agent names in file_paths are handed to the task (DispatchFilesTaken).

rule MainGroupDispatchesSpecialist {
    when: AgentRequestsDispatchSpecialist(session, specialist_group_id, prompt, file_paths?)
    requires: session.agent_group.is_main = true
    let target_group = identity/AgentGroup{id: specialist_group_id}
    requires: exists target_group
    requires: exists target_group.specialist
    let null_mg = routing/MessagingGroup{
        channel_type: null_channel/config.channel_type,
        platform_id: null_channel/config.singleton_platform_id
    }
    requires: exists null_mg
    let has_files = file_paths != null and file_paths.count > 0
    ensures:
        let task = SpecialistTask.created(
            specialist_group: target_group,
            prompt: prompt,
            requester_group: session.agent_group,
            requester_task: null,
            requester_session: session,
            depth: 0,
            chain_delegation_count: 1,
            ancestor_groups: [],
            is_last_same_type_dispatch: false,
            status: queued,
            dispatched_at: now,
            restart_attempt_count: 0,
            closed_at: null
        )
        let task_session = sessions/Session.created(
            agent_group: target_group,
            messaging_group: null_mg,
            thread_id: task.id,
            status: active,
            processing_state: idle,
            last_active: now,
            created_at: now
        )
        if has_files:
            DispatchFilesTaken(session: session, task: task, file_paths: file_paths)
        sessions/InboundMessage.created(
            session: task_session,
            seq: next_inbound_seq(task_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: dispatched_prompt(prompt, task, file_paths),
            process_after: null,
            tries: 0,
            created_at: now
        )
        task.prompt = dispatched_prompt(prompt, task, file_paths)
        sessions/SessionWoken(session: task_session)

    @guidance
        -- dispatched_prompt(prompt, task, file_paths) is a black box: the
        -- prompt as the specialist reads it. With no file_paths it is the
        -- prompt unchanged. With a dispatch transfer, each reference to a handed-over
        -- ipc-out path is rewritten to the path the specialist will see,
        --   "{ipc_in_container_path}/{transfer_id}/<delivered name>"
        -- and the prompt ends with a list of the files it was given, so a
        -- file is found even when the dispatcher did not mention its path.
        -- A path that was refused (see DispatchFilesTransferred) is named at
        -- the end as "[Not delivered: <path> (<reason>); ...]" - with or
        -- without a transfer.
        --
        -- The task records the dispatched prompt, not the dispatcher's text:
        -- the stored prompt is what a restarted task is sent again (as with
        -- the last-turn notice on a sub-task), and a restart needs the ipc-in
        -- paths. Anything that shows a task's prompt shows that text.
        --
        -- The note to the dispatcher (below) names refused paths the same
        -- way, so the main agent learns of a lost file without waiting for
        -- the specialist to report it.
        --
        -- The dispatcher's session also gets a context-only note, "Specialist
        -- task dispatched (id: <task id>). Result will arrive as a follow-up
        -- message." - an InboundMessage with trigger = false, so it wakes
        -- nothing. The dispatch tool has already told the agent; a triggering
        -- note started a turn of its own after the agent replied. The task id
        -- stays in view with the agent's next message, so the result can be
        -- matched to its dispatch. A sub-task dispatch writes no such note:
        -- the parent specialist exits on dispatch and has one sub-task at a
        -- time, and the result it resumes with names the task it answers.
        -- When the dispatch refused a file path, the note ends with the
        -- same "[Not delivered: ...]" list the specialist's prompt carries.
}

-- A root dispatch the host cannot carry out - the caller is not the main
-- group, the target group is missing or is not a specialist, or there is
-- no null channel for task sessions - creates no task. The dispatcher is
-- told why, and the files it named go back to it.

rule MainDispatchRefused {
    when: AgentRequestsDispatchSpecialist(session, specialist_group_id, prompt, file_paths?)
    requires: not root_dispatch_possible(session, specialist_group_id)
    let has_files = file_paths != null and file_paths.count > 0
    let reason = root_dispatch_refusal(session, specialist_group_id)
    ensures:
        if has_files:
            DispatchFilesReturned(session: session, file_paths: file_paths, notice: reason)
        else:
            a2a/AgentNotified(session: session, text: reason)

    @guidance
        -- root_dispatch_possible(session, specialist_group_id) is a black
        -- box: true exactly when every requires clause of
        -- MainGroupDispatchesSpecialist holds, so the two rules are
        -- exclusive. root_dispatch_refusal names the first clause that
        -- fails, as "dispatch_specialist failed: <why>".
}

-- A sub-task dispatch the host cannot carry out for a reason other than
-- the chain limits - the caller is not a specialist or is a memory
-- provider, the target is missing or is not a specialist, the caller has
-- no running task, or there is no null channel - creates no task. As with
-- a root dispatch, the caller is told and its files go back to it.

rule SubTaskDispatchRefused {
    when: AgentRequestsDispatchSubTask(session, specialist_group_id, prompt, file_paths?)
    requires: not sub_task_dispatch_possible(session, specialist_group_id)
    let has_files = file_paths != null and file_paths.count > 0
    let reason = sub_task_dispatch_refusal(session, specialist_group_id)
    ensures:
        if has_files:
            DispatchFilesReturned(session: session, file_paths: file_paths, notice: reason)
        else:
            a2a/AgentNotified(session: session, text: reason)

    @guidance
        -- sub_task_dispatch_possible(session, specialist_group_id) is a
        -- black box: true exactly when the requires clauses shared by
        -- SpecialistDispatchesSubTask, the three SubTaskRejected* rules and
        -- MemoryProviderDispatched hold up to the chain-limit checks, so
        -- this rule and those are exclusive.
}

-- The files of a refused dispatch go back to the session that named them.
-- The host takes ownership exactly as for an accepted dispatch (same
-- validation against the caller's ipc-out), records a returned transfer to
-- the caller, and writes the refusal notice - naming where the files now
-- are - as a triggering message. The caller's files are therefore never
-- lost to the exit that follows a dispatch_sub_task call: they wait in its
-- ipc-in when it is woken with the notice.

rule RefusedDispatchFilesReturned {
    when: DispatchFilesReturned(session, file_paths, notice)
    let invocation = invocation_for_session(session)
    let delivered = deliverable_paths(invocation, file_paths)
    let caller_task = session_task(session)
    let live = active_invocation_for_session(session)
    ensures:
        let message = sessions/InboundMessage.created(
            session: session,
            seq: next_inbound_seq(session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: returned_notice_text(notice, session, file_paths),
            process_after: null,
            tries: 0,
            created_at: now
        )
        if delivered.count > 0:
            let transfer = ContainerTransfer.created(
                kind: returned,
                returned_to: session,
                failed_task: null,
                sender_invocation: invocation,
                commit_to_memory: false,
                file_count: delivered.count,
                sent_at: now,
                status: pending
            )
            HostTookOwnership(
                invocation: invocation,
                transfer: transfer,
                file_paths: delivered
            )
            if not exists caller_task:
                transfer.routed_message = message
            if exists live:
                TransferPlacedLive(transfer: transfer, invocation: live)
        sessions/SessionWoken(session: session)

    @guidance
        -- returned_notice_text is a black box: the notice, then where each
        -- returned file now is ("{ipc_in_container_path}/{transfer_id}/<name>")
        -- and any path that could not be taken, as "[Not delivered: ...]".
        --
        -- A main agent's container is usually still running when its
        -- dispatch is refused, so the files are placed into its live ipc-in
        -- at once (TransferPlacedLive). A parent specialist's
        -- container is on its way out after dispatch_sub_task; if the
        -- placement lands in that run, the run's end resets the transfer to
        -- pending (TransferResetOnRecipientCrash) and the woken run gets the
        -- files again.
}

------------------------------------------------------------
-- Specialist container picks up the task
------------------------------------------------------------

-- When the host begins processing the trigger inbound message inside the
-- specialist's container, the corresponding SpecialistTask transitions from
-- queued (first start) or awaiting_restart (after a crash recovery) to
-- running. SpecialistContainerProcessing is emitted by the host when it
-- observes the task's per-task Session moving into the processing state.
--
-- A request from the task's own container is also evidence that it is
-- processing. When the container calls dispatch_sub_task or
-- deliver_specialist_result while its task is still queued or
-- awaiting_restart (a fast specialist can answer before the host has
-- observed it processing), the host emits SpecialistContainerProcessing
-- first and handles the request after, so the task passes through running
-- and the request rules' running guards hold.

rule SpecialistTaskStarted {
    when: SpecialistContainerProcessing(task)
    requires: task.status in {queued, awaiting_restart}
    ensures:
        task.status = running

    @guidance
        -- A task remains in queued while its specialist's container is
        -- unavailable at dispatch time (image not built, OneCLI agent not
        -- yet provisioned, runtime unreachable) or while it is waiting in
        -- the host's in-memory concurrency queue for a slot to free. The
        -- host retries container startup; the task only leaves queued when
        -- one of the following occurs:
        --   - the container begins processing the trigger inbound message
        --     and this rule fires (queued -> running);
        --   - the container starts and then dies before processing, again
        --     and again, until the host's boot-crash bound trips:
        --     SpecialistBootFailed (queued -> failed, kind = boot_failure);
        --   - the overall task timeout fires via SpecialistTaskTimedOut
        --     (queued -> failed with kind = timeout).
        -- A container that simply cannot be started yet (no slot, runtime
        -- briefly unreachable) is a transient delay, not a failure: the task
        -- waits. A container that does start but crashes during boot every
        -- time is not transient - a broken image or mount would otherwise
        -- hold the task, and its requester, for the full max_task_duration.
        -- execution_error is reserved for failures observed once the
        -- container is processing.
        --
        -- There is no queued -> awaiting_restart transition. Crash
        -- detection (SpecialistContainerCrashed) is gated on
        -- task.status = running and does not consume restart_attempt_count
        -- for a queued task. The presence of a queued task without a
        -- running container is normal — it indicates either a transient
        -- startup delay or a waiting-for-slot condition, neither of which
        -- is a crash.
}

-- Bounded boot crash. The host bounds a session whose container exits
-- during startup, before processing anything: after a run of consecutive
-- fast failures (sessions-level bound; the boot-crash module's threshold) it
-- stops respawning and drops the session's pending work.
-- SpecialistContainerBootFailed(task) is emitted when that bound trips for
-- a specialist task's per-task session. Its container cannot get past boot,
-- so the task fails outright: it does not go to awaiting_restart and
-- consumes no restart_attempt_count (QueuedTaskHasNoRestartAttempts still
-- holds). SpecialistFailureRoutedToRequester then tells the requester at once.
--
-- The task may read as running or awaiting_restart rather than queued: the
-- host judges a container started by sampling whether it is alive, and one
-- that dies a moment into boot is sampled alive (advancing the task to
-- running) yet never seen dead, so crash detection never fires for it. The
-- boot-crash bound is evidence gathered across spawns, not a snapshot, so it
-- decides regardless of the status the sampling left. awaiting_sub_task is
-- excluded: its container is legitimately stopped while the child runs.

rule SpecialistBootFailed {
    when: SpecialistContainerBootFailed(task)
    requires: task.status in {queued, running, awaiting_restart}
    ensures:
        task.status = failed
        task.failure = TaskFailure{
            kind: boot_failure,
            detail: "specialist container failed to start"
        }
        task.closed_at = now
        if task.pending_sub_task != null:
            SubtreeCancelled(task: task.pending_sub_task)

    @guidance
        -- The failure the requester sees carries the container's last
        -- words (the boot-crash bound records why it would not start), so
        -- a broken image or a bad mount is visible without the host logs.
        -- A booting task normally holds no pending sub-task (one awaiting a
        -- sub-task is excluded); any it does hold is cancelled down the
        -- chain, as on the other failure paths, so no child is left running
        -- with no one to read its result.
}

------------------------------------------------------------
-- Sub-task dispatch (specialist -> specialist)
------------------------------------------------------------

-- A running specialist may call dispatch_sub_task to delegate further work
-- to another specialist. Memory providers may not delegate (they are
-- read-only lookups). Four outcomes are possible: depth exceeded, chain
-- count exceeded, same-type count exceeded, or accepted dispatch. The three
-- rejection rules and the accepted-dispatch rule are mutually exclusive on
-- their guards.
--
-- Per-task session: the child task receives its own Session (messaging_group
-- = null, thread_id = child.id), isolating its inbound/outbound DBs from
-- all other tasks and from the type template folder (mounted read-only).
--
-- Last-turn notice: with_last_turn_notice(prompt, target_group, is_last)
-- returns the prompt suffixed with the target specialist's
-- last_turn_sub_notice (falling back to config.default_last_turn_sub_notice)
-- when is_last, and the prompt unchanged otherwise. The result is the task's
-- stored prompt, not just its trigger message, so a restarted child is sent
-- the notice again with its prompt.
--
-- No cycle check: any specialist may dispatch to any other, its own group
-- included (a researcher splitting its work into chunks), and a chain may
-- return to a group met earlier. A parent runs one sub-task at a time, so a
-- chain is a single line, and the depth, chain-count and same-type limits
-- bound every shape of it: a repeating chain spends its budget and is
-- rejected on a limit. append(list, item) is a black box returning list
-- with item added at the end, keeping order and repeats.
--
-- session_task(session) is a black box: the task whose per-task session this
-- is (the session's thread is the task's id). A specialist group can run
-- several tasks at once, so the group alone does not say which task a
-- dispatch or delivery comes from.

rule SpecialistDispatchesSubTask {
    when: AgentRequestsDispatchSubTask(session, specialist_group_id, prompt, file_paths?)
    requires: exists session.agent_group.specialist
    requires: session.agent_group.specialist.is_memory_provider = false
    let target_group = identity/AgentGroup{id: specialist_group_id}
    requires: exists target_group
    requires: exists target_group.specialist
    requires: target_group.specialist.is_memory_provider = false
    let parent_task = session_task(session)
    requires: exists parent_task
    requires: parent_task.status = running
    requires: parent_task.depth + 1 < config.max_specialist_depth
    requires: parent_task.chain_delegation_count < config.max_chain_delegations
    requires: same_type_dispatch_count(parent_task, target_group)
              < config.max_same_type_dispatches
    let is_last = same_type_dispatch_count(parent_task, target_group)
                  = config.max_same_type_dispatches - 1
    let task_prompt = with_last_turn_notice(prompt, target_group, is_last)
    let null_mg = routing/MessagingGroup{
        channel_type: null_channel/config.channel_type,
        platform_id: null_channel/config.singleton_platform_id
    }
    requires: exists null_mg
    let has_files = file_paths != null and file_paths.count > 0
    ensures:
        let child = SpecialistTask.created(
            specialist_group: target_group,
            prompt: task_prompt,
            requester_group: null,
            requester_task: parent_task,
            requester_session: session,
            depth: parent_task.depth + 1,
            chain_delegation_count: parent_task.chain_delegation_count + 1,
            ancestor_groups: append(parent_task.ancestor_groups, parent_task.specialist_group),
            is_last_same_type_dispatch: is_last,
            status: queued,
            dispatched_at: now,
            restart_attempt_count: 0,
            closed_at: null
        )
        parent_task.status = awaiting_sub_task
        parent_task.pending_sub_task = child
        let child_session = sessions/Session.created(
            agent_group: target_group,
            messaging_group: null_mg,
            thread_id: child.id,
            status: active,
            processing_state: idle,
            last_active: now,
            created_at: now
        )
        if has_files:
            DispatchFilesTaken(session: session, task: child, file_paths: file_paths)
        sessions/InboundMessage.created(
            session: child_session,
            seq: next_inbound_seq(child_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: dispatched_prompt(task_prompt, child, file_paths),
            process_after: null,
            tries: 0,
            created_at: now
        )
        child.prompt = dispatched_prompt(task_prompt, child, file_paths)
        sessions/SessionWoken(session: child_session)
}

-- The three rejection rules below hand no files to the rejected task: it
-- never runs. The files go back to the parent instead
-- (RefusedDispatchFilesReturned), because the parent's container exits on
-- dispatch_sub_task whatever the outcome, and its ipc-out with it.
--
-- Depth exceeded: this dispatch would push the chain past max_specialist_depth.

rule SubTaskRejectedDepth {
    when: AgentRequestsDispatchSubTask(session, specialist_group_id, prompt, file_paths?)
    requires: exists session.agent_group.specialist
    requires: session.agent_group.specialist.is_memory_provider = false
    let target_group = identity/AgentGroup{id: specialist_group_id}
    requires: exists target_group
    requires: exists target_group.specialist
    requires: target_group.specialist.is_memory_provider = false
    let parent_task = session_task(session)
    requires: exists parent_task
    requires: parent_task.status = running
    requires: parent_task.depth + 1 >= config.max_specialist_depth
    let has_files = file_paths != null and file_paths.count > 0
    ensures:
        SpecialistTask.created(
            specialist_group: target_group,
            prompt: prompt,
            requester_group: null,
            requester_task: parent_task,
            requester_session: session,
            depth: parent_task.depth + 1,
            chain_delegation_count: parent_task.chain_delegation_count + 1,
            ancestor_groups: append(parent_task.ancestor_groups, parent_task.specialist_group),
            is_last_same_type_dispatch: false,
            status: failed,
            dispatched_at: now,
            closed_at: now,
            failure: TaskFailure{
                kind: depth_exceeded,
                detail: "specialist chain depth limit reached"
            }
        )
        if has_files:
            DispatchFilesReturned(
                session: session,
                file_paths: file_paths,
                notice: "sub-task rejected: depth limit reached"
            )
        else:
            a2a/AgentNotified(
                session: session,
                text: "sub-task rejected: depth limit reached"
            )
}

-- Chain count exceeded: total delegations along this branch would exceed
-- max_chain_delegations.

rule SubTaskRejectedCount {
    when: AgentRequestsDispatchSubTask(session, specialist_group_id, prompt, file_paths?)
    requires: exists session.agent_group.specialist
    requires: session.agent_group.specialist.is_memory_provider = false
    let target_group = identity/AgentGroup{id: specialist_group_id}
    requires: exists target_group
    requires: exists target_group.specialist
    requires: target_group.specialist.is_memory_provider = false
    let parent_task = session_task(session)
    requires: exists parent_task
    requires: parent_task.status = running
    requires: parent_task.depth + 1 < config.max_specialist_depth
    requires: parent_task.chain_delegation_count >= config.max_chain_delegations
    let has_files = file_paths != null and file_paths.count > 0
    ensures:
        SpecialistTask.created(
            specialist_group: target_group,
            prompt: prompt,
            requester_group: null,
            requester_task: parent_task,
            requester_session: session,
            depth: parent_task.depth + 1,
            chain_delegation_count: parent_task.chain_delegation_count + 1,
            ancestor_groups: append(parent_task.ancestor_groups, parent_task.specialist_group),
            is_last_same_type_dispatch: false,
            status: failed,
            dispatched_at: now,
            closed_at: now,
            failure: TaskFailure{
                kind: count_exceeded,
                detail: "specialist chain delegation count limit reached"
            }
        )
        if has_files:
            DispatchFilesReturned(
                session: session,
                file_paths: file_paths,
                notice: "sub-task rejected: chain delegation limit reached"
            )
        else:
            a2a/AgentNotified(
                session: session,
                text: "sub-task rejected: chain delegation limit reached"
            )
}

-- Same-type limit exceeded: parent has already dispatched to this same
-- specialist group max_same_type_dispatches times.

rule SubTaskRejectedSameTypeLimit {
    when: AgentRequestsDispatchSubTask(session, specialist_group_id, prompt, file_paths?)
    requires: exists session.agent_group.specialist
    requires: session.agent_group.specialist.is_memory_provider = false
    let target_group = identity/AgentGroup{id: specialist_group_id}
    requires: exists target_group
    requires: exists target_group.specialist
    requires: target_group.specialist.is_memory_provider = false
    let parent_task = session_task(session)
    requires: exists parent_task
    requires: parent_task.status = running
    requires: parent_task.depth + 1 < config.max_specialist_depth
    requires: parent_task.chain_delegation_count < config.max_chain_delegations
    requires: same_type_dispatch_count(parent_task, target_group)
              >= config.max_same_type_dispatches
    let has_files = file_paths != null and file_paths.count > 0
    ensures:
        SpecialistTask.created(
            specialist_group: target_group,
            prompt: prompt,
            requester_group: null,
            requester_task: parent_task,
            requester_session: session,
            depth: parent_task.depth + 1,
            chain_delegation_count: parent_task.chain_delegation_count + 1,
            ancestor_groups: append(parent_task.ancestor_groups, parent_task.specialist_group),
            is_last_same_type_dispatch: false,
            status: failed,
            dispatched_at: now,
            closed_at: now,
            failure: TaskFailure{
                kind: same_type_limit_exceeded,
                detail: "specialist same-type dispatch limit reached"
            }
        )
        if has_files:
            DispatchFilesReturned(
                session: session,
                file_paths: file_paths,
                notice: "sub-task rejected: same-type dispatch limit reached"
            )
        else:
            a2a/AgentNotified(
                session: session,
                text: "sub-task rejected: same-type dispatch limit reached"
            )
}

-- Memory provider dispatch: bypasses depth/count/same-type checks
-- and is invisible to the chain counters. Memory provider lookups are
-- transparent reads, not true delegations: the child task copies the
-- parent's depth, chain_delegation_count and ancestor_groups unchanged,
-- so a memory provider call neither consumes a delegation slot nor
-- shortens the remaining depth budget. Memory providers are read-only;
-- they cannot themselves delegate (enforced by SpecialistDispatchesSubTask's
-- requesting-side guard and the MemoryProviderDoesNotDelegate invariant).
-- The parent still moves into awaiting_sub_task while the lookup runs.

rule MemoryProviderDispatched {
    when: AgentRequestsDispatchSubTask(session, specialist_group_id, prompt, file_paths?)
    requires: exists session.agent_group.specialist
    requires: session.agent_group.specialist.is_memory_provider = false
    let target_group = identity/AgentGroup{id: specialist_group_id}
    requires: exists target_group
    requires: exists target_group.specialist
    requires: target_group.specialist.is_memory_provider = true
    let parent_task = session_task(session)
    requires: exists parent_task
    requires: parent_task.status = running
    let null_mg = routing/MessagingGroup{
        channel_type: null_channel/config.channel_type,
        platform_id: null_channel/config.singleton_platform_id
    }
    requires: exists null_mg
    let has_files = file_paths != null and file_paths.count > 0
    ensures:
        let child = SpecialistTask.created(
            specialist_group: target_group,
            prompt: prompt,
            requester_group: null,
            requester_task: parent_task,
            requester_session: session,
            depth: parent_task.depth,
            chain_delegation_count: parent_task.chain_delegation_count,
            ancestor_groups: parent_task.ancestor_groups,
            is_last_same_type_dispatch: false,
            status: queued,
            dispatched_at: now,
            restart_attempt_count: 0,
            closed_at: null
        )
        parent_task.status = awaiting_sub_task
        parent_task.pending_sub_task = child
        let child_session = sessions/Session.created(
            agent_group: target_group,
            messaging_group: null_mg,
            thread_id: child.id,
            status: active,
            processing_state: idle,
            last_active: now,
            created_at: now
        )
        if has_files:
            DispatchFilesTaken(session: session, task: child, file_paths: file_paths)
        sessions/InboundMessage.created(
            session: child_session,
            seq: next_inbound_seq(child_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: dispatched_prompt(prompt, child, file_paths),
            process_after: null,
            tries: 0,
            created_at: now
        )
        child.prompt = dispatched_prompt(prompt, child, file_paths)
        sessions/SessionWoken(session: child_session)
}

------------------------------------------------------------
-- Result delivery and routing
------------------------------------------------------------

-- The specialist calls deliver_specialist_result. The host transitions the
-- running task to completed, captures the result text, and emits
-- SpecialistResultReady so the result can be routed back to the requester.
--
-- file_paths and commit_to_memory are optional. When file_paths is non-null
-- and non-empty, the host validates that each path exists under the
-- specialist's ipc-out mount, takes ownership of the files (copies them to
-- host-managed storage), and records a ContainerTransfer plus one
-- TransferFile per delivered path. A path that fails validation (outside
-- ipc-out, missing, not a regular file) is refused rather than failing the
-- delivery: it gets no TransferFile, and the result text the requester
-- reads ends with "[Not delivered: <path> (<reason>); ...]" naming each
-- refused path, so a lost file is never silent. The file-handover
-- lifecycle continues independently of the SpecialistResultReady routing
-- below: routing rules consume the transfer when they place files into the
-- requester's ipc-in or commit them to memory.
--
-- commit_to_memory = null is treated identically to commit_to_memory = false
-- (default behaviour: stage to ipc-in). When commit_to_memory = true and
-- file_paths is null or empty, the flag is ignored and the result is
-- delivered as plain text.
rule SpecialistDeliveredResult {
    when: AgentRequestsDeliverSpecialistResult(session, result_text, file_paths?, commit_to_memory?)
    let task = session_task(session)
    let invocation = invocation_for_session(session)
    let paths = file_paths
    let commit = commit_to_memory ?? false
    requires: exists task
    -- A delivery arriving while the task is still queued or
    -- awaiting_restart is preceded by SpecialistContainerProcessing (see
    -- SpecialistTaskStarted), so the task is running by the time this
    -- rule is evaluated.
    requires: task.status = running
    let resolved_text = resolve_delivery_paths(task, result_text, paths, commit)
    let has_files = paths != null and paths.count > 0
    ensures:
        task.status = completed
        task.result = resolved_text
        task.closed_at = now
        if has_files:
            let transfer = ContainerTransfer.created(
                kind: result,
                task: task,
                sender_invocation: invocation,
                result_text: resolved_text,
                commit_to_memory: commit,
                file_count: paths.count,
                sent_at: now,
                status: pending
            )
            HostTookOwnership(
                invocation: invocation,
                transfer: transfer,
                file_paths: paths
            )
        SpecialistResultReady(task: task)

    @guidance
        -- resolve_delivery_paths is a black box function. It returns the
        -- result_text with any references to ipc-out paths rewritten to the
        -- paths the requester will see:
        --   commit_to_memory = true   ipc-out paths -> "{memory_reports_subpath}/<basename>"
        --                             relative to the requester group's workspace
        --   commit_to_memory = false  ipc-out paths -> "{ipc_in_container_path}/{transfer_id}/<basename>"
        --                             as the requester's container will see them
        -- When file_paths is null or empty, resolved_text = result_text unchanged.
        -- When any path is refused, resolved_text also ends with the
        -- "[Not delivered: ...]" note, and paths / file_count cover only the
        -- delivered files.
        --
        -- HostTookOwnership is a per-file action emitted as a system event:
        -- for each path p in file_paths, the host copies the file from ipc-out
        -- to host-managed storage and creates a TransferFile(transfer, original_name:
        -- basename(p), host_path: <storage>, status: owned). The originals are
        -- left in ipc-out, which is cleared at invocation end; the rule
        -- TransferFilesOwned below witnesses the staged -> owned transition
        -- for each file.
        --
        -- invocation_for_session resolves the current Invocation for the
        -- specialist's session (the one that wrote ipc-out). It is the same
        -- invocation that emitted SpecialistContainerProcessing earlier.
        --
        -- Sub-task commit_to_memory degradation. When commit_to_memory = true
        -- and the task is a sub-task (task.requester_task != null,
        -- task.requester_group = null), resolve_delivery_paths silently
        -- degrades: it treats commit_to_memory as false and rewrites ipc-out
        -- paths to ipc-in paths instead of memory paths. The files are staged
        -- to the parent's ipc-in via the normal in_transit path; no error is
        -- returned to the specialist.
        --
        -- This is intentional. Specialists are designed to be composable and
        -- should not need to know their position in the dispatch chain. A
        -- specialist that prefers commit_to_memory = true will still have its
        -- files delivered; they just land in the parent's ipc-in rather than
        -- the main group's memory area. Rejecting commit_to_memory on sub-task
        -- deliveries with a structured error would couple specialist behaviour
        -- to chain position and break composability.
        --
        -- Only root-task deliveries (task.requester_group != null) can commit
        -- files to memory. SpecialistResultRoutedToMain is the only place
        -- where commit_to_memory = true takes effect; it copies files into the
        -- requester group's memory area and records the workspace-relative
        -- paths on the task's committed_files. SpecialistResultRoutedToParent
        -- never commits to memory (the parent specialist is not a memory-area
        -- owner).
}

-- The host has taken ownership of staged files. This rule witnesses the
-- file-by-file transition emitted via HostTookOwnership. It does not
-- describe the underlying copy and unlink operations — those are the host's
-- responsibility — but it captures the resulting TransferFile records and
-- their owned status.
rule TransferFilesOwned {
    when: HostTookOwnership(invocation, transfer, file_paths)
    for path in file_paths:
        ensures: TransferFile.created(
            transfer: transfer,
            original_name: delivered_name(transfer, path),
            host_path: host_storage_path(invocation, path),
            status: owned,
            memory_path: null,
            parked_path: null,
            reached_recipient: false
        )

    @guidance
        -- file_paths here are the delivered files, each once: a path listed
        -- twice (or two spellings of one file, absolute and relative) is one
        -- file, and every listed spelling is rewritten to it in the result
        -- text. delivered_name(transfer, path) is the file's basename, made
        -- unique within the transfer by numbering a repeat before its
        -- extension (report.md, report-2.md), so IpcInPathsUniquePerTransfer
        -- holds and two files of one name both arrive. host_storage_path is
        -- a black box mapping an ipc-out path to a stable host-managed
        -- storage path keyed on the originating invocation. Ownership passes
        -- by copy: the host does not remove the originals from ipc-out,
        -- because ipc-out is cleared at invocation end (see InvocationEnded)
        -- and the deliver tool ends the invocation.
}

-- A dispatch that names files hands them to the task it creates. The host
-- validates each path against the dispatcher's ipc-out exactly as it does
-- for a delivery (outside ipc-out, missing, or not a regular file: refused,
-- never failing the dispatch), takes ownership of the rest by copy, and
-- records a dispatch transfer for the task. The transfer is pending until
-- the task's first container starts and IpcInPopulated places its files
-- (TransferFilesPlaced, TransferMovedToInTransit).

rule DispatchFilesTransferred {
    when: DispatchFilesTaken(session, task, file_paths)
    let invocation = invocation_for_session(session)
    let delivered = deliverable_paths(invocation, file_paths)
    requires: delivered.count > 0
    ensures:
        let transfer = ContainerTransfer.created(
            kind: dispatch,
            dispatched_task: task,
            sender_invocation: invocation,
            commit_to_memory: false,
            file_count: delivered.count,
            sent_at: now,
            status: pending
        )
        HostTookOwnership(
            invocation: invocation,
            transfer: transfer,
            file_paths: delivered
        )

    @guidance
        -- deliverable_paths(invocation, paths) is a black box: the listed
        -- paths that pass validation against the invocation's ipc-out, each
        -- file once (as in TransferFilesOwned). When none pass, no transfer
        -- is created; dispatched_prompt and the dispatcher's note still name
        -- every refused path. A refused path is one the host could not take
        -- at all (outside ipc-out, missing, not a regular file), so it is
        -- outside the host's guarantee; it is named, never silently dropped.
        --
        -- Ownership is taken before the dispatcher's ipc-out is cleared,
        -- whichever way its invocation ends (handover_calls_handled on
        -- InvocationEnded and OrphanInvocationEnded). A parent specialist's
        -- container exits on dispatch_sub_task; a main agent's may be reaped
        -- or the host restarted just after the call.
        --
        -- A sub-task dispatch writes no note to the parent (see
        -- MainGroupDispatchesSpecialist), so a parent learns of a refused
        -- path through its child: the child's prompt names it, and the
        -- child can say so in its result.
        --
        -- No count or size limit applies to the files handed over.
}

-- Root tasks (dispatched by the main group) route their result back into
-- the main group's agent_shared session as a triggering inbound message.
--
-- When a ContainerTransfer exists for the task, the file-handover side of
-- routing is dispatched here too: commit_to_memory = true copies files into
-- the requester group's memory area and records the workspace-relative
-- paths on the parent task; commit_to_memory = false stages files for
-- placement in the requester invocation's ipc-in mount on its next start.
-- The result text used in the inbound message is the already-rewritten
-- transfer.result_text when a transfer exists, otherwise the formatted
-- task outcome.

rule SpecialistResultRoutedToMain {
    when: SpecialistResultReady(task)
    requires: task.requester_group != null
    let main_session = task.requester_session
    let transfer = ContainerTransfer{task: task}
    let returned = ContainerTransfer{failed_task: task}
    requires: main_session.status = active
    ensures:
        if exists transfer and transfer.commit_to_memory:
            for f in transfer.files:
                f.memory_path = group_memory_report_path(task.requester_group, f.original_name)
            task.committed_files = group_memory_report_paths(task.requester_group, transfer)
            transfer.status = committed
        let message = sessions/InboundMessage.created(
            session: main_session,
            seq: next_inbound_seq(main_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: routed_message_text(task, transfer),
            process_after: null,
            tries: 0,
            created_at: now
        )
        if exists transfer and not transfer.commit_to_memory:
            transfer.routed_message = message
        if exists returned:
            returned.routed_message = message
        sessions/SessionWoken(session: main_session)

    @guidance
        -- routed_message_text returns transfer.result_text when transfer is
        -- not null (already path-rewritten by resolve_delivery_paths during
        -- delivery), otherwise format_specialist_outcome(task). For a failed
        -- task that gave back the files it was handed
        -- (DispatchedFilesReturnedOnTaskFailed), the text then names where
        -- they are now, "{ipc_in_container_path}/{returned transfer id}/<name>". Either way,
        -- when task.is_last_same_type_dispatch = true it then appends the
        -- parent notice (the specialist's last_turn_parent_notice, falling
        -- back to config.default_last_turn_parent_notice) - a last child that
        -- returns files is as final as one that returns text.
        --
        -- format_specialist_outcome(task) is the result text for a completed
        -- task. For a failed task it is "Specialist task failed: <kind> -
        -- <detail>" followed by a post-mortem when one can be built: what
        -- the specialist was doing when it stopped, read from its own
        -- transcript and run log (each optional; a specialist that never
        -- started has none). Without it a requester could not tell a fetch
        -- that hung from an API error from a model that went quiet.
        --
        -- group_memory_report_path constructs the workspace-relative path:
        --   "{config.memory_reports_subpath}/{original_name}"
        -- group_memory_report_paths returns the list of such paths for every
        -- file in the transfer, in the order they were originally listed.
        -- The host copies each TransferFile from host-managed storage into
        -- {requester_group.folder}/{memory_path} as part of this action.
        --
        -- Sub-task transfers (commit_to_memory = true with no requester_group)
        -- fall through to SpecialistResultRoutedToParent and stage to ipc-in:
        -- only root-task deliveries can commit to memory. The deliver tool
        -- documentation should make this clear; the resolve_delivery_paths
        -- helper degrades gracefully (treats commit_to_memory as false when
        -- task.requester_group is null) so the specialist still gets file
        -- handover even if it requested commit on a sub-task delivery.
        --
        -- Memory commit collision policy: when two deliveries produce the
        -- same group_memory_report_path (same requester_group, same
        -- original_name basename), the later host copy silently overwrites
        -- the earlier one on disk. Both deliveries' result messages
        -- reference the same path, so the requester sees the most-recently-
        -- committed content at that path. This is intentional; no collision
        -- detection or disambiguation (timestamping, task-id prefixing) is
        -- performed. A future revision may prefix the workspace-relative
        -- path with a task id to avoid collisions, but that would require a
        -- corresponding change to resolve_delivery_paths so the rewritten
        -- result_text reflects the disambiguated path.
        --
        -- The committed transfer status is a transient intermediate state.
        -- The host transitions the transfer pending -> committed -> expired
        -- in a single synchronous operation along this routing path: the
        -- memory_path is recorded on each TransferFile, the workspace files
        -- are written to the requester group's memory area, and the staging
        -- copies are reclaimed immediately because the requester has no
        -- ipc-in to wait on (commit-to-memory bypasses ipc-in entirely).
        -- The memory copies on disk are preserved; only the transfer record
        -- is expired. As a result no separate expiry rule is needed for
        -- root-task transfers in status = committed: by the time any other
        -- rule (TransferExpiredOnRequesterTerminal, the recipient-invocation
        -- expiry, or any observer) could see them they are already in
        -- status = expired. The committed value persists in the enum so the
        -- transition graph and the CommitAndPlaceMutuallyExclusive
        -- invariant remain expressible, but no live transfer ever rests in
        -- it.
}

-- Sub-tasks route their result back into the parent specialist's per-task
-- session. specialist_task_session(parent_task) resolves the Session whose
-- thread_id = parent_task.id — the same session provisioned when the parent
-- task was created. The parent task transitions from awaiting_sub_task back
-- to running; the pending_sub_task pointer is cleared.
--
-- Parent notice: routed_message_text(task, transfer) appends the
-- specialist's last_turn_parent_notice (falling back to
-- config.default_last_turn_parent_notice) when
-- task.is_last_same_type_dispatch = true - whether the child returned text
-- or files - so the parent container knows no further responses will
-- follow from this specialist.
--
-- Correlation: the child task's id is embedded in format_specialist_outcome
-- so the parent container can match the result to its original dispatch call.

rule SpecialistResultRoutedToParent {
    when: SpecialistResultReady(task)
    requires: task.requester_task != null
    requires: task.requester_task.status = awaiting_sub_task
    let parent_task = task.requester_task
    let parent_session = specialist_task_session(parent_task)
    let transfer = ContainerTransfer{task: task}
    requires: parent_session.status = active
    ensures:
        parent_task.status = running
        parent_task.pending_sub_task = null
        sessions/InboundMessage.created(
            session: parent_session,
            seq: next_inbound_seq(parent_session),
            kind: "chat",
            status: pending,
            trigger: true,
            content: routed_message_text(task, transfer),
            process_after: null,
            tries: 0,
            created_at: now
        )
        sessions/SessionWoken(session: parent_session)

    @guidance
        -- Sub-task deliveries do not commit to memory: the parent specialist
        -- is not a memory-area owner. When transfer is non-null its files
        -- transition owned -> placed when the parent's next invocation starts
        -- (see TransferFilesPlaced); transfer.status moves pending -> in_transit
        -- at the same boundary.
}

-- Failure routing: when a task transitions to failed (timeout, execution
-- error, or chain rejection), notify the requester the same way a result
-- would be. SpecialistResultRoutedToMain / SpecialistResultRoutedToParent
-- both subscribe to SpecialistResultReady so the routing rule for failures
-- emits the same trigger.

rule SpecialistFailureRoutedToRequester {
    when: task: SpecialistTask.status transitions_to failed
    ensures: SpecialistResultReady(task: task)

    @guidance
        -- This rule fires for every task that reaches failed, including
        -- sub-tasks rejected immediately at dispatch time by
        -- SubTaskRejectedDepth, SubTaskRejectedCount
        -- and SubTaskRejectedSameTypeLimit (each of which creates the
        -- child task directly in status = failed). Two distinct routing
        -- shapes follow from the SpecialistResultReady emission:
        --
        --   1. Normally-failed tasks (those that went through queued or
        --      running before failing — timeout, execution_error, host_restart,
        --      boot_failure, group_deleted):
        --      the parent task is in awaiting_sub_task, so
        --      SpecialistResultRoutedToParent matches and routes the
        --      failure into the parent's session as a triggering inbound
        --      message. Root-task failures route via
        --      SpecialistResultRoutedToMain in the same way.
        --
        --   2. Immediately-rejected sub-tasks (depth / count /
        --      same-type rejections): the rejection rule creates the child
        --      task already in status = failed and the parent task remains
        --      in status = running (it never enters awaiting_sub_task).
        --      SpecialistResultRoutedToParent's
        --      requires: task.requester_task.status = awaiting_sub_task
        --      is therefore false, and SpecialistResultRoutedToMain's
        --      requires: task.requester_group != null is also false (sub-
        --      tasks have requester_group = null). The
        --      SpecialistResultReady event is deliberately unmatched in
        --      this case. The AgentNotified event emitted directly by the
        --      rejection rule is the canonical and sufficient notification
        --      mechanism: it surfaces the rejection on the parent
        --      specialist's session synchronously without dragging the
        --      parent through an awaiting_sub_task -> running cycle.
}

-- Overall task timeout. A task that has been live (queued, running, or
-- awaiting_sub_task) longer than max_task_duration is marked failed with
-- a timeout failure and the result-ready event is emitted so the requester
-- can be notified. Time a specialist spends waiting on a question to the
-- user (null-channel.allium SpecialistCardRelayed) counts towards this
-- duration: the clock does not pause while the user is asked.

rule SpecialistTaskTimedOut {
    when: task: SpecialistTask.is_overdue
    requires: task.status in {queued, running, awaiting_sub_task, awaiting_restart}
    ensures:
        task.status = failed
        task.failure = TaskFailure{
            kind: timeout,
            detail: "task exceeded maximum duration"
        }
        task.closed_at = now
        SpecialistResultReady(task: task)
}

------------------------------------------------------------
-- Invocation lifecycle and file handover
------------------------------------------------------------

-- An invocation starts when the host launches a container for a session.
-- ContainerInvocationStarted carries the host-assigned id and links to the
-- session and (for specialist tasks) the task. The host creates fresh
-- ipc-out and ipc-in mounts for the invocation. ipc-in is populated with
-- any TransferFiles in status = owned whose transfer targets the
-- recipient session of this invocation, before the container process
-- begins reading its inbound message.

rule InvocationStarted {
    when: ContainerInvocationStarted(invocation)
    ensures:
        IpcOutMount.created(invocation: invocation, status: active)
        IpcInMount.created(invocation: invocation, status: active)
        IpcInPopulated(invocation: invocation)

    @guidance
        -- IpcInPopulated is a system event the host emits after copying all
        -- TransferFiles whose transfer targets this invocation into ipc-in.
        -- The host derives the ipc-in container path for each file as
        --   "{config.ipc_in_container_path}/{transfer_id}/{f.original_name}"
        -- using the transfer id as a per-transfer subdirectory to prevent
        -- name collisions when multiple transfers arrive for the same
        -- invocation (e.g. results from two specialist sub-tasks delivered
        -- before the parent resumed).
}

-- Orphan invocation cleanup. When a new invocation begins for a session
-- that already has an active invocation (no ContainerInvocationEnded was
-- ever observed for the previous one — typically because the runtime did
-- not deliver a container-close event), the previous invocation's mounts
-- are cleared as if InvocationEnded had fired for it. Together with the
-- AtMostOneActiveInvocationPerSession invariant this enforces that a
-- session has at most one active invocation at any moment.

rule OrphanInvocationEnded {
    when: ContainerInvocationStarted(new_invocation)
    let orphan = active_invocation_for_session(new_invocation.session)
    requires: exists orphan
    requires: orphan != new_invocation
    requires: invocation_open(orphan)
    requires: handover_calls_handled(orphan)
    ensures:
        for m in IpcOutMounts where invocation = orphan and status = active:
            m.status = cleared
        for m in IpcInMounts where invocation = orphan and status = active:
            m.status = cleared

    @guidance
        -- active_invocation_for_session(session) is a black box that returns
        -- the Invocation for which an IpcOutMount with status = active still
        -- exists for that session, or null if none does. The host populates
        -- this from its in-memory invocation registry; the spec models it as
        -- a query over current mount state.
        --
        -- The host enforces "at most one active invocation per session" by
        -- ending any orphan synchronously before creating the new
        -- invocation's mounts. This rule covers the recovery path where the
        -- container runtime did not emit a close event for the previous
        -- invocation (observed empirically with the Apple Container runtime).
        -- Files staged in the orphan's ipc-out at this point are discarded;
        -- a delivery that did not complete before the orphan went silent has
        -- already been treated as a lost invocation upstream.
        --
        -- This rule does not emit ContainerInvocationEnded for the orphan;
        -- if the runtime later emits a close event for the orphan it will
        -- find the invocation already ended, and InvocationEnded's
        -- invocation_open guard will treat it as a no-op.
}

-- When ipc-in is populated for an invocation, every TransferFile in status
-- = owned whose transfer targets that invocation transitions to placed,
-- and the covering ContainerTransfer transitions pending -> in_transit.
-- transfer_targets_invocation is a black box function: for sub-task
-- transfers it returns true when invocation is the requester_task's next
-- invocation; for root-task transfers it returns true when invocation is
-- the requester_group's main session's next invocation; for dispatch
-- transfers it returns true when invocation is the next invocation of the
-- dispatched task's own session - its first start, and each later start
-- after the transfer was reset to pending (TransferResetOnRecipientCrash);
-- for returned transfers it returns true when invocation is the next
-- invocation of returned_to. commit-to-memory
-- transfers are not placed in ipc-in (they were committed to memory at
-- routing time and transitioned to status = committed).

rule TransferFilesPlaced {
    when: IpcInPopulated(invocation)
    for f in TransferFiles where status = owned and transfer_targets_invocation(transfer, invocation):
        ensures:
            f.status = placed
            f.reached_recipient = true

    @guidance
        -- transfer_targets_invocation returns false for any transfer whose
        -- status has already moved past pending (committed, in_transit,
        -- expired); it implicitly only matches pending transfers whose
        -- recipient is this invocation.
}

rule TransferMovedToInTransit {
    when: IpcInPopulated(invocation)
    for t in ContainerTransfers where status = pending and transfer_targets_invocation(t, invocation):
        ensures: t.status = in_transit
}

-- Mid-invocation placement. When a transfer is staged at result-routing
-- time and the recipient session already has a live (running) invocation,
-- the host copies the transfer's files into that invocation's ipc-in
-- directly rather than waiting for the recipient's next ContainerInvocationStarted.
-- This handles the race where the recipient container was already running
-- when the specialist delivered its result: the spawn-time IpcInPopulated
-- ran before the transfer existed, so without this rule the files would
-- never reach the running container's ipc-in.
--
-- Sub-task transfers between specialist deliveries don't usually hit this
-- path: the parent specialist's container exits when it dispatches a
-- sub-task and is restarted by the host only after the child's result is
-- routed, so the transfer is placed via the spawn-time IpcInPopulated of
-- the new parent invocation. The mid-invocation race is the main-group
-- case where the main session's container is long-running and accepting
-- inbound messages while specialists deliver.

rule TransferPlacedIntoLiveIpcIn {
    when: SpecialistResultReady(task)
    let transfer = ContainerTransfer{task: task}
    requires: exists transfer
    requires: transfer.status = pending
    requires: transfer.commit_to_memory = false
    let recipient_session = recipient_session_for_transfer(transfer)
    requires: exists recipient_session
    let live = active_invocation_for_session(recipient_session)
    requires: exists live
    ensures:
        TransferPlacedLive(transfer: transfer, invocation: live)

    @guidance
        -- recipient_session_for_transfer(transfer) returns:
        --   for sub-task transfers (transfer.task.requester_task != null):
        --     the parent task's per-task session
        --     (specialist_task_session(transfer.task.requester_task))
        --   for root-task transfers (transfer.task.requester_group != null):
        --     transfer.task.requester_session (the main-agent session that
        --     dispatched the root task)
        --   for dispatch transfers (transfer.kind = dispatch):
        --     the dispatched task's per-task session
        --     (specialist_task_session(transfer.dispatched_task))
        --   for returned transfers (transfer.kind = returned):
        --     transfer.returned_to
        -- The first two mirror the recipient resolution in
        -- SpecialistResultRoutedToParent and SpecialistResultRoutedToMain.
        --
        -- Dispatch and returned transfers never take this path: the lookup
        -- above finds only result transfers (ReturnedFilesPlacedIntoLiveIpcIn
        -- places a failed task's returned files), and a
        -- dispatched task's session is created with the transfer, so no
        -- container of it is running yet to place into.
        --
        -- active_invocation_for_session(session) returns the Invocation for
        -- which an IpcOutMount with status = active exists for that session,
        -- or null if none does. The same helper is used by
        -- OrphanInvocationEnded and InvocationEndedOnTaskTerminal.
        --
        -- Mid-invocation placement is mutually exclusive with
        -- TransferFilesPlaced / TransferMovedToInTransit: those fire on
        -- IpcInPopulated at the recipient's next start, by which time this
        -- rule has already advanced the transfer to in_transit and its
        -- files to placed. transfer_targets_invocation, used by the
        -- IpcInPopulated rules, returns false for any transfer not in
        -- status = pending, so a transfer placed mid-invocation here will
        -- not be re-placed when the recipient subsequently starts a new
        -- invocation.
        --
        -- commit_to_memory = true transfers are excluded: they are
        -- committed to the requester group's memory area in
        -- SpecialistResultRoutedToMain (which fires off the same trigger)
        -- and never enter ipc-in.
}

-- The files a failed task gives back reach a running recipient the same
-- way: the main agent's container is usually up when a root task fails.

rule ReturnedFilesPlacedIntoLiveIpcIn {
    when: SpecialistResultReady(task)
    let returned = ContainerTransfer{failed_task: task}
    requires: exists returned
    requires: returned.status = pending
    let live = active_invocation_for_session(returned.returned_to)
    requires: exists live
    ensures:
        TransferPlacedLive(transfer: returned, invocation: live)
}

-- Placing a pending transfer into a running invocation's ipc-in: each owned
-- file is copied in and has now reached its recipient.

rule TransferPlacedIntoRunningInvocation {
    when: TransferPlacedLive(transfer, invocation)
    requires: transfer.status = pending
    ensures:
        for f in transfer.files where status = owned:
            f.status = placed
            f.reached_recipient = true
        transfer.status = in_transit
}

-- An invocation ends when the container process exits. The host clears
-- both mounts.
--
-- invocation_open(i) is a black box: true until i has been ended by
-- InvocationEnded, OrphanInvocationEnded or InvocationEndedOnTaskTerminal
-- (the host records the end on the invocation). An invocation and its two
-- mounts are created together in one step, so while it is open both mounts
-- are active and once it has ended both are cleared; the three end rules
-- guard on the invocation, and clear whichever of its mounts is active. Files remaining in ipc-out that were not consumed by a
-- delivery are discarded as part of the clear.

rule InvocationEnded {
    when: ContainerInvocationEnded(invocation)
    requires: invocation_open(invocation)
    requires: handover_calls_handled(invocation)
    ensures:
        for m in IpcOutMounts where invocation = invocation and status = active:
            m.status = cleared
        for m in IpcInMounts where invocation = invocation and status = active:
            m.status = cleared

    @guidance
        -- handover_calls_handled(invocation) is a black box: true once the
        -- host has handled every dispatch_specialist, dispatch_sub_task and
        -- deliver_specialist_result request the invocation wrote, so every
        -- file those calls named is owned (or refused by name) before
        -- ipc-out is cleared. The host makes it true before ending any
        -- invocation: it drains the session's outbound requests at container
        -- exit - for every session, not only specialist tasks - and, on
        -- host start, before it reconciles invocations left open by the
        -- previous run. This is the first half of the host's guarantee for
        -- named files (see the file-handover section).
        --
        -- The invocation_open guard makes this rule idempotent: if the
        -- invocation has already been ended by OrphanInvocationEnded
        -- (orphan recovery at the next ContainerInvocationStarted) or by
        -- InvocationEndedOnTaskTerminal (host-driven synchronous end at
        -- task terminal transition), a late or duplicate
        -- ContainerInvocationEnded is silently dropped.
        --
        -- ipc-out is cleared on every container exit, including the exit
        -- caused by a dispatch_sub_task call (where the parent task
        -- transitions running -> awaiting_sub_task and the parent's
        -- container terminates while the child runs). There is no
        -- "pause-and-preserve" path: the awaiting_sub_task boundary is a
        -- hard ipc-out reset, identical to any other invocation end.
        --
        -- Files written to ipc-out before a dispatch_sub_task call are
        -- discarded when the parent container exits for the sub-task
        -- dispatch, unless the dispatch named them in its file_paths: those
        -- were taken by the host first and go to the child
        -- (DispatchFilesTransferred), not back to the parent. They will not be present in the resumed invocation's
        -- ipc-out (each invocation gets a fresh, empty ipc-out per the
        -- per-invocation isolation model documented on Invocation).
        --
        -- A specialist that intends to include files in its final delivery
        -- must call deliver_specialist_result (which copies those files
        -- out of ipc-out via HostTookOwnership) before calling
        -- dispatch_sub_task. Calling dispatch_sub_task with unconsumed
        -- ipc-out files is a specialist authoring error; the files are
        -- silently lost. The deliver tool is fire-and-forget and exits the
        -- container, so the natural ordering "deliver, then any further
        -- delegation" is forced by the lifecycle: a specialist that
        -- delivers cannot subsequently dispatch a sub-task on the same
        -- task, and a specialist that dispatches a sub-task must defer all
        -- file production until after the sub-task result returns and the
        -- parent resumes in a fresh invocation with a fresh ipc-out.
        --
        -- This is consistent with the per-invocation isolation model: each
        -- invocation starts with a fresh, empty ipc-out and an ipc-in
        -- populated only with files staged for that invocation by
        -- transfers targeting it.
}

-- Synchronous invocation end at task terminal transition. When a
-- specialist task reaches a terminal state (completed or failed), the
-- host clears the active invocation's mounts immediately, without waiting
-- for ContainerInvocationEnded. This is more reliable than relying on the
-- container-close event, which some runtimes do not deliver promptly (or
-- at all).
--
-- Two parallel rules cover the two terminal transitions. They share an
-- emitted internal event SpecialistTaskReachedTerminal so the cleanup
-- logic only appears once, in InvocationEndedOnTaskTerminal.

rule SpecialistTaskCompletedTerminal {
    when: task: SpecialistTask.status transitions_to completed
    ensures: SpecialistTaskReachedTerminal(task: task)
}

rule SpecialistTaskFailedTerminal {
    when: task: SpecialistTask.status transitions_to failed
    ensures: SpecialistTaskReachedTerminal(task: task)
}

rule InvocationEndedOnTaskTerminal {
    when: SpecialistTaskReachedTerminal(task)
    let session = specialist_task_session(task)
    requires: exists session
    let live = active_invocation_for_session(session)
    requires: exists live
    requires: invocation_open(live)
    ensures:
        for m in IpcOutMounts where invocation = live and status = active:
            m.status = cleared
        for m in IpcInMounts where invocation = live and status = active:
            m.status = cleared

    @guidance
        -- This rule fires synchronously on the host when a specialist task
        -- reaches a terminal state, before the container process actually
        -- exits. ContainerInvocationEnded for the same invocation may fire
        -- afterward, but InvocationEnded's invocation_open guard makes that
        -- subsequent firing a no-op (the invocation has already ended).
        --
        -- specialist_task_session(task) is null for tasks created directly
        -- in status = failed by the sub-task rejection rules
        -- (SubTaskRejectedDepth/Count/SameTypeLimit). For those tasks
        -- no session was provisioned and no invocation exists; the
        -- exists session and exists live guards together skip the rule.
        --
        -- For tasks failed by ChildSubtreeCancelledOnParentCrash propagation
        -- a session was provisioned but no invocation may currently be
        -- running (the child container may not have started). The exists
        -- live guard handles this case the same way.
}

-- Per-task session closure at task terminal transition. A specialist task's
-- per-task Session must be closed once the task itself reaches a terminal
-- state (completed or failed). Without this, the session remains
-- status = active in the central session store with any still-pending
-- inbound messages indefinitely eligible for redelivery, and the host sweep
-- will keep waking a container for a task that is already concluded.
--
-- Closing the session is the canonical signal that no further container
-- work will happen for this task. It guards every wake/queue rule
-- downstream (each of which requires session.status = active) from
-- reopening work against a terminated task.
--
-- This rule fires from the same SpecialistTaskReachedTerminal event as
-- InvocationEndedOnTaskTerminal; the two run as siblings. Invocation
-- mounts are cleared by the sibling rule, and the session itself is
-- closed here.
--
-- Idempotence: the requires guard on session.status = active makes this
-- rule a no-op if some other path (e.g. an admin invoking CloseSession on
-- this session) has already closed it.

rule SpecialistTaskSessionClosed {
    when: SpecialistTaskReachedTerminal(task)
    let session = specialist_task_session(task)
    requires: exists session
    requires: session.status = active
    ensures:
        session.status = closed

    @guidance
        -- specialist_task_session(task) is null for tasks created directly
        -- in status = failed by the sub-task rejection rules
        -- (SubTaskRejectedDepth/Count/SameTypeLimit). For those tasks
        -- no session was provisioned and the exists session guard skips the
        -- rule, matching the behaviour of InvocationEndedOnTaskTerminal.
        --
        -- Pending inbound messages on the closed session. In the central
        -- session store, any messages_in row still in status = pending at
        -- the moment of closure is also marked failed by the host, so a
        -- stale sweep that reopens the inbound DB cannot revive it as work
        -- to wake the container with. This is defensive cleanup against
        -- redelivery; once the session is closed the downstream wake rules
        -- (WakeOnInbound, ScheduledInboundDue, ContainerSlotFreed,
        -- StuckSessionRecovered, StuckSessionQueued) all guard on
        -- session.status = active and would not fire regardless.
        --
        -- The InboundMessage transition graph in sessions.allium does not
        -- include a pending -> failed edge, so this fail-pending action is
        -- not modelled as a rule-level ensures here. The host's behaviour
        -- is recorded as guidance pending a sessions.allium revision that
        -- adds the edge; see the open question
        -- "InboundMessage pending -> failed edge for session closure" below.
        --
        -- Distinct from SessionClosed in sessions.allium. SessionClosed
        -- requires an admin actor and an external CloseSession trigger;
        -- this rule is system-driven from a task terminal transition with
        -- no actor. The two paths are independent and converge on the same
        -- session.status = closed terminal state in sessions.allium's
        -- transition graph.
}

-- Transfers expire when the requester task reaches a terminal state.
-- Both the in-transit (sub-task to parent) and committed (sub-task or root
-- to memory) shapes converge here: staging copies in host-managed storage
-- can be reclaimed, while memory copies on disk persist. For root-task
-- transfers (requester_group != null), the requester is the main group
-- session, which has no terminal state in the same sense as a task; the
-- expiry is gated on the delivering task itself reaching a terminal state,
-- which it always does at delivery time. For sub-task transfers, expiry
-- waits for the parent task's terminal transition so files remain
-- available across any retries of the parent.

-- When the requester task reaches a terminal state, the transfer files are
-- no longer needed and may be reclaimed from host-managed storage. Memory
-- copies persist on disk regardless because they live in the requester
-- group's workspace, not the staging area.
--
-- For sub-task transfers, the requester is t.task.requester_task; expiry
-- waits for that parent task's terminal transition so files remain
-- available across any retries of the parent. A transfer still pending at
-- that point (its files never reached the parent, e.g. the parent was
-- cancelled or timed out while the child delivered) expires too: no
-- invocation of a terminal task will ever read it, and leaving it pending
-- would keep its staging copy forever. For root-task transfers there is no
-- parent task; TransferExpiredOnRoutedMessageCompleted / ...Failed below
-- cover that case once the main agent has handled the routed result.

rule TransferExpiredOnRequesterTerminal {
    when: parent: SpecialistTask.status transitions_to completed
    for t in ContainerTransfers where status in { in_transit, committed } and is_transfer_for_requester(t, parent):
        ensures: t.status = expired
        for f in t.files:
            ensures: f.status = expired
    for t in ContainerTransfers where status = pending and is_transfer_for_requester(t, parent):
        ensures: TransferOrphaned(transfer: t)

    @guidance
        -- is_transfer_for_requester(t, parent) is true when parent =
        -- t.task.requester_task. For root-task transfers (requester_group
        -- set, requester_task null), the function returns false; expiry
        -- of those is handled by TransferExpiredOnRoutedMessageCompleted /
        -- TransferOrphanedOnRoutedMessageFailed. For dispatch and returned
        -- transfers it also returns false; DispatchTransferExpiredOnTaskCompleted,
        -- DispatchedFilesReturnedOnTaskFailed and
        -- ReturnedTransferEndsWithRecipientTask cover them.
        --
        -- A transfer still pending here never reached the parent: it is
        -- parked, not expired (TransferOrphaned).
}

rule TransferExpiredOnRequesterFailed {
    when: parent: SpecialistTask.status transitions_to failed
    for t in ContainerTransfers where status in { in_transit, committed } and is_transfer_for_requester(t, parent):
        ensures: t.status = expired
        for f in t.files:
            ensures: f.status = expired
    for t in ContainerTransfers where status = pending and is_transfer_for_requester(t, parent):
        ensures: TransferOrphaned(transfer: t)
}

-- A dispatch transfer serves the task it was handed to for that task's
-- whole life. When the task completes, the files have been used and the
-- transfer expires. A file the specialist wants to keep or return must be
-- copied into its ipc-out and delivered.

rule DispatchTransferExpiredOnTaskCompleted {
    when: task: SpecialistTask.status transitions_to completed
    for t in ContainerTransfers where kind = dispatch and dispatched_task = task
            and status in { pending, in_transit }:
        ensures: t.status = expired
        for f in t.files:
            ensures: f.status = expired
}

-- When the task fails instead - however: it never booted, timed out,
-- exhausted its restarts, was cancelled with its subtree, or its group was
-- deleted - the files it was handed go back to the session that dispatched
-- it, so the dispatcher still has them to retry with or hand elsewhere. The
-- host copies them into a returned transfer to task.requester_session (the
-- main agent's session for a root task, the parent's per-task session for
-- a sub-task) and expires the dispatch transfer. The failure result names
-- where the files now are (routed_message_text); the returned transfer is
-- placed like a result transfer (TransferPlacedIntoLiveIpcIn, or at the
-- recipient's next start) and expires with its recipient
-- (TransferExpiredOnRoutedMessageCompleted / TransferOrphanedOnRoutedMessageFailed, ReturnedTransferEndsWithRecipientTask).

rule DispatchedFilesReturnedOnTaskFailed {
    when: task: SpecialistTask.status transitions_to failed
    for given in ContainerTransfers where kind = dispatch and dispatched_task = task
            and status in { pending, in_transit }:
        ensures:
            let back = ContainerTransfer.created(
                kind: returned,
                returned_to: task.requester_session,
                failed_task: task,
                sender_invocation: given.sender_invocation,
                commit_to_memory: false,
                file_count: given.file_count,
                sent_at: now,
                status: pending
            )
            for f in given.files:
                TransferFile.created(
                    transfer: back,
                    original_name: f.original_name,
                    host_path: returned_storage_path(back, f),
                    status: owned,
                    memory_path: null,
                    parked_path: null,
                    reached_recipient: false
                )
            given.returned_as = back
            given.status = expired
            for f in given.files:
                f.status = expired

    @guidance
        -- returned_storage_path(back, f) is a black box: a host-managed
        -- copy of f's staged file keyed on the returned transfer, so the
        -- dispatch transfer's staging can be reclaimed independently.
        --
        -- Ordering: this rule runs on the same transition as
        -- SpecialistFailureRoutedToRequester, before the failure is routed,
        -- so the routed failure (and TransferPlacedIntoLiveIpcIn) finds the
        -- returned transfer.
        --
        -- A failed sub-task whose parent is not awaiting it (the parent was
        -- cancelled, timed out or is restarting) still returns its files to
        -- the parent's session; they wait there for the parent's next run,
        -- whose restart prompt names the files waiting in its ipc-in, or are
        -- parked if the parent ends first.
}

-- Root-task transfers expire once the main agent has handled the message
-- that carried them. The main-agent session has no associated
-- SpecialistTask, so the routed result message (transfer.routed_message,
-- set by SpecialistResultRoutedToMain) is the expiry boundary: when it
-- reaches completed (the agent processed it) or failed (it will never be
-- processed), its transfer is expired and its files reclaimed from
-- host-managed storage. Expiring on the message rather than on the
-- invocation ending matters when files are placed into a container that is
-- already running (TransferPlacedIntoLiveIpcIn): if that container exits
-- (idle reap, restart) before it reaches the message, the transfer stays
-- live, and the next invocation reads the message with its files.

rule TransferExpiredOnRoutedMessageCompleted {
    when: message: sessions/InboundMessage.status transitions_to completed
    for t in ContainerTransfers where status = in_transit and routed_message = message:
        ensures: t.status = expired
        for f in t.files:
            ensures: f.status = expired
    for t in ContainerTransfers where status = pending and routed_message = message:
        ensures: TransferOrphaned(transfer: t)

    @guidance
        -- The routed delivery is consumed in the single turn that processes
        -- its message: the agent reads the result text and the files in its
        -- ipc-in. The InboundMessage is processed once, so after it
        -- completes no future invocation will read those files again.
        --
        -- A transfer still pending when its message completes never reached
        -- the agent's ipc-in; nothing will read it later either, so it is
        -- parked (TransferOrphaned) rather than held or discarded.
        --
        -- Specialist-recipient transfers (sub-task transfers to the parent
        -- specialist's per-task session) have routed_message = null and are
        -- expired via TransferExpiredOnRequesterTerminal /
        -- TransferExpiredOnRequesterFailed when the parent task itself
        -- reaches a terminal state, preserving file availability across any
        -- parent restart retries.
}

rule TransferOrphanedOnRoutedMessageFailed {
    when: message: sessions/InboundMessage.status transitions_to failed
    for t in ContainerTransfers where status in { pending, in_transit } and routed_message = message:
        ensures: TransferOrphaned(transfer: t)

    @guidance
        -- The message will never be processed, so the agent never read the
        -- files even if they sat in its ipc-in: they are parked.
}

-- Reset on recipient specialist crash. When a specialist invocation ends
-- while its associated task is still alive (not in a terminal state), any
-- in-transit transfer staged into this invocation's ipc-in is rolled back
-- to pending, and each placed file is rolled back to owned. This preserves
-- the file handover across the parent specialist's restart: the next
-- invocation's ipc-in population path (see TransferFilesPlaced /
-- TransferMovedToInTransit) will re-place the files from host-managed
-- storage when the recipient resumes.
--
-- The guard invocation.task != null distinguishes the specialist-recipient
-- case from the main-agent recipient case (handled by
-- TransferResetOnMainRecipientExit below, where invocation.task = null).
-- The non-terminal-status guard is what makes this the reset
-- branch rather than the expire branch: a specialist recipient whose task
-- has already reached completed or failed is handled by the existing
-- expire-on-requester-terminal rules and needs no further action here.

rule TransferResetOnRecipientCrash {
    when: ContainerInvocationEnded(invocation)
    requires: invocation.task != null
    requires: invocation.task.status not in {completed, failed}
    for t in ContainerTransfers where status = in_transit and recipient_session_for_transfer(t) = invocation.session:
        ensures: t.status = pending
        for f in t.files where status = placed:
            ensures: f.status = owned

    @guidance
        -- Condition: this rule only fires when the recipient invocation
        -- ends while its specialist task is non-terminal. Concretely that
        -- means the parent specialist has gone to awaiting_restart (or
        -- still queued / running / awaiting_sub_task at the moment its
        -- container exits, e.g. orphan-style runtime hiccups). In those
        -- cases the parent will be restarted by the host and a new
        -- invocation will start.
        --
        -- Purpose: files must survive container crashes and restarts.
        -- The "files survive specialist task restarts" invariant is what
        -- makes a sub-task transfer durable across the parent's retry
        -- budget: a child's delivery is not lost just because the parent
        -- crashed before consuming it. By moving the transfer back to
        -- pending and the files back to owned, the next invocation's
        -- IpcInPopulated step can re-place them via TransferFilesPlaced
        -- and TransferMovedToInTransit, identical to the spawn-time path.
        --
        -- The same reset keeps a dispatch transfer with the task it was
        -- handed to. That task's invocation also ends, non-terminal, when it
        -- dispatches a sub-task of its own; the files it was given at
        -- dispatch go back to pending and are placed again when it resumes
        -- with the sub-task's result, as they are after a crash.
        --
        -- Counterpart (expire path). The expire branch fires when the
        -- recipient is past the point where it can still consume the
        -- files. Two distinct paths cover that:
        --   - TransferExpiredOnRoutedMessageCompleted / ...Failed: a
        --     main-agent recipient with no specialist task. The agent
        --     reads the transfer in the turn that handles its routed
        --     message; once that message is completed (or failed), the
        --     staged copies can be reclaimed.
        --   - TransferExpiredOnRequesterTerminal / TransferExpiredOnRequesterFailed:
        --     fired by the parent task itself transitioning to
        --     completed or failed, which always precedes (or coincides
        --     with) the parent's invocation ending. By the time
        --     ContainerInvocationEnded fires for a terminal-task
        --     recipient, transfers are already in status = expired and
        --     this rule's status = in_transit guard is false; the rule
        --     is a no-op in that case.
}

-- Reset on main-agent exit before the routed message is handled. Files
-- placed into a running main-agent container (TransferPlacedIntoLiveIpcIn)
-- live in that invocation's ipc-in, which is cleared when the invocation
-- ends. If the container exits (idle reap, restart, crash) before it has
-- handled the message that carries the result, the transfer rolls back to
-- pending and its placed files to owned, so the next invocation's ipc-in
-- population re-places them for the turn that finally reads the message.
-- Once the message is handled the transfer is already expired and this
-- rule's in_transit guard makes it a no-op.

rule TransferResetOnMainRecipientExit {
    when: ContainerInvocationEnded(invocation)
    requires: invocation.task = null
    for t in ContainerTransfers where status = in_transit
            and recipient_session_for_transfer(t) = invocation.session
            and t.routed_message.status in { pending, processing }:
        ensures: t.status = pending
        for f in t.files where status = placed:
            ensures: f.status = owned
}

-- A pending transfer whose delivering task fails between ownership and
-- routing (e.g. host crash mid-delivery) is parked without ever being
-- placed. In practice this is rare because SpecialistDeliveredResult
-- moves the task to completed atomically with the transfer creation;
-- this rule covers the recovery case where SpecialistResultReady was
-- emitted but routing failed before the transfer reached a recipient.

rule PendingTransferOrphanedOnDeliveringTaskFailed {
    when: task: SpecialistTask.status transitions_to failed
    for t in ContainerTransfers where status = pending and t.task = task:
        ensures: TransferOrphaned(transfer: t)
}

-- A completed task's result can find no recipient: the requesting main
-- session is gone or closed, or the parent is no longer awaiting it
-- (cancelled, timed out). Its pending transfer then has no one to place
-- into and expires rather than keeping its staging copy.
-- result_has_recipient(task) is a black box, true exactly when
-- SpecialistResultRoutedToMain or SpecialistResultRoutedToParent can route
-- the result (their requires clauses), so this rule and those are exclusive.

rule UnroutedTransferOrphaned {
    when: SpecialistResultReady(task)
    let transfer = ContainerTransfer{task: task}
    requires: exists transfer
    requires: transfer.status = pending
    requires: not result_has_recipient(task)
    ensures:
        TransferOrphaned(transfer: transfer)
}

-- Files a failed task gives back wait for their recipient session even
-- when the failure itself is not routed (a parent restarting picks them up
-- on its next run). Only a recipient session that is no longer active
-- leaves them nowhere to go.

rule ReturnedFilesOrphanedWithoutRecipient {
    when: SpecialistResultReady(task)
    let returned = ContainerTransfer{failed_task: task}
    requires: exists returned
    requires: returned.status = pending
    requires: returned.returned_to.status != active
    ensures:
        TransferOrphaned(transfer: returned)
}

-- Files returned to a specialist task's session serve that task until it
-- ends, as a sub-task's result does: then those it read expire, and those
-- it never received are parked.

rule ReturnedTransferEndsWithRecipientTask {
    when: SpecialistTaskReachedTerminal(task)
    let session = specialist_task_session(task)
    requires: exists session
    for t in ContainerTransfers where kind = returned and returned_to = session
            and status = in_transit:
        ensures: t.status = expired
        for f in t.files:
            ensures: f.status = expired
    for t in ContainerTransfers where kind = returned and returned_to = session
            and status = pending:
        ensures: TransferOrphaned(transfer: t)
}

-- Parking. A transfer whose files can no longer reach anyone is not
-- discarded: the host copies its files into the root requester's
-- workspace - the main agent group the user talks to - under
-- "{orphan_subpath}/{transfer_id}/<name>", records where, logs it, and
-- expires the transfer. Only when that group itself is gone (deleted) are
-- the files dropped, with the rest of its state.

rule TransferParked {
    when: TransferOrphaned(transfer)
    requires: transfer.status in { pending, in_transit }
    let group = root_requester_group(transfer)
    ensures:
        for f in transfer.files where status != expired:
            if exists group:
                f.parked_path = orphan_park_path(transfer, f)
            f.status = expired
        transfer.status = expired

    @guidance
        -- root_requester_group(transfer) is a black box: the agent group of
        -- the root requester session of the task chain the transfer belongs
        -- to - transfer.task.root_requester_session for a result,
        -- transfer.dispatched_task's for a dispatch, failed_task's for a
        -- returned transfer from a failed task, and returned_to's own task
        -- (or returned_to itself, when it has no task) for a refused
        -- dispatch - or null when that group has been deleted.
        -- orphan_park_path is "{config.orphan_subpath}/{transfer id}/{f.original_name}",
        -- relative to that group's folder; the host copies the staged file
        -- there before reclaiming staging.
        --
        -- Parking is the end of the host's responsibility: nothing tells an
        -- agent about parked files. The log line names each one.
}

------------------------------------------------------------
-- Crash and restart recovery
------------------------------------------------------------

-- A specialist task can fail to make progress in three distinct ways, each
-- with its own detection path and recovery rules:
--
-- 1. Crash while running. The specialist's container exits unexpectedly while
--    the task is in status = running. One of sessions.allium's stuck-detection
--    rules fires — StuckContainerDetectedByHeartbeat (heartbeat stale beyond
--    ceiling) or StuckContainerDetectedByClaim (a claimed message has gone
--    silent past tolerance) — moving the session processing_state from
--    processing to stuck. This layer observes the transition via
--    SpecialistContainerCrashed (retries remain) or SpecialistRestartExhausted
--    (retries exhausted).
--
--    Crash detection is gated on task.status = running. A queued task with
--    no running container is not a crash: it is either waiting in the host's
--    concurrency queue for a slot to free, or it has just been dispatched
--    and the container has not yet started. Neither situation should
--    consume restart_attempt_count. The only legitimate transitions out of
--    queued are queued -> running (via SpecialistTaskStarted, on
--    SpecialistContainerProcessing) and queued -> failed (via a bounded boot
--    crash, SpecialistBootFailed; via deletion of its group,
--    SpecialistTasksFailedOnGroupDeleted; or via overall task timeout,
--    SpecialistTaskTimedOut). There is no queued -> awaiting_restart
--    edge; the queued state must reach running first before any
--    crash-detection rule can fire against the task.
--
--    Recovery: SpecialistContainerCrashed moves the task to awaiting_restart
--    and increments restart_attempt_count. sessions.allium then either
--    re-queues and restarts the container (StuckSessionRecovered, for main-
--    group sessions or when no other sessions are waiting) or transitions the
--    session stuck -> idle and places it at the back of the FIFO concurrency
--    queue (StuckSessionQueued, for non-main specialist sessions when other
--    sessions are already waiting). In the queued case the slot is given to
--    the head waiter via ContainerSlotFreed; the stuck session re-enters
--    processing when it reaches the head of the queue. Either way, the next
--    invocation emits SpecialistContainerProcessing and SpecialistTaskStarted
--    transitions the task back to running.
--
-- 2. Child sub-task not completing. The task is in status = awaiting_sub_task,
--    its container has already exited cleanly (the dispatch_sub_task call
--    terminates the parent invocation), and the child task is not making
--    progress. There is no stuck-session signal here because the parent's
--    session is idle, not processing. Detection is via the
--    sub_task_await_overdue derived field, which fires SubTaskAwaitTimedOut
--    (retries remain) or SubTaskAwaitExhausted (retries exhausted).
--
-- 3. Overall task timeout. The task has been live (queued, running,
--    awaiting_sub_task, or awaiting_restart) longer than max_task_duration.
--    SpecialistTaskTimedOut fires once is_overdue becomes true and transitions
--    the task directly to failed with kind = timeout. This is the global
--    deadline; it overrides path (1) and (2) once exceeded.

rule SpecialistContainerCrashed {
    when: session: sessions/Session.processing_state transitions_to stuck
    let task = SpecialistTask{id: session.thread_id}
    requires: exists task
    requires: task.status = running
    requires: task.restart_attempt_count < config.max_restart_retries
    ensures:
        task.status = awaiting_restart
        task.restart_attempt_count = task.restart_attempt_count + 1

    @guidance
        -- The task.status = running guard is load-bearing. Crash detection
        -- must only fire for tasks whose container has actually been
        -- processing — i.e. tasks that have already transitioned through
        -- SpecialistTaskStarted from queued (or awaiting_restart) into
        -- running. A task that is still in status = queued with no running
        -- container is either (a) waiting in the host's in-memory
        -- concurrency queue for a slot to free, or (b) freshly dispatched
        -- before the container has started. Neither is a crash, and neither
        -- should consume restart_attempt_count.
        --
        -- The session processing_state transition from processing to stuck
        -- can in principle reflect a stuck-detection signal observed on a
        -- session whose task is not (yet) running. The exists task guard
        -- plus the task.status = running guard together ensure that this
        -- rule is silent in such cases. Without the running guard,
        -- successive sweep ticks (e.g. every ~60 seconds) could each
        -- observe the same not-yet-running task and increment its
        -- restart_attempt_count, exhausting the restart budget in a handful
        -- of ticks before the container had a chance to start.
        --
        -- Awaiting_sub_task is also excluded by this guard. A parent
        -- specialist whose container exited cleanly to dispatch a sub-task
        -- is not crashed — its session sits idle and the sub-task await
        -- timeout is the relevant recovery path
        -- (SubTaskAwaitTimedOut / SubTaskAwaitExhausted).
}

-- When a task transitions to awaiting_restart and was holding a pending
-- sub-task (i.e. it was in awaiting_sub_task before the crash), the child
-- subtree is cancelled immediately. The parent will restart clean and
-- re-dispatch the sub-task from scratch; any work the child had done is
-- lost. This prevents the parent's restart from re-dispatching the same
-- sub-task and creating duplicate children.

rule ChildSubtreeCancelledOnParentCrash {
    when: task: SpecialistTask.status transitions_to awaiting_restart
    requires: task.pending_sub_task != null
    ensures:
        SubtreeCancelled(task: task.pending_sub_task)
}

-- Apply a cancellation to a single task in the subtree. The task is failed
-- with kind = execution_error and a cancellation detail string. If the
-- cancelled task itself had a pending sub-task, the cancellation propagates
-- recursively down the chain. Ancestors end for several reasons (a crash,
-- exhausted retries, a timeout, deletion of their group), so the detail
-- names the outcome, not the cause.

rule SubtreeCancellationApplied {
    when: SubtreeCancelled(task)
    requires: task.status not in {completed, failed}
    ensures:
        task.status = failed
        task.failure = TaskFailure{
            kind: execution_error,
            detail: "cancelled: an ancestor specialist task ended"
        }
        task.closed_at = now
        if task.pending_sub_task != null:
            SubtreeCancelled(task: task.pending_sub_task)

    @guidance
        -- Recursive propagation: ChildSubtreeCancelledOnParentCrash fires only
        -- on transitions into awaiting_restart, not into failed, so it does not
        -- itself cascade through the chain. Instead this rule emits
        -- SubtreeCancelled on the cancelled task's own pending_sub_task when
        -- present, so cancellation walks the pending_sub_task chain until no
        -- further pending_sub_task exists. Each task cancelled this way also
        -- emits SpecialistResultReady via SpecialistFailureRoutedToRequester,
        -- but the routing rules will not match: SpecialistResultRoutedToParent
        -- requires the parent to be in awaiting_sub_task, but the parent in a
        -- cancelled subtree is either in awaiting_restart (the original
        -- crashed task) or already failed itself (further up the chain). This
        -- silent drop is intentional and consistent with the immediately-
        -- rejected sub-task case documented on SpecialistFailureRoutedToRequester.
        -- The parent restarts clean and re-dispatches the sub-task from
        -- scratch; any work done by the cancelled subtree is lost.
}

-- When retries are exhausted the task fails. SpecialistFailureRoutedToRequester
-- picks up the failed transition and routes the outcome to the requester.

rule SpecialistRestartExhausted {
    when: session: sessions/Session.processing_state transitions_to stuck
    let task = SpecialistTask{id: session.thread_id}
    requires: exists task
    requires: task.status = running
    requires: task.restart_attempt_count >= config.max_restart_retries
    ensures:
        task.status = failed
        task.failure = TaskFailure{
            kind: host_restart,
            detail: "specialist container failed and maximum restart retries were exhausted"
        }
        task.closed_at = now

    @guidance
        -- Like SpecialistContainerCrashed, this rule is gated on
        -- task.status = running. A queued task cannot reach
        -- restart_attempt_count >= max_restart_retries via this path because
        -- the only rule that increments restart_attempt_count
        -- (SpecialistContainerCrashed) is itself gated on running. A queued
        -- task whose container crashes during boot fails via
        -- SpecialistBootFailed (kind = boot_failure) once the boot-crash
        -- bound trips; one that simply cannot be started times out via
        -- SpecialistTaskTimedOut (kind = timeout). Neither exhausts restart
        -- retries here.
}

-- Companion to ChildSubtreeCancelledOnParentCrash for the retries-exhausted
-- path. SpecialistRestartExhausted transitions the task directly to failed
-- (not awaiting_restart), so the awaiting_restart-keyed rule does not fire.
-- This rule cancels the child subtree when the parent was in awaiting_sub_task
-- before exhausting retries.

rule ChildSubtreeCancelledOnRestartExhausted {
    when: task: SpecialistTask.status transitions_to failed
    requires: task.failure.kind = host_restart
    requires: task.pending_sub_task != null
    ensures:
        SubtreeCancelled(task: task.pending_sub_task)
}

-- Sub-task await timeout (retries remain). When a parent task has been in
-- awaiting_sub_task longer than max_sub_task_await without the child reaching
-- a terminal state, the parent is restarted. This handles the case where a
-- crash on the child path produced no observable signal on the parent's
-- session (the parent's container is already idle while it waits), so neither
-- SpecialistContainerCrashed nor SpecialistRestartExhausted can fire for the
-- parent on a stuck transition.
--
-- ChildSubtreeCancelledOnParentCrash already cancels the pending sub-task
-- subtree on transitions into awaiting_restart, so no explicit cancellation
-- is needed here: the awaiting_restart transition itself drives subtree
-- cleanup via that rule.

rule SubTaskAwaitTimedOut {
    when: task: SpecialistTask.sub_task_await_overdue
    requires: task.restart_attempt_count < config.max_restart_retries
    ensures:
        task.status = awaiting_restart
        task.restart_attempt_count = task.restart_attempt_count + 1
}

-- Sub-task await timeout (retries exhausted). The parent has already used its
-- restart budget; a further await timeout fails the task with kind = timeout.
-- Companion rule ChildSubtreeCancelledOnSubTaskAwaitExhausted cancels the
-- pending sub-task subtree on the failed transition.

rule SubTaskAwaitExhausted {
    when: task: SpecialistTask.sub_task_await_overdue
    requires: task.restart_attempt_count >= config.max_restart_retries
    ensures:
        task.status = failed
        task.failure = TaskFailure{
            kind: timeout,
            detail: "sub-task did not complete within the await window after exhausting restart retries"
        }
        task.closed_at = now
}

-- Companion to ChildSubtreeCancelledOnRestartExhausted for timeout failures.
-- This rule fires whenever a task transitions to failed with kind = timeout
-- while still holding a pending sub-task. Two paths produce this state:
--   - SubTaskAwaitExhausted: the parent's await window expired and restart
--     retries were exhausted.
--   - SpecialistTaskTimedOut: the overall task duration was exceeded while
--     the parent was in awaiting_sub_task.
-- Both leave a child task running with no parent able to consume its result;
-- this rule cancels the pending sub-task subtree on the failed transition.

rule ChildSubtreeCancelledOnSubTaskAwaitExhausted {
    when: task: SpecialistTask.status transitions_to failed
    requires: task.failure.kind = timeout
    requires: task.pending_sub_task != null
    ensures:
        SubtreeCancelled(task: task.pending_sub_task)
}

------------------------------------------------------------
-- Group deletion
------------------------------------------------------------

-- Deleting an agent group ends the specialist work that depends on it.
-- AgentGroupDeletionRequested(group) is emitted by the host before it
-- removes the group (ncl groups delete). Every live task whose specialist
-- group is the deleted group, or (for root tasks) whose requester_group is,
-- fails at once with kind = group_deleted. SpecialistFailureRoutedToRequester then
-- tells each surviving requester straight away (a parent awaiting the task
-- resumes with the failure instead of waiting out its sub-task await or
-- the overall timeout), and the deleted task's own pending sub-task, if
-- any, is cancelled down the chain. Requester links are never cleared, so
-- ExactlyOneRequester keeps holding for the failed tasks.

rule SpecialistTasksFailedOnGroupDeleted {
    when: AgentGroupDeletionRequested(group)
    for t in SpecialistTasks where status in {queued, running, awaiting_sub_task, awaiting_restart}
            and (specialist_group = group or requester_group = group):
        ensures:
            t.status = failed
            t.failure = TaskFailure{
                kind: group_deleted,
                detail: "specialist task ended: its agent group was deleted"
            }
            t.closed_at = now
            if t.pending_sub_task != null:
                SubtreeCancelled(task: t.pending_sub_task)

    @guidance
        -- A root task whose requesting (main) group is deleted has no one
        -- left to route its result to; failing it still closes its session
        -- and settles its transfers through the terminal-transition rules:
        -- files it was handed go back towards its requester, and whatever
        -- can no longer reach anyone is parked with the root requester -
        -- unless that group is the one deleted, when they go with it.
        -- Sub-tasks of a deleted parent group are reached through the
        -- parent's pending_sub_task, the same chain walk the crash and
        -- timeout paths use.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Root specialist tasks may only be dispatched by the main group. Sub-tasks
-- (requester_task != null) carry no constraint on requester_group because
-- it is null for them.

invariant SpecialistDispatchMainGroupOnly {
    for t in SpecialistTasks:
        t.requester_task = null implies (
            t.requester_group != null
            and t.requester_group.is_main = true
        )
}

-- A memory provider is a leaf: it is read-only and cannot itself delegate.
-- This invariant catches any path where a memory provider would appear as
-- the immediate parent of a sub-task.

invariant MemoryProviderDoesNotDelegate {
    for t in SpecialistTasks:
        t.requester_task != null implies (
            t.requester_task.specialist_group.specialist?.is_memory_provider != true
        )
}

-- Depth is bounded by config; the dispatch rules enforce this and the
-- invariant captures the resulting structural property.

invariant TaskDepthBounded {
    for t in SpecialistTasks:
        t.status in {queued, running, awaiting_sub_task, awaiting_restart}
            implies t.depth < config.max_specialist_depth
}

-- closed_at is present iff the task is in a terminal state. Live tasks
-- (queued, running, awaiting_sub_task) have closed_at = null.

invariant ClosedAtPresentWhenTerminal {
    for t in SpecialistTasks:
        (t.status in {completed, failed}) = (t.closed_at != null)
}

-- A running task is a leaf: it has no child task that is itself running.
-- While a child is running, the parent should be in awaiting_sub_task.

invariant RunningTaskIsLeaf {
    for parent in SpecialistTasks:
        for child in SpecialistTasks:
            (parent.status = running and child.requester_task = parent)
                implies child.status != running
}

-- Per-task session isolation: each specialist task's Session has
-- messaging_group = the null-channel singleton MessagingGroup and
-- thread_id = task.id, making it unique to that task. (See null-channel.allium
-- for the singleton's role.) The specialist's AgentGroup folder (CLAUDE.md,
-- skills) is mounted read-only and shared across all tasks of the same type.
-- Everything writable the container sees is the task's own: its per-task
-- session (inbound.db, outbound.db and session folder), the provider's state
-- (for Claude, its home .claude directory, kept per task rather than per
-- group), and its invocation's ipc-out. Nothing writable is shared with
-- another task. A running task therefore cannot alter the type template or
-- another task's state.

-- File handover invariants
--
-- Each transfer commits at most one of the two delivery paths: it either
-- ends up committed to memory (status = committed, eventually expired) or
-- it ends up placed in the requester's ipc-in (status = in_transit,
-- eventually expired). A transfer that committed to memory has no files
-- in status = placed; a transfer that did not has no files with a
-- memory_path. This prevents the spec from describing a transfer that
-- both wrote to memory and was placed into ipc-in.

invariant CommitAndPlaceMutuallyExclusive {
    for t in ContainerTransfers:
        for f in t.files:
            (f.memory_path != null) implies t.commit_to_memory = true
}

-- Files handed over with a dispatch only ever reach the dispatched task's
-- ipc-in; the requester's memory area is written by result transfers alone.

invariant DispatchTransferNeverCommits {
    for t in ContainerTransfers:
        t.kind = dispatch implies (
            t.commit_to_memory = false
            and t.routed_message = null
        )
}

-- Files given back are placed in ipc-in only, like a dispatch's.

invariant ReturnedTransferNeverCommits {
    for t in ContainerTransfers:
        t.kind = returned implies t.commit_to_memory = false
}

-- The host's guarantee for named files: once owned, a file is never
-- discarded unseen. It is retired only after it reached a recipient's
-- ipc-in, was committed to memory, was parked, or was handed on in a
-- returned transfer. The one exception is a file whose root requester
-- group was deleted: it goes with that group.

invariant NamedFilesNeverLost {
    for f in TransferFiles:
        f.status = expired implies (
            f.reached_recipient
            or f.memory_path != null
            or f.parked_path != null
            or f.transfer.returned_as != null
            or root_requester_group(f.transfer) = null
        )
}

-- Each TransferFile that lives in a recipient's ipc-in resolves to a
-- distinct in-container path. Path construction uses the transfer id as a
-- per-transfer subdirectory, so distinct transfers placing files for the
-- same invocation cannot collide; within a transfer, original_name must
-- be unique.

invariant IpcInPathsUniquePerTransfer {
    for t in ContainerTransfers:
        for a in t.files:
            for b in t.files:
                a != b implies a.original_name != b.original_name
}

-- A transfer's files share its delivery state: a transfer in committed
-- status has no files in placed status; a transfer in expired status has
-- no files in any non-expired status. This is the cross-entity coherence
-- guarantee that lets observability code report transfer state without
-- inspecting each file.

invariant TransferAndFilesInSync {
    for t in ContainerTransfers:
        for f in t.files:
            (t.status = expired) implies (f.status = expired)
}

-- At most one invocation per session is active at any moment. The host
-- enforces this by ending any orphan invocation synchronously at
-- ContainerInvocationStarted (OrphanInvocationEnded) and by ending the
-- active invocation synchronously when the specialist task reaches a
-- terminal state (InvocationEndedOnTaskTerminal). The IpcOutMount status
-- is the canonical witness of an invocation's liveness: an invocation is
-- "active" iff its IpcOutMount is in status = active.

invariant AtMostOneActiveInvocationPerSession {
    for a in IpcOutMounts:
        for b in IpcOutMounts:
            (a != b
             and a.status = active
             and b.status = active)
                implies a.invocation.session != b.invocation.session
}

-- Restart attempts are only consumed by a crash observed against a running
-- task. A task that has never reached running must therefore have
-- restart_attempt_count = 0. This protects queued tasks from having their
-- restart budget burned through by repeated sweep ticks that mistake
-- "waiting for a concurrency slot" or "container not yet started" for
-- a crash.

invariant QueuedTaskHasNoRestartAttempts {
    for t in SpecialistTasks:
        t.status = queued implies t.restart_attempt_count = 0
}

-- A task's per-task Session is closed once the task itself is terminal.
-- This is the structural counterpart to SpecialistTaskSessionClosed: it
-- asserts the resulting state at any single point in time after the
-- terminal transition has been processed, independent of the route by
-- which the task reached terminal (delivery, timeout, restart exhausted,
-- subtree cancellation, sub-task await exhaustion).
--
-- The condition is bounded to tasks for which a per-task session exists.
-- Tasks created directly in status = failed by the sub-task rejection
-- rules (SubTaskRejectedDepth/Count/SameTypeLimit) never had a
-- session provisioned and are excluded by the exists clause.

invariant TerminalTaskHasClosedSession {
    for t in SpecialistTasks:
        let session = specialist_task_session(t)
        (t.status in {completed, failed} and exists session)
            implies session.status = closed
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "InboundMessage pending -> failed edge for session closure: the host marks any still-pending messages_in rows as failed when a specialist task's session is closed at terminal transition (see SpecialistTaskSessionClosed). The sessions.allium InboundMessage transition graph does not currently include a pending -> failed edge, so this fail-pending action cannot be expressed as a rule-level ensures here. Should sessions.allium add the pending -> failed edge so the cleanup can be witnessed by a rule, or should the closure rely solely on session.status = closed gating downstream wake rules to keep pending messages dormant?"

