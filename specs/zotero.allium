-- allium: 3
-- zotero.allium
--
-- Zotero library synchronisation for a configured group.
-- Periodically mirrors the user's Zotero library as markdown files in the group workspace,
-- notifies the chat when items are added or removed, and supports abstract enrichment
-- from external bibliographic sources or attached PDFs.
--
-- Scope: Zotero library sync, item file management, abstract enrichment, PDF extraction
-- Includes: SyncState, ItemFile, DigestEntry, abstract enrichment, PDF abstract extraction
-- Excludes:
--   - Embedding and memory indexing of item files (see memory.allium)
--   - Message delivery mechanics and channel routing (see routing.allium, sessions.allium)
--   - Container execution details (container-level concern)
--   - Zotero API wire format, HTTP pagination, authentication headers (implementation)
--   - Per-request rate limiting and backoff during abstract lookups (implementation)

use "./identity.allium" as identity
use "./scheduling.allium" as scheduling

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The source from which an abstract was obtained during enrichment or extraction.
enum AbstractSource {
    s2_doi | s2_arxiv | s2_url_doi | s2_title |
    cr_doi | cr_url_doi | cr_title |
    pdf_extraction
}

-- The outcome of an abstract lookup that did not produce an abstract.
--   not_found    -- every applicable source answered and none had a usable abstract
--   inconclusive -- at least one source could not be asked (network error, rate
--                   limit retries exhausted, run budget reached mid-item)
enum AbstractLookupResult {
    not_found | inconclusive
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The user's Zotero library hosted at api.zotero.org.
-- A monotonically increasing version number increments on any change to the library.
-- allium-ignore allium.externalEntity.missingSourceHint
-- allium-ignore allium.entity.unused
external entity ZoteroLibrary {
    -- allium-ignore allium.field.unused
    version: Integer
}

-- A single reference item in the Zotero library.
-- allium-ignore allium.externalEntity.missingSourceHint
external entity ZoteroItem {
    key: String                         -- 8-character opaque identifier, e.g. "224KRICZ"
    title: String
    -- allium-ignore allium.field.unused
    authors: List<String>
    -- allium-ignore allium.field.unused
    year: Integer?
    -- allium-ignore allium.field.unused
    doi: String?
    -- allium-ignore allium.field.unused
    url: String?
    -- allium-ignore allium.field.unused
    item_type: String                   -- "journalArticle", "conferencePaper", "book", etc.
    -- allium-ignore allium.field.unused
    tags: Set<String>
    abstract: String?
    pdf_attachment: PdfAttachment?
}

-- A PDF file attached to a Zotero item and stored in the Zotero file server.
-- allium-ignore allium.externalEntity.missingSourceHint
external entity PdfAttachment {
    -- allium-ignore allium.field.unused
    item: ZoteroItem
    size: Integer                       -- bytes
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- Persistent sync state for a group's Zotero integration.
-- Tracks library version, item count, schedule, and when the next sync check is due.
entity SyncState {
    group: identity/AgentGroup
    last_version: Integer               -- library version at the time of the last successful sync
    total_items: Integer
    last_sync: Timestamp?
    next_check: Timestamp?              -- null only before the very first check is scheduled
    schedule: scheduling/Schedule       -- schedule.type must be cron or interval; once is not valid

    -- Derived
    is_due: next_check != null and next_check <= now
}

-- A markdown file in the group workspace representing a Zotero library item.
-- Created or updated on sync; deleted when the item is removed from the library.
-- Keyed by the item's Zotero key, which is unique within a library.
entity ItemFile {
    group: identity/AgentGroup
    item_key: String                    -- Zotero item key; unique per group
    title: String
    abstract: String?
    abstract_source: AbstractSource?    -- set when abstract was obtained via enrichment or extraction
    abstract_lookup_at: Timestamp?      -- last lookup that ended without an abstract
    abstract_lookup_result: AbstractLookupResult?
    -- allium-ignore allium.field.unused
    last_synced_at: Timestamp

    @guidance
        -- Storage: each ItemFile instance is a markdown file at
        -- groups/<folder>/zotero-md/<item_key>.md in the host filesystem.
        -- The folder belongs to this module's host processes (sync and
        -- enrichment), which are its only writers. Agents only read it: it is
        -- mounted read-only into every container that is given it - the
        -- group's own at /workspace/agent/zotero-md, the researcher's under
        -- /workspace/extra (memory-graph.allium).
        -- There is no DB row for an ItemFile; the file IS the entity.
        --
        -- Field mapping (see container/tools/zotero-sync.mjs buildMarkdown):
        --   - item_key       -> filename stem AND zoteroKey: in YAML frontmatter
        --   - title          -> title: in YAML frontmatter AND H1 heading in body
        --   - abstract       -> body text after the heading and author/year line
        --                       (added/updated in place by zotero-enrich.mjs and
        --                        zotero-extract-abstracts.mjs as a body section)
        --   - abstract_source -> abstract_source: in YAML frontmatter, written
        --                       with the abstract
        --   - abstract_lookup_at, abstract_lookup_result
        --                     -> one frontmatter line,
        --                       abstract_lookup: <ISO timestamp> <result>,
        --                       written by the lookup run; removed when an
        --                       abstract is inserted
        --   - last_synced_at -> not persisted in the file; host-derived from
        --                       sync events
        --
        -- Uniqueness: the UniqueItemFilesPerGroup invariant is enforced by the
        -- filesystem itself — one file per item_key per group directory, by
        -- filename collision. No DB UNIQUE constraint exists. Equally, there is
        -- no ItemFiles table to query: enumeration requires reading the
        -- zotero-md directory; lookup by item_key is a path stat.
}

-- A timestamped entry appended to the group's zotero-digest.md activity log.
entity DigestEntry {
    group: identity/AgentGroup
    -- allium-ignore allium.field.unused
    recorded_at: Timestamp
    -- allium-ignore allium.field.unused
    summary: String

    @guidance
        -- Storage: each DigestEntry instance is an appended text block in a
        -- single shared file at groups/<folder>/zotero-digest.md. The file is
        -- write-once-per-event and append-only (see notifySyncChanges in
        -- src/modules/zotero/notify.ts), with each entry written as:
        --
        --     \n\n## <ISO timestamp>\n\n<summary>
        --
        -- Field mapping:
        --   - recorded_at -> the "## <ISO timestamp>" heading line
        --   - summary     -> the prose paragraph(s) following that heading
        --
        -- Implications vs a DB-backed entity:
        --   - DigestEntry instances are NOT individually addressable. There is
        --     no key, no row id, and no path that resolves to a single entry.
        --   - DigestEntry instances cannot be deleted, updated or queried
        --     individually; the only mutation is "append a new entry".
        --   - There is no DigestEntries collection to iterate. Reading the
        --     history requires opening the flat file and parsing the headings.
        --   - Rules and invariants therefore should not assume per-entry
        --     lookup, deletion, or status; the entity exists to record
        --     observable activity, not to be navigated.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    default_sync_interval: Duration = 1.hour
    pre_check_timeout: Duration = 10.seconds
    sync_request_timeout: Duration = 30.seconds  -- per-request timeout for full sync API calls
    max_pdf_size: Integer = 15_000_000       -- bytes; PDFs larger than this are skipped
    min_abstract_length: Integer = 80        -- chars; shorter extracted text is rejected
    max_abstract_length: Integer = 3000      -- chars; longer extracted text is rejected
    abstract_retry_interval: Duration = 180.days  -- a not_found item is not looked up again sooner
    enrichment_run_budget: Duration = 25.seconds  -- wall-clock per lookup run
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Sync Scheduling ----

-- On first run (no next_check yet), schedule the first check immediately.
rule SyncStateInitialised {
    when: state: SyncState.next_check = null

    ensures: state.next_check = now

    @guidance
        -- SyncState row creation is a host bootstrap concern: on first monitor start,
        -- the host inserts the singleton row with next_check = now and all other fields
        -- at their defaults. That insert sets next_check immediately, so this rule fires
        -- only in the edge case where a row already exists with next_check = null
        -- (e.g. after a manual reset or a migration that left it unset).
}

-- When a sync check falls due, attempt a lightweight version pre-check by querying
-- the Zotero API before committing to a full sync.
rule SyncCheckDue {
    when: state: SyncState.is_due

    ensures: ZoteroPreCheckRequested(state: state)
}

-- ---- Pre-Check ----

-- If the pre-check API call fails (network error, bad credentials, timeout),
-- skip this sync cycle and advance the schedule without running the sync.
-- There is no point running a full sync if the API is unreachable.
rule PreCheckFailed {
    when: ZoteroPreCheckRequested(state)

    let server_version = fetch_library_version(state.group, since: state.last_version)

    requires: server_version = null              -- API unreachable or credentials missing

    ensures: state.next_check = compute_next_check(state.schedule, state.next_check)
}

-- If the pre-check confirms the library version is unchanged, skip the full sync
-- and advance the next check time without running the sync.
rule LibraryUnchanged {
    when: ZoteroPreCheckRequested(state)

    let server_version = fetch_library_version(state.group, since: state.last_version)

    requires: server_version <= state.last_version

    ensures: state.next_check = compute_next_check(state.schedule, state.next_check)
}

-- If the pre-check detects a newer library version, proceed to full sync.
-- next_check is advanced immediately (before the sync completes) so that a host
-- restart between queuing and completion does not cause a duplicate sync task to
-- be queued. LibrarySynced will advance next_check a second time from that
-- already-advanced value, giving an effective spacing of two intervals between
-- library-changed detection and the following check.
rule LibraryChanged {
    when: ZoteroPreCheckRequested(state)

    let server_version = fetch_library_version(state.group, since: state.last_version)

    requires: server_version > state.last_version

    ensures: state.next_check = compute_next_check(state.schedule, state.next_check)
    ensures: ZoteroSyncRequested(state: state)
}

-- ---- Full Sync ----

-- Fetch all new and modified items since last_version, upsert their item files, remove
-- files for deleted items, update sync state, and emit a completion event.
-- The sync runs as a host process, which holds the Zotero API credentials; no
-- agent, container or model turn is involved.
rule LibrarySynced {
    when: ZoteroSyncRequested(state)

    let new_items    = fetch_new_items(state.group, since: state.last_version)
    let deleted_keys = fetch_deleted_keys(state.group, since: state.last_version)
    let new_version  = fetch_library_version(state.group)
    let total        = fetch_total_item_count(state.group)

    -- Create or update a markdown file for each new/modified item.
    -- In practice this is an upsert keyed on (group, item_key).
    ensures:
        for item in new_items:
            ItemFile.created(
                group: state.group,
                item_key: item.key,
                title: item.title,
                abstract: item.abstract,
                abstract_source: null,
                abstract_lookup_at: null,
                abstract_lookup_result: null,
                last_synced_at: now
            )

    -- Remove files for items that were deleted in the Zotero library.
    ensures:
        for key in deleted_keys:
            not exists ItemFile{ group: state.group, item_key: key }

    ensures: state.last_version = new_version
    ensures: state.total_items = total
    ensures: state.last_sync = now
    ensures: state.next_check = compute_next_check(state.schedule, state.next_check)

    ensures: LibrarySyncCompleted(
        state: state,
        added: new_items,
        deleted_keys: deleted_keys
    )

    @guidance
        -- compute_next_check advances from the current state.next_check (not from now),
        -- so the schedule stays regular even when sync is delayed. Missed intervals are
        -- skipped forward until the next future slot. Cron mode finds the next cron tick
        -- after now, respecting the configured timezone.
        -- The host runs zotero-sync.mjs as a child process with the credentials in its
        -- environment and a time limit; it writes the item files, a JSON summary and
        -- zotero-state.json, which the host merges back into SyncState. A run that
        -- fails or times out changes no SyncState, so the next due check tries again
        -- (next_check was already advanced when the sync was started).
}

-- ---- Notification ----

-- When a sync produces any changes, notify the group's chat with a summary
-- and append a timestamped entry to the group's digest log.
rule ChangesNotified {
    when: LibrarySyncCompleted(state, added, deleted_keys)

    requires: added.count > 0 or deleted_keys.count > 0

    ensures: SyncNotificationSent(
        group: state.group,
        content: sync_summary(added, deleted_keys, state.total_items)
    )
    ensures: DigestEntry.created(
        group: state.group,
        recorded_at: now,
        summary: sync_summary(added, deleted_keys, state.total_items)
    )

    @guidance
        -- In v2 there is no Message entity on AgentGroup directly. AgentGroup has
        -- no .chat field; the chat relationship runs through MessagingGroup → Wiring
        -- (routing.allium). Host-side background notifications like this one are
        -- delivered via a direct channel adapter call, bypassing the session DB path
        -- (inbound.db / outbound.db) entirely. SyncNotificationSent abstracts the
        -- delivery act: the implementation resolves the messaging group(s) wired to
        -- state.group via routing.allium Wiring rows and posts through their channel
        -- adapters directly. The v1 nanoclaw.Message.created() call has no allium
        -- entity equivalent in v2; the observable effect is the same (a message
        -- appears in the chat), but the mechanism is host-direct rather than
        -- session-mediated.
}

-- ---- Enrichment Triggers ----

-- An item file is in the enrichment backlog while it has no abstract, unless its
-- last lookup found nothing within abstract_retry_interval. Inconclusive lookups
-- stay in the backlog.

-- On every due sync check, whatever the pre-check finds, run one bounded lookup
-- pass over the backlog. This drains a large backlog slowly in the background.
rule EnrichmentBacklogScheduled {
    when: state: SyncState.is_due

    let backlog = ItemFiles where group = state.group and abstract = null
        and not (abstract_lookup_result = not_found
                 and abstract_lookup_at + config.abstract_retry_interval > now)

    requires: backlog.count > 0

    ensures: EnrichmentRunRequested(group: state.group)

    @guidance
        -- Not stacked: while a sync or lookup pass is still running or queued, the
        -- check requests none; the next due check tries again.
}

-- After a sync that added new items, run a lookup pass straight away rather than
-- waiting for the next check. New items have no lookup record, so they come first.
rule EnrichmentTriggeredAfterSync {
    when: LibrarySyncCompleted(state, added, deleted_keys)

    requires: added.count > 0
    requires: exists f in ItemFiles where item_key in added.keys and abstract = null

    ensures: EnrichmentRunRequested(group: state.group)
}

-- The user can also ask for enrichment at any time. This forgets earlier
-- not_found results, so every item without an abstract is looked up again,
-- in bounded runs as usual. The request reaches the host as an admin command
-- (ncl zotero retry-abstracts), which the main agent may issue on the user's
-- behalf; agents cannot write the item files themselves.
-- allium-ignore allium.rule.unreachableTrigger
rule EnrichmentTriggeredOnRequest {
    when: UserRequestedEnrichment(group)

    -- Only not_found records hold an item back (EnrichmentRun); an inconclusive
    -- item is in the backlog already, so its record is kept for prioritisation.
    let forgotten = ItemFiles where group = group and abstract = null
        and abstract_lookup_result = not_found

    ensures:
        for item_file in forgotten:
            item_file.abstract_lookup_at = null
    ensures:
        for item_file in forgotten:
            item_file.abstract_lookup_result = null
    ensures: EnrichmentRunRequested(group: group)
}

-- One lookup run: take backlog items in priority order and, for each, try the
-- external sources, then the attached PDF, then record the outcome if neither
-- produced an abstract. The run stops at enrichment_run_budget.
rule EnrichmentRun {
    when: EnrichmentRunRequested(group)

    let backlog = ItemFiles where group = group and abstract = null
        and not (abstract_lookup_result = not_found
                 and abstract_lookup_at + config.abstract_retry_interval > now)
    let batch = take_within_budget(prioritise_backlog(backlog), config.enrichment_run_budget)

    ensures:
        for item_file in batch:
            EnrichAbstractRequested(item_file: item_file)
    ensures:
        for item_file in batch:
            ExtractPdfAbstractRequested(item_file: item_file)
    ensures:
        for item_file in batch:
            AbstractLookupFinished(item_file: item_file)

    @guidance
        -- prioritise_backlog orders by: never looked up first, then inconclusive,
        -- then expired not_found, each by oldest abstract_lookup_at. Ties (all
        -- never-looked-up items) put items with a DOI, an arXiv ID or a DOI in the
        -- URL before title-only items, since identifier lookups are cheap and
        -- usually succeed.
        -- The run is a host process (no agent, no model turn), so it costs no model
        -- tokens; the budget keeps it inside its time limit. The PDF step needs
        -- pdftotext on the host. Each item's outcome is
        -- written to its file as soon as the item is done, so a run that is cut
        -- short keeps the work already finished. An item interrupted mid-lookup is
        -- left unmarked and comes round again.
        -- A backoff that would overrun the budget ends the item as inconclusive
        -- rather than waiting.
}

-- When a lookup ends without an abstract, record when and why, so the backlog
-- moves on instead of retrying the same items on every run.
rule AbstractLookupRecorded {
    when: AbstractLookupFinished(item_file)

    requires: item_file.abstract = null

    let result = lookup_outcome(item_file)

    ensures: item_file.abstract_lookup_at = now
    ensures: item_file.abstract_lookup_result = result

    @guidance
        -- lookup_outcome is not_found only when every applicable external source
        -- answered (found nothing, or text outside the length bounds) and PDF
        -- extraction found nothing or did not apply (no PDF, PDF too large).
        -- Anything that leaves a source unasked makes it inconclusive.
}

-- ---- Abstract Enrichment ----

-- Enrich an item file that has no abstract by querying external bibliographic sources.
-- Sources are tried in priority order until one yields an abstract within the
-- configured length bounds, or all sources are exhausted.
rule AbstractEnriched {
    when: EnrichAbstractRequested(item_file)

    requires: item_file.abstract = null

    let found = find_abstract_from_external_sources(item_file)

    requires: found != null
    requires: found.text.length >= config.min_abstract_length
    requires: found.text.length <= config.max_abstract_length

    ensures: item_file.abstract = found.text
    ensures: item_file.abstract_source = found.source

    @guidance
        -- Lookup order (7 sequential attempts, interleaved by identifier strength):
        --   1. DOI             → Semantic Scholar
        --   2. DOI             → CrossRef
        --   3. arXiv ID        → Semantic Scholar  (arXiv ID extracted from item URL)
        --   4. URL-embedded DOI → Semantic Scholar
        --   5. URL-embedded DOI → CrossRef
        --   6. Title           → Semantic Scholar  (>= 80% word-overlap similarity)
        --   7. Title           → CrossRef          (>= 80% word-overlap similarity)
        -- Interleaving by identifier rather than by provider means a strong identifier
        -- (DOI) is fully exhausted across both sources before falling back to weaker
        -- identifiers (arXiv, url-DOI, title). This avoids burning fuzzy S2 title
        -- searches before trying a precise CrossRef DOI lookup.
        -- If no source yields a usable abstract, the abstract is left unset; the
        -- outcome is recorded by AbstractLookupRecorded.
        -- Per-request rate limiting and backoff are implementation details of
        -- zotero-enrich.mjs.
}

-- ---- PDF Abstract Extraction ----

-- Extract an abstract from an item's attached PDF when no abstract is available
-- and the PDF is within the configured size limit.
rule PdfAbstractExtracted {
    when: ExtractPdfAbstractRequested(item_file)

    let item = find_zotero_item(item_file.item_key)

    requires: item_file.abstract = null
    requires: item.pdf_attachment != null
    requires: item.pdf_attachment.size <= config.max_pdf_size

    let extracted = extract_abstract_from_pdf(item.pdf_attachment)

    requires: extracted != null
    requires: extracted.length >= config.min_abstract_length
    requires: extracted.length <= config.max_abstract_length

    ensures: item_file.abstract = extracted
    ensures: item_file.abstract_source = pdf_extraction

    @guidance
        -- The PDF is downloaded from the Zotero file server via the items/{key}/children
        -- endpoint. Only attachments Zotero stores (linkMode imported_file or
        -- imported_url) whose contentType names PDF have a downloadable file; a linked
        -- file or linked URL does not. A PDF whose size the API does not report is
        -- downloaded anyway; the download's time limit bounds it.
        -- Extraction uses pdftotext on the first 4 pages. The abstract starts at an
        -- "Abstract" or "ABSTRACT" heading opening a line (not the word in running
        -- text) and ends at the next section heading opening a line, capitalised as
        -- headings are ("Introduction", "1. INTRODUCTION", "Keywords"). With no end
        -- heading, the whole remainder is the candidate, so over-long text is
        -- rejected rather than cut to a prefix.
        -- Dehyphenation joins line-broken words before length validation.
        -- If extraction yields nothing, the abstract is left unset; the outcome is
        -- recorded by AbstractLookupRecorded. A PDF that could not be fetched, or that
        -- pdftotext could not read, left the source unasked: inconclusive.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- There is at most one SyncState in the system. Zotero sync targets a single configured group.
invariant SyncStateIsSingleton {
    SyncStates.count <= 1
}

-- Item file keys are unique within a group (one file per Zotero item per group).
invariant UniqueItemFilesPerGroup {
    for a in ItemFiles:
        for b in ItemFiles:
            (a != b and a.group = b.group) implies a.item_key != b.item_key
}

-- An item file that carries an abstract_source always has a non-null abstract.
invariant AbstractSourceImpliesAbstract {
    for f in ItemFiles:
        f.abstract_source != null implies f.abstract != null
}

-- A lookup record is all or nothing.
invariant AbstractLookupRecordComplete {
    for f in ItemFiles:
        (f.abstract_lookup_at = null) = (f.abstract_lookup_result = null)
}

-- An active SyncState always has a next_check scheduled.
-- (next_check = null is transient and immediately resolved by SyncStateInitialised.)
invariant ActiveSyncStateHasNextCheck {
    for s in SyncStates:
        s.last_sync != null implies s.next_check != null
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- resolved: one Zotero group only; SyncState is a singleton (see SyncStateIsSingleton invariant)
-- resolved: enrichment runs automatically after sync for new items without abstracts (EnrichmentTriggeredAfterSync),
--           and can also be requested ad hoc by the user (EnrichmentTriggeredOnRequest)
-- resolved (2026-10-11): unbounded enrichment runs died with their container and, recording nothing,
--           restarted on the same items; runs are now budgeted, drain the backlog on every sync check
--           (EnrichmentBacklogScheduled), and record not_found / inconclusive per item (AbstractLookupRecorded)
-- resolved (2026-10-28): sync and enrichment run as host processes; zotero-md is read-only to agents.
--           The sync used to be an agent prompt that only ran zotero-sync.mjs (one tool call, ~50k
--           tokens of context, and it failed twice on a lost conversation); it also wrote from
--           whichever session of the group had no messaging group.
-- resolved: pre-check failure skips the sync and advances the schedule (fail-closed, no sync run);
--           current code (hasNewZoteroItems) diverges — it is fail-open and should be fixed
-- resolved: deleted item files are removed permanently; recovery via Borg backups if needed
